@page "/institutions"
@attribute [Authorize]
@inject IInstitutionsApiClient InstitutionsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Institutions</PageTitle>

<div class="crud-page">
    <header class="page-hero">
        <div>
            <h1>Institutions</h1>
            <p>Manage the banks and brokerages connected to your accounts.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadListAsync" disabled="@isLoading">Refresh</button>
            <button class="btn btn-primary" type="button" @onclick="StartCreate">New Institution</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (showEditor)
    {
        <section class="panel">
            <div class="section-header">
                <h2>@(editModel is null ? "Add Institution" : "Edit Institution")</h2>
                <p>@(editModel is null ? "Create a source location for current and future accounts." : $"Updating institution #{editModel.Id}.")</p>
            </div>

            @if (editModel is null)
            {
                <EditForm Model="createModel" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="institutionName">Institution Name</label>
                            <InputText id="institutionName" class="form-control" @bind-Value="createModel.InstitutionName" />
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Institution</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditor">Close</button>
                        </div>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="editModel" OnValidSubmit="UpdateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="editInstitutionName">Institution Name</label>
                            <InputText id="editInstitutionName" class="form-control" @bind-Value="editModel.InstitutionName" />
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </div>
                </EditForm>
            }
        </section>
    }

    <section class="panel">
        <div class="section-header">
            <h2>Institution List</h2>
            <p>Review all institutions and how many accounts each currently owns.</p>
        </div>

        <LoadingState IsVisible="@isLoading" />
        <EmptyState IsVisible="@(!isLoading && institutions.Count == 0)" Message="No institutions yet." />

        @if (institutions.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Name</th>
                            <th>Accounts</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in institutions)
                        {
                            <tr>
                                <td>@item.DisplayOrder</td>
                                <td>@item.Name</td>
                                <td>@item.Accounts.Count</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(item.Id)">Open</button>
                                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (selectedInstitution is not null)
    {
        <section class="panel detail-panel">
            <div class="section-header">
                <h2>Institution Details</h2>
                <p>@selectedInstitution.Name</p>
            </div>

            <h3>Linked Accounts</h3>
            <EmptyState IsVisible="@(selectedInstitution.Accounts.Count == 0)" Message="No linked accounts yet." />
            @if (selectedInstitution.Accounts.Count > 0)
            {
                <ul>
                    @foreach (var account in selectedInstitution.Accounts)
                    {
                        <li>#@account.DisplayOrder @account.Name (@account.Type.Name)</li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    private readonly CreateModel createModel = new();
    private readonly List<InstitutionResponse> institutions = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private InstitutionResponse? selectedInstitution;
    private EditModel? editModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showEditor;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync() => await LoadListAsync();

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            institutions.Clear();
            institutions.AddRange(await InstitutionsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedInstitution = await InstitutionsApiClient.GetByIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await InstitutionsApiClient.CreateAsync(createModel.InstitutionName);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.InstitutionName = string.Empty;
        showEditor = false;
        successMessage = "Institution saved.";
        await LoadListAsync();
    }

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editModel = null;
    }

    private void StartEdit(InstitutionResponse institution)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = new EditModel
        {
            Id = institution.Id,
            InstitutionName = institution.Name
        };
        showEditor = true;
    }

    private void CancelEdit() => CloseEditor();

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await InstitutionsApiClient.UpdateAsync(editModel.Id, editModel.InstitutionName);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editModel = null;
        showEditor = false;
        successMessage = "Institution updated.";
        await LoadListAsync();
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete this institution? (ID {id})");
        if (!confirmed)
            return;

        var result = await InstitutionsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedInstitution?.Id == id)
            selectedInstitution = null;

        if (editModel?.Id == id)
            editModel = null;

        successMessage = "Institution deleted.";

        await LoadListAsync();
    }

    private sealed class CreateModel
    {
        public string InstitutionName { get; set; } = string.Empty;
    }

    private sealed class EditModel
    {
        public int Id { get; set; }
        public string InstitutionName { get; set; } = string.Empty;
    }
}
