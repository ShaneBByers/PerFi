@page "/config"
@attribute [Authorize]
@inject IAccountsApiClient AccountsApiClient
@inject IInstitutionsApiClient InstitutionsApiClient
@inject IAccountTypesApiClient AccountTypesApiClient
@inject IAccountTypeGroupsApiClient AccountTypeGroupsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Config</PageTitle>

<div class="crud-page config-page">
    <header class="page-hero">
        <div>
            <h1>Config</h1>
            <p>Use one workspace to shape the structure behind net worth entries.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadAllAsync" disabled="@isLoading">Refresh</button>
            <a class="btn btn-primary" href="/snapshots">Go to Net Worth</a>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="summary-grid" aria-label="Configuration summary">
        <article class="summary-card">
            <span class="summary-label">Institutions</span>
            <strong>@institutions.Count</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Accounts</span>
            <strong>@accounts.Count</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Account Types</span>
            <strong>@accountTypes.Count</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Type Groups</span>
            <strong>@accountTypeGroups.Count</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Relationships</span>
            <strong>Institution &rarr; Account &rarr; Type &rarr; Group</strong>
        </article>
    </section>

    <section class="panel config-intro-panel">
        <div class="section-header">
            <h2>Relationship Map</h2>
            <p>Use this page to keep the hierarchy obvious: institutions contain accounts, and accounts choose an account type.</p>
        </div>
    </section>

    <section class="panel">
        <div class="tab-strip" role="tablist" aria-label="Config sections">
            <button class="tab-button @(activeTab == "relationships" ? "active" : null)" type="button" @onclick='() => SetTab("relationships")'>Relationships</button>
            <button class="tab-button @(activeTab == "institutions" ? "active" : null)" type="button" @onclick='() => SetTab("institutions")'>Institutions</button>
            <button class="tab-button @(activeTab == "accounts" ? "active" : null)" type="button" @onclick='() => SetTab("accounts")'>Accounts</button>
            <button class="tab-button @(activeTab == "account-types" ? "active" : null)" type="button" @onclick='() => SetTab("account-types")'>Account Types</button>
            <button class="tab-button @(activeTab == "account-type-groups" ? "active" : null)" type="button" @onclick='() => SetTab("account-type-groups")'>Type Groups</button>
        </div>

        @if (activeTab == "relationships")
        {
            <div class="row g-4 mt-1">
                <div class="col-lg-5">
                    <div class="panel nested-panel h-100">
                        <div class="section-header">
                            <h2>Institution Tree</h2>
                            <p>Institutions own accounts, and each account carries a type.</p>
                        </div>

                        <LoadingState IsVisible="@isLoading" />
                        <EmptyState IsVisible="@(!isLoading && institutions.Count == 0)" Message="No institutions yet." />

                        @if (institutions.Count > 0)
                        {
                            <ul class="relationship-list">
                                @foreach (var institution in institutions.OrderBy(item => item.Name))
                                {
                                    <li>
                                        <div class="d-flex justify-content-between gap-3 align-items-start">
                                            <div>
                                                <strong>@institution.Name</strong>
                                                <div class="text-muted small">@institution.Accounts.Count accounts</div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => StartEditInstitution(institution)">Edit</button>
                                        </div>

                                        @if (institution.Accounts.Count > 0)
                                        {
                                            <ul class="small mt-2 mb-0">
                                                @foreach (var account in institution.Accounts.OrderBy(item => item.Name))
                                                {
                                                    <li>@account.Name (@account.Type.Name / @account.Type.Group.Name)</li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="panel nested-panel h-100">
                        <div class="section-header">
                            <h2>Accounts</h2>
                            <p>Review each account in the exact structure used for net worth entry.</p>
                        </div>

                        <LoadingState IsVisible="@isLoading" />
                        <EmptyState IsVisible="@(!isLoading && accounts.Count == 0)" Message="No accounts yet." />

                        @if (accounts.Count > 0)
                        {
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Institution</th>
                                        <th>Type</th>
                                        <th>Group</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in accounts.OrderBy(item => item.Name))
                                    {
                                        <tr>
                                            <td>@account.Name</td>
                                            <td>@account.Institution.Name</td>
                                            <td>@account.Type.Name</td>
                                            <td>@account.Type.Group.Name</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick='() => SetTab("accounts")'>Open editor</button>
                        }
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="panel nested-panel h-100">
                        <div class="section-header">
                            <h2>Account Types</h2>
                            <p>Types help explain what each balance means.</p>
                        </div>

                        <LoadingState IsVisible="@isLoading" />
                        <EmptyState IsVisible="@(!isLoading && accountTypes.Count == 0)" Message="No account types yet." />

                        @if (accountTypes.Count > 0)
                        {
                            <ul class="relationship-list">
                                @foreach (var accountType in accountTypes.OrderBy(item => item.Name))
                                {
                                    <li class="d-flex justify-content-between gap-3 align-items-center">
                                        <span>@accountType.Name (@accountType.Group.Name)</span>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => StartEditAccountType(accountType)">Edit</button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "institutions")
        {
            <div class="mt-1">
                <div class="section-header">
                    <h2>Institutions</h2>
                    <p>Manage the banks and brokerages connected to your accounts.</p>
                </div>

                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editInstitutionModel is null ? "Add Institution" : "Edit Institution")</h3>
                                <p>@(editInstitutionModel is null ? "Create a source location for current and future accounts." : $"Updating institution #{editInstitutionModel.Id}.")</p>
                            </div>

                            @if (editInstitutionModel is null)
                            {
                                <EditForm Model="createInstitutionModel" OnValidSubmit="CreateInstitutionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-8">
                                            <label class="form-label" for="institutionName">Institution Name</label>
                                            <InputText id="institutionName" class="form-control" @bind-Value="createInstitutionModel.InstitutionName" />
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Institution</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editInstitutionModel" OnValidSubmit="UpdateInstitutionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-8">
                                            <label class="form-label" for="editInstitutionName">Institution Name</label>
                                            <InputText id="editInstitutionName" class="form-control" @bind-Value="editInstitutionModel.InstitutionName" />
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelInstitutionEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Institution List</h3>
                                <p>Review all institutions and how many accounts each currently owns.</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && institutions.Count == 0)" Message="No institutions yet." />

                            @if (institutions.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Accounts</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in institutions.OrderBy(i => i.Name))
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td>@item.Accounts.Count</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadInstitutionDetailAsync(item.Id)">Open</button>
                                                        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEditInstitution(item)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteInstitutionAsync(item.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-3">
                        @if (selectedInstitution is not null)
                        {
                            <div class="panel nested-panel h-100 detail-panel">
                                <div class="section-header">
                                    <h3>Institution Details</h3>
                                    <p>@selectedInstitution.Name</p>
                                </div>

                                <h4>Linked Accounts</h4>
                                <EmptyState IsVisible="@(selectedInstitution.Accounts.Count == 0)" Message="No linked accounts yet." />
                                @if (selectedInstitution.Accounts.Count > 0)
                                {
                                    <ul>
                                        @foreach (var account in selectedInstitution.Accounts.OrderBy(a => a.Name))
                                        {
                                            <li>@account.Name (@account.Type.Name)</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "accounts")
        {
            <div class="mt-1">
                <div class="section-header">
                    <h2>Accounts</h2>
                    <p>Organize each financial account with its institution and account type, then reuse that structure in Net Worth.</p>
                </div>

                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editAccountModel is null ? "Add Account" : "Edit Account")</h3>
                                <p>@(editAccountModel is null ? "Set a clear account name and assign it to one institution and one type." : $"Updating account #{editAccountModel.Id}.")</p>
                            </div>

                            @if (editAccountModel is null)
                            {
                                <EditForm Model="createAccountModel" OnValidSubmit="CreateAccountAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="accountName">Account Name</label>
                                            <InputText id="accountName" class="form-control" @bind-Value="createAccountModel.AccountName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="institution">Institution</label>
                                            <InputSelect id="institution" class="form-select" @bind-Value="createAccountModel.InstitutionId">
                                                <option value="0">Select institution</option>
                                                @foreach (var institution in institutions.OrderBy(i => i.Name))
                                                {
                                                    <option value="@institution.Id">@institution.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="accountType">Account Type</label>
                                            <InputSelect id="accountType" class="form-select" @bind-Value="createAccountModel.AccountTypeId">
                                                <option value="0">Select account type</option>
                                                @foreach (var accountType in accountTypes.OrderBy(t => t.Name))
                                                {
                                                    <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Account</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editAccountModel" OnValidSubmit="UpdateAccountAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="editAccountName">Account Name</label>
                                            <InputText id="editAccountName" class="form-control" @bind-Value="editAccountModel.AccountName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="editInstitution">Institution</label>
                                            <InputSelect id="editInstitution" class="form-select" @bind-Value="editAccountModel.InstitutionId">
                                                <option value="0">Select institution</option>
                                                @foreach (var institution in institutions.OrderBy(i => i.Name))
                                                {
                                                    <option value="@institution.Id">@institution.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="editAccountType">Account Type</label>
                                            <InputSelect id="editAccountType" class="form-select" @bind-Value="editAccountModel.AccountTypeId">
                                                <option value="0">Select account type</option>
                                                @foreach (var accountType in accountTypes.OrderBy(t => t.Name))
                                                {
                                                    <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelAccountEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Account List</h3>
                                <p>Review all accounts and maintain consistent naming.</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && accounts.Count == 0)" Message="No accounts yet." />

                            @if (accounts.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Institution</th>
                                                <th>Type</th>
                                                <th>Group</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var account in accounts.OrderBy(a => a.Name))
                                            {
                                                <tr>
                                                    <td>@account.Name</td>
                                                    <td>@account.Institution.Name</td>
                                                    <td>@account.Type.Name</td>
                                                    <td>@account.Type.Group.Name</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadAccountDetailAsync(account.Id)">Open</button>
                                                        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEditAccount(account)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAccountAsync(account.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-3">
                        @if (selectedAccount is not null)
                        {
                            <div class="panel nested-panel h-100 detail-panel">
                                <div class="section-header">
                                    <h3>Account Details</h3>
                                    <p>@selectedAccount.Name</p>
                                </div>

                                <dl>
                                    <dt>Name</dt>
                                    <dd>@selectedAccount.Name</dd>
                                    <dt>Institution</dt>
                                    <dd>@GetInstitutionName(selectedAccount.Institution.Id)</dd>
                                    <dt>Type</dt>
                                    <dd>@selectedAccount.Type.Name</dd>
                                    <dt>Group</dt>
                                    <dd>@selectedAccount.Type.Group.Name</dd>
                                </dl>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "account-types")
        {
            <div class="mt-1">
                <div class="section-header">
                    <h2>Account Types</h2>
                    <p>Define clear categories for each account in your financial model.</p>
                </div>

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editAccountTypeModel is null ? "Add Account Type" : "Edit Account Type")</h3>
                                <p>@(editAccountTypeModel is null ? "Use short, recognizable names like Checking, Credit, or Investment." : $"Updating type #{editAccountTypeModel.Id}.")</p>
                            </div>

                            @if (editAccountTypeModel is null)
                            {
                                <EditForm Model="createAccountTypeModel" OnValidSubmit="CreateAccountTypeAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-6">
                                            <label class="form-label" for="name">Name</label>
                                            <InputText id="name" class="form-control" @bind-Value="createAccountTypeModel.Name" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="accountTypeGroup">Group</label>
                                            <InputSelect id="accountTypeGroup" class="form-select" @bind-Value="createAccountTypeModel.AccountTypeGroupId">
                                                <option value="0">Select group</option>
                                                @foreach (var group in accountTypeGroups.OrderBy(item => item.Name))
                                                {
                                                    <option value="@group.Id">@group.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Type</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editAccountTypeModel" OnValidSubmit="UpdateAccountTypeAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-6">
                                            <label class="form-label" for="editName">Name</label>
                                            <InputText id="editName" class="form-control" @bind-Value="editAccountTypeModel.Name" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="editAccountTypeGroup">Group</label>
                                            <InputSelect id="editAccountTypeGroup" class="form-select" @bind-Value="editAccountTypeModel.AccountTypeGroupId">
                                                <option value="0">Select group</option>
                                                @foreach (var group in accountTypeGroups.OrderBy(item => item.Name))
                                                {
                                                    <option value="@group.Id">@group.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelAccountTypeEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Catalog</h3>
                                <p>Manage all available account type labels.</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && accountTypes.Count == 0)" Message="No account types yet." />

                            @if (accountTypes.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Group</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in accountTypes.OrderBy(a => a.Name))
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td>@item.Group.Name</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadAccountTypeDetailAsync(item.Id)">Open</button>
                                                        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEditAccountType(item)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAccountTypeAsync(item.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        @if (selectedAccountType is not null)
                        {
                            <div class="panel nested-panel h-100 detail-panel">
                                <div class="section-header">
                                    <h3>Type Details</h3>
                                    <p>Selected account type information.</p>
                                </div>

                                <dl>
                                    <dt>Name</dt>
                                    <dd>@selectedAccountType.Name</dd>
                                    <dt>Group</dt>
                                    <dd>@selectedAccountType.Group.Name</dd>
                                </dl>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "account-type-groups")
        {
            <div class="mt-1">
                <div class="section-header">
                    <h2>Account Type Groups</h2>
                    <p>Create the higher-level buckets used for totals across account types.</p>
                </div>

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editAccountTypeGroupModel is null ? "Add Type Group" : "Edit Type Group")</h3>
                            </div>

                            @if (editAccountTypeGroupModel is null)
                            {
                                <EditForm Model="createAccountTypeGroupModel" OnValidSubmit="CreateAccountTypeGroupAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-8">
                                            <label class="form-label" for="groupName">Name</label>
                                            <InputText id="groupName" class="form-control" @bind-Value="createAccountTypeGroupModel.Name" />
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Group</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editAccountTypeGroupModel" OnValidSubmit="UpdateAccountTypeGroupAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-8">
                                            <label class="form-label" for="editGroupName">Name</label>
                                            <InputText id="editGroupName" class="form-control" @bind-Value="editAccountTypeGroupModel.Name" />
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelAccountTypeGroupEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Group Catalog</h3>
                                <p>Each account type must map to one of these groups.</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && accountTypeGroups.Count == 0)" Message="No account type groups yet." />

                            @if (accountTypeGroups.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in accountTypeGroups.OrderBy(item => item.Name))
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditAccountTypeGroup(item)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAccountTypeGroupAsync(item.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="panel nested-panel h-100 detail-panel">
                            <div class="section-header">
                                <h3>Usage</h3>
                                <p>How many account types are currently assigned to each group.</p>
                            </div>

                            <ul class="mb-0">
                                @foreach (var item in accountTypeGroups.OrderBy(item => item.Name))
                                {
                                    <li>@item.Name (@accountTypes.Count(type => type.Group.Id == item.Id) types)</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

