@page "/accounts"
@attribute [Authorize]
@inject IAccountsApiClient AccountsApiClient
@inject IInstitutionsApiClient InstitutionsApiClient
@inject IAccountTypesApiClient AccountTypesApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Accounts</PageTitle>

<div class="crud-page">
    <header class="page-hero">
        <div>
            <h1>Accounts</h1>
            <p>Organize each financial account with its institution and account type.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadListAsync" disabled="@isLoading">Refresh</button>
            <button class="btn btn-primary" type="button" @onclick="StartCreate">New Account</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (showEditor)
    {
        <section class="panel">
            <div class="section-header">
                <h2>@(editModel is null ? "Add Account" : "Edit Account")</h2>
                <p>@(editModel is null ? "Set a clear account name and assign it to one institution and one type." : $"Updating account #{editModel.Id}.")</p>
            </div>

            @if (editModel is null)
            {
                <EditForm Model="createModel" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="accountName">Account Name</label>
                            <InputText id="accountName" class="form-control" @bind-Value="createModel.AccountName" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="institution">Institution</label>
                            <InputSelect id="institution" class="form-select" @bind-Value="createModel.InstitutionId">
                                <option value="0">Select institution</option>
                                @foreach (var institution in institutions)
                                {
                                    <option value="@institution.Id">@institution.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="accountType">Account Type</label>
                            <InputSelect id="accountType" class="form-select" @bind-Value="createModel.AccountTypeId">
                                <option value="0">Select account type</option>
                                @foreach (var accountType in accountTypes)
                                {
                                    <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Account</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditor">Close</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="editModel" OnValidSubmit="UpdateAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="editAccountName">Account Name</label>
                            <InputText id="editAccountName" class="form-control" @bind-Value="editModel.AccountName" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="editInstitution">Institution</label>
                            <InputSelect id="editInstitution" class="form-select" @bind-Value="editModel.InstitutionId">
                                <option value="0">Select institution</option>
                                @foreach (var institution in institutions)
                                {
                                    <option value="@institution.Id">@institution.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="editAccountType">Account Type</label>
                            <InputSelect id="editAccountType" class="form-select" @bind-Value="editModel.AccountTypeId">
                                <option value="0">Select account type</option>
                                @foreach (var accountType in accountTypes)
                                {
                                    <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                    </div>
                </EditForm>
            }
        </section>
    }

    <section class="panel">
        <div class="section-header">
            <h2>Account List</h2>
            <p>Review all accounts and maintain consistent naming.</p>
        </div>

        <LoadingState IsVisible="@isLoading" />
        <EmptyState IsVisible="@(!isLoading && accounts.Count == 0)" Message="No accounts yet." />

        @if (accounts.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Name</th>
                            <th>Institution</th>
                            <th>Type</th>
                            <th>Group</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in accounts)
                        {
                            <tr>
                                <td>@account.DisplayOrder</td>
                                <td>@account.Name</td>
                                <td>@GetInstitutionName(account.Institution.Id)</td>
                                <td>@account.Type.Name</td>
                                <td>@account.Type.Group.Name</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(account.Id)">Open</button>
                                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(account)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(account.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (selectedAccount is not null)
    {
        <section class="panel detail-panel">
            <div class="section-header">
                <h2>Account Details</h2>
                <p>@selectedAccount.Name</p>
            </div>

            <dl>
                <dt>Name</dt>
                <dd>@selectedAccount.Name</dd>
                <dt>Institution</dt>
                <dd>@GetInstitutionName(selectedAccount.Institution.Id)</dd>
                <dt>Type</dt>
                <dd>@selectedAccount.Type.Name</dd>
                <dt>Group</dt>
                <dd>@selectedAccount.Type.Group.Name</dd>
            </dl>
        </section>
    }
</div>

@code {
    private readonly CreateModel createModel = new();
    private readonly List<AccountResponse> accounts = [];
    private readonly List<AccountTypeResponse> accountTypes = [];
    private readonly List<InstitutionResponse> institutions = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private AccountResponse? selectedAccount;
    private EditModel? editModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showEditor;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadListAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            institutions.Clear();
            institutions.AddRange(await InstitutionsApiClient.GetAllAsync());

            accountTypes.Clear();
            accountTypes.AddRange(await AccountTypesApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedAccount = await AccountsApiClient.GetByIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountsApiClient.CreateAsync(
            createModel.AccountName,
            createModel.InstitutionId,
            createModel.AccountTypeId);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.AccountName = string.Empty;
        createModel.InstitutionId = 0;
        createModel.AccountTypeId = 0;
        showEditor = false;
        successMessage = "Account saved.";
        await LoadListAsync();
    }

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editModel = null;
    }

    private void StartEdit(AccountResponse account)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = new EditModel
        {
            Id = account.Id,
            AccountName = account.Name,
            InstitutionId = account.Institution.Id,
            AccountTypeId = account.Type.Id
        };
        showEditor = true;
    }

    private string GetInstitutionName(int institutionId)
    {
        var institution = institutions.FirstOrDefault(i => i.Id == institutionId);
        return institution is null ? $"#{institutionId}" : institution.Name;
    }

    private void CancelEdit() => CloseEditor();

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountsApiClient.UpdateAsync(
            editModel.Id,
            editModel.AccountName,
            editModel.InstitutionId,
            editModel.AccountTypeId);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editModel = null;
        showEditor = false;
        successMessage = "Account updated.";
        await LoadListAsync();
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete this account? (ID {id})");
        if (!confirmed)
            return;

        var result = await AccountsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedAccount?.Id == id)
            selectedAccount = null;

        if (editModel?.Id == id)
            editModel = null;

        successMessage = "Account deleted.";

        await LoadListAsync();
    }

    private sealed class CreateModel
    {
        public string AccountName { get; set; } = string.Empty;
        public int InstitutionId { get; set; }
        public int AccountTypeId { get; set; }
    }

    private sealed class EditModel
    {
        public int Id { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public int InstitutionId { get; set; }
        public int AccountTypeId { get; set; }
    }
}
