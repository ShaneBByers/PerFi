    private async Task CreateContributionAsync()
    {
        if (createContributionModel.AccountId == 0)
        {
            ToastService.ShowError("Select an account before saving.");
            return;
        }

        if (isBulkAddMode)
        {
            await CreateBulkContributionsAsync();
            return;
        }

        isSubmitting = true;

        var result = await ContributionsApiClient.CreateAsync(
            createContributionModel.Date,
            createContributionModel.Amount,
            createContributionModel.Contributor,
            createContributionModel.AccountId);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        createContributionModel.Amount = 0m;
        createContributionModel.Contributor = ContributionContributorType.Self;
        createContributionModel.AccountId = 0;
        CloseContributionModal();
        ToastService.ShowSuccess("Contribution saved.");
        await LoadAllAsync();
    }

    private async Task CreateBulkContributionsAsync()
    {
        if (bulkContributionDates.Count == 0)
        {
            ToastService.ShowError("Add at least one date before saving.");
            return;
        }

        isSubmitting = true;

        var succeeded = 0;
        var failures = new List<string>();

        foreach (var date in bulkContributionDates)
        {
            var result = await ContributionsApiClient.CreateAsync(
                date,
                createContributionModel.Amount,
                createContributionModel.Contributor,
                createContributionModel.AccountId);

            if (result.IsSuccess)
                succeeded++;
            else
                failures.Add($"{date:MMM dd, yyyy}: {result.ErrorMessage}");
        }

        isSubmitting = false;

        if (failures.Count > 0)
            ToastService.ShowError($"Added {succeeded} of {bulkContributionDates.Count} contributions. Failures: {string.Join("; ", failures)}");
        else
            ToastService.ShowSuccess($"Added {succeeded} contribution(s).");

        createContributionModel.Amount = 0m;
        createContributionModel.Contributor = ContributionContributorType.Self;
        createContributionModel.AccountId = 0;
        CloseContributionModal();
        await LoadAllAsync();
    }

