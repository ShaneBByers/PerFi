@page "/cash-flow"
@attribute [Authorize]
@inject ITransactionsApiClient TransactionsApiClient
@inject IContributionsApiClient ContributionsApiClient
@inject ITransactionCategoriesApiClient TransactionCategoriesApiClient
@inject ITransactionCategoryGroupsApiClient TransactionCategoryGroupsApiClient
@inject IContributionContributorsApiClient ContributionContributorsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Cash Flow</PageTitle>

<div class="cash-flow-page">
    <header class="page-hero">
        <div>
            <h1>Cash Flow</h1>
            <p>Track transactions and contributions separately from your Net Worth snapshots.</p>
        </div>
        <div class="hero-actions">
            <div class="range-control">
                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">@GetRangeButtonLabel()</button>

                @if (showRangePicker)
                {
                    <div class="range-popover" role="dialog" aria-label="Date range options">
                        <div class="filter-presets" role="toolbar" aria-label="Cash Flow range presets">
                            <button class='@GetRangeClass("ytd")' @onclick='() => SetRangePreset("ytd")'>YTD</button>
                            <button class='@GetRangeClass("3m")' @onclick='() => SetRangePreset("3m")'>3M</button>
                            <button class='@GetRangeClass("6m")' @onclick='() => SetRangePreset("6m")'>6M</button>
                            <button class='@GetRangeClass("12m")' @onclick='() => SetRangePreset("12m")'>12M</button>
                            <button class='@GetRangeClass("all")' @onclick='() => SetRangePreset("all")'>All</button>
                        </div>
                        <div class="custom-range row g-2 align-items-end mt-1">
                            <div class="col-md-4">
                                <label class="form-label" for="cashFlowCustomStart">Start</label>
                                <InputDate id="cashFlowCustomStart" class="form-control" @bind-Value="customStartDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="cashFlowCustomEnd">End</label>
                                <InputDate id="cashFlowCustomEnd" class="form-control" @bind-Value="customEndDate" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyCustomRange">Apply</button>
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">Close</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadAllAsync" disabled="@isLoading">Refresh</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="summary-grid" aria-label="Cash Flow highlights">
        <article class="summary-card">
            <span class="summary-label">Total Contributions</span>
            <strong>@FormatCurrency(totalContributions)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Total Transactions</span>
            <strong>@FormatCurrency(totalTransactions)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Net Cash Flow</span>
            <strong class="@(netCashFlow >= 0 ? "positive" : "negative")">@FormatCurrency(netCashFlow)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Transactions in Range</span>
            <strong>@filteredTransactions.Count</strong>
        </article>
    </section>

    <section class="chart-panel">
        <div class="section-header">
            <h2>Net Cash Flow Trend (@GetSelectedRangeChartLabel())</h2>
        </div>

        <EmptyState IsVisible="@(netCashFlowPoints.Count == 0)" Message="Add transactions or contributions to render the trend chart." />

        @if (netCashFlowPoints.Count > 0)
        {
            <ApexChart TItem="CashFlowMonthPoint" Title="Contributions vs Transactions" Height="320" Options="@CreateMonthlyChartOptions()">
                <ApexPointSeries TItem="CashFlowMonthPoint"
                                 Items="netCashFlowPoints"
                                 Name="Contributions"
                                 SeriesType="SeriesType.Bar"
                                 XValue="point => point.Label"
                                 YValue="point => point.ContributionsTotal" />
                <ApexPointSeries TItem="CashFlowMonthPoint"
                                 Items="netCashFlowPoints"
                                 Name="Transactions"
                                 SeriesType="SeriesType.Bar"
                                 XValue="point => point.Label"
                                 YValue="point => point.TransactionsTotal" />
                <ApexPointSeries TItem="CashFlowMonthPoint"
                                 Items="netCashFlowPoints"
                                 Name="Net"
                                 SeriesType="SeriesType.Line"
                                 XValue="point => point.Label"
                                 YValue="point => point.Net" />
            </ApexChart>
        }
    </section>

    <div class="chart-grid">
        <section class="chart-panel">
            <div class="section-header">
                <h2>Spending by Category Group</h2>
            </div>

            <EmptyState IsVisible="@(categoryGroupSpendingPoints.Count == 0)" Message="No transactions in this period." />

            @if (categoryGroupSpendingPoints.Count > 0)
            {
                <ApexChart TItem="CategoryBreakdownPoint" Title="@($"Spending by Category Group ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateBreakdownChartOptions()">
                    <ApexPointSeries TItem="CategoryBreakdownPoint"
                                     Items="categoryGroupSpendingPoints"
                                     Name="Spending"
                                     SeriesType="SeriesType.Bar"
                                     XValue="point => point.Name"
                                     YValue="point => point.Total" />
                </ApexChart>
            }
        </section>

        <section class="chart-panel">
            <div class="section-header">
                <h2>Contributions by Contributor</h2>
            </div>

            <EmptyState IsVisible="@(contributorBreakdownPoints.Count == 0)" Message="No contributions in this period." />

            @if (contributorBreakdownPoints.Count > 0)
            {
                <ApexChart TItem="CategoryBreakdownPoint" Title="@($"Contributions by Contributor ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateBreakdownChartOptions()">
                    <ApexPointSeries TItem="CategoryBreakdownPoint"
                                     Items="contributorBreakdownPoints"
                                     Name="Contributions"
                                     SeriesType="SeriesType.Bar"
                                     XValue="point => point.Name"
                                     YValue="point => point.Total" />
                </ApexChart>
            }
        </section>
    </div>

    <section class="panel">
        <div class="tab-strip" role="tablist" aria-label="Cash Flow sections">
            <button class="tab-button @(activeTab == "transactions" ? "active" : null)" type="button" @onclick='() => SetTab("transactions")'>Transactions</button>
            <button class="tab-button @(activeTab == "contributions" ? "active" : null)" type="button" @onclick='() => SetTab("contributions")'>Contributions</button>
        </div>

        @if (activeTab == "transactions")
        {
            <div class="mt-1">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editTransactionModel is null ? "Add Transaction" : "Edit Transaction")</h3>
                                <p>@(editTransactionModel is null ? "Record a new transaction against one of your accounts." : $"Updating transaction #{editTransactionModel.Id}.")</p>
                            </div>

                            @if (editTransactionModel is null)
                            {
                                <EditForm Model="createTransactionModel" OnValidSubmit="CreateTransactionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label" for="transactionDate">Date</label>
                                            <InputDate id="transactionDate" class="form-control" @bind-Value="createTransactionModel.Date" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label" for="transactionCounterparty">Counterparty</label>
                                            <InputText id="transactionCounterparty" class="form-control" @bind-Value="createTransactionModel.CounterpartyName" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="transactionAmount">Amount</label>
                                            <InputNumber id="transactionAmount" class="form-control" @bind-Value="createTransactionModel.Amount" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="transactionCategory">Category</label>
                                            <InputSelect id="transactionCategory" class="form-select" @bind-Value="createTransactionModel.TransactionCategoryId">
                                                <option value="0">Select category</option>
                                                @foreach (var category in transactionCategories)
                                                {
                                                    <option value="@category.Id">@category.Name (@category.Group.Name)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="transactionAccount">Account</label>
                                            <InputSelect id="transactionAccount" class="form-select" @bind-Value="createTransactionModel.AccountId">
                                                <option value="0">Select account</option>
                                                @foreach (var account in accounts)
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="transactionDescription">Description (optional)</label>
                                            <InputText id="transactionDescription" class="form-control" @bind-Value="createTransactionModel.Description" />
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Transaction</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editTransactionModel" OnValidSubmit="UpdateTransactionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label" for="editTransactionDate">Date</label>
                                            <InputDate id="editTransactionDate" class="form-control" @bind-Value="editTransactionModel.Date" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label" for="editTransactionCounterparty">Counterparty</label>
                                            <InputText id="editTransactionCounterparty" class="form-control" @bind-Value="editTransactionModel.CounterpartyName" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="editTransactionAmount">Amount</label>
                                            <InputNumber id="editTransactionAmount" class="form-control" @bind-Value="editTransactionModel.Amount" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="editTransactionCategory">Category</label>
                                            <InputSelect id="editTransactionCategory" class="form-select" @bind-Value="editTransactionModel.TransactionCategoryId">
                                                <option value="0">Select category</option>
                                                @foreach (var category in transactionCategories)
                                                {
                                                    <option value="@category.Id">@category.Name (@category.Group.Name)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label" for="editTransactionAccount">Account</label>
                                            <InputSelect id="editTransactionAccount" class="form-select" @bind-Value="editTransactionModel.AccountId">
                                                <option value="0">Select account</option>
                                                @foreach (var account in accounts)
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="editTransactionDescription">Description (optional)</label>
                                            <InputText id="editTransactionDescription" class="form-control" @bind-Value="editTransactionModel.Description" />
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelTransactionEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Transactions</h3>
                                <p>Showing transactions within @GetSelectedRangeChartLabel().</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && filteredTransactions.Count == 0)" Message="No transactions in this period." />

                            @if (filteredTransactions.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Counterparty</th>
                                                <th>Category</th>
                                                <th>Account</th>
                                                <th class="text-end">Amount</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var transaction in filteredTransactions)
                                            {
                                                <tr>
                                                    <td>@transaction.Date.ToString("MMM dd, yyyy")</td>
                                                    <td>
                                                        @transaction.CounterpartyName
                                                        @if (!string.IsNullOrWhiteSpace(transaction.Description))
                                                        {
                                                            <div class="text-muted small">@transaction.Description</div>
                                                        }
                                                    </td>
                                                    <td>@transaction.Category.Name <span class="text-muted small">(@transaction.Category.Group.Name)</span></td>
                                                    <td>@transaction.Account.Name</td>
                                                    <td class="text-end">@FormatCurrency(transaction.Amount)</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditTransaction(transaction)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteTransactionAsync(transaction.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "contributions")
        {
            <div class="mt-1">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>@(editContributionModel is null ? "Add Contribution" : "Edit Contribution")</h3>
                                <p>@(editContributionModel is null ? "Record a new contribution credited to a contributor." : $"Updating contribution #{editContributionModel.Id}.")</p>
                            </div>

                            @if (editContributionModel is null)
                            {
                                <EditForm Model="createContributionModel" OnValidSubmit="CreateContributionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label" for="contributionDate">Date</label>
                                            <InputDate id="contributionDate" class="form-control" @bind-Value="createContributionModel.Date" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contributionAmount">Amount</label>
                                            <InputNumber id="contributionAmount" class="form-control" @bind-Value="createContributionModel.Amount" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contributionContributor">Contributor</label>
                                            <InputSelect id="contributionContributor" class="form-select" @bind-Value="createContributionModel.ContributionContributorId">
                                                <option value="0">Select contributor</option>
                                                @foreach (var contributor in contributionContributors)
                                                {
                                                    <option value="@contributor.Id">@contributor.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contributionAccount">Account</label>
                                            <InputSelect id="contributionAccount" class="form-select" @bind-Value="createContributionModel.AccountId">
                                                <option value="0">Select account</option>
                                                @foreach (var account in accounts)
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Contribution</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else
                            {
                                <EditForm Model="editContributionModel" OnValidSubmit="UpdateContributionAsync">
                                    <DataAnnotationsValidator />
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label" for="editContributionDate">Date</label>
                                            <InputDate id="editContributionDate" class="form-control" @bind-Value="editContributionModel.Date" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="editContributionAmount">Amount</label>
                                            <InputNumber id="editContributionAmount" class="form-control" @bind-Value="editContributionModel.Amount" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="editContributionContributor">Contributor</label>
                                            <InputSelect id="editContributionContributor" class="form-select" @bind-Value="editContributionModel.ContributionContributorId">
                                                <option value="0">Select contributor</option>
                                                @foreach (var contributor in contributionContributors)
                                                {
                                                    <option value="@contributor.Id">@contributor.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="editContributionAccount">Account</label>
                                            <InputSelect id="editContributionAccount" class="form-select" @bind-Value="editContributionModel.AccountId">
                                                <option value="0">Select account</option>
                                                @foreach (var account in accounts)
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-12 d-flex gap-2 flex-wrap">
                                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelContributionEdit">Cancel</button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="panel nested-panel h-100">
                            <div class="section-header">
                                <h3>Contributions</h3>
                                <p>Showing contributions within @GetSelectedRangeChartLabel().</p>
                            </div>

                            <LoadingState IsVisible="@isLoading" />
                            <EmptyState IsVisible="@(!isLoading && filteredContributions.Count == 0)" Message="No contributions in this period." />

                            @if (filteredContributions.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Contributor</th>
                                                <th>Account</th>
                                                <th class="text-end">Amount</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var contribution in filteredContributions)
                                            {
                                                <tr>
                                                    <td>@contribution.Date.ToString("MMM dd, yyyy")</td>
                                                    <td>@contribution.Contributor.Name</td>
                                                    <td>@contribution.Account.Name</td>
                                                    <td class="text-end">@FormatCurrency(contribution.Amount)</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditContribution(contribution)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteContributionAsync(contribution.Id)">Delete</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private readonly CreateTransactionModel createTransactionModel = new();
    private readonly CreateContributionModel createContributionModel = new();
    private readonly List<AccountResponse> accounts = [];
    private readonly List<TransactionCategoryResponse> transactionCategories = [];
    private readonly List<ContributionContributorResponse> contributionContributors = [];
    private readonly List<TransactionResponse> transactions = [];
    private readonly List<ContributionResponse> contributions = [];
    private readonly List<TransactionResponse> filteredTransactions = [];
    private readonly List<ContributionResponse> filteredContributions = [];
    private readonly List<CashFlowMonthPoint> netCashFlowPoints = [];
    private readonly List<CategoryBreakdownPoint> categoryGroupSpendingPoints = [];
    private readonly List<CategoryBreakdownPoint> contributorBreakdownPoints = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private EditTransactionModel? editTransactionModel;
    private EditContributionModel? editContributionModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showRangePicker;
    private string activeTab = "transactions";
    private string? errorMessage;
    private string? successMessage;
    private string selectedRangePreset = "ytd";
    private DateTime customStartDate = new(DateTime.Today.Year, 1, 1);
    private DateTime customEndDate = DateTime.Today;
    private decimal totalTransactions;
    private decimal totalContributions;
    private decimal netCashFlow;

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());

            transactionCategories.Clear();
            transactionCategories.AddRange(await TransactionCategoriesApiClient.GetAllAsync());

            contributionContributors.Clear();
            contributionContributors.AddRange(await ContributionContributorsApiClient.GetAllAsync());

            transactions.Clear();
            transactions.AddRange(await TransactionsApiClient.GetAllAsync());

            contributions.Clear();
            contributions.AddRange(await ContributionsApiClient.GetAllAsync());

            RebuildCashFlowView();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetTab(string tab) => activeTab = tab;

    private void ToggleRangePicker() => showRangePicker = !showRangePicker;

    private void SetRangePreset(string preset)
    {
        selectedRangePreset = preset;
        showRangePicker = false;
        RebuildCashFlowView();
    }

    private void ApplyCustomRange()
    {
        if (customEndDate < customStartDate)
            (customStartDate, customEndDate) = (customEndDate, customStartDate);

        selectedRangePreset = "custom";
        showRangePicker = false;
        RebuildCashFlowView();
    }

    private string GetRangeButtonLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "Range: YTD",
            "3m" => "Range: 3M",
            "6m" => "Range: 6M",
            "12m" => "Range: 12M",
            "all" => "Range: All",
            "custom" => $"Range: {customStartDate:MMM d} - {customEndDate:MMM d}",
            _ => "Range"
        };
    }

    private string GetSelectedRangeChartLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "3m" => "Last 3 Months",
            "6m" => "Last 6 Months",
            "12m" => "Last 12 Months",
            "all" => "All Time",
            "custom" => $"Custom: {customStartDate:MMM d, yyyy} to {customEndDate:MMM d, yyyy}",
            _ => "Selected Range"
        };
    }

    private string GetRangeClass(string preset)
    {
        return selectedRangePreset == preset
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
    }

    private void RebuildCashFlowView()
    {
        filteredTransactions.Clear();
        filteredContributions.Clear();
        netCashFlowPoints.Clear();
        categoryGroupSpendingPoints.Clear();
        contributorBreakdownPoints.Clear();

        var latestDate = new[] { transactions.Select(t => t.Date), contributions.Select(c => c.Date) }
            .SelectMany(dates => dates)
            .DefaultIfEmpty(DateOnly.FromDateTime(DateTime.Today))
            .Max();

        filteredTransactions.AddRange(FilterByRange(transactions, t => t.Date, latestDate).OrderByDescending(t => t.Date));
        filteredContributions.AddRange(FilterByRange(contributions, c => c.Date, latestDate).OrderByDescending(c => c.Date));

        totalTransactions = filteredTransactions.Sum(t => t.Amount);
        totalContributions = filteredContributions.Sum(c => c.Amount);
        netCashFlow = totalContributions - totalTransactions;

        var monthlyContributions = filteredContributions
            .GroupBy(c => new DateOnly(c.Date.Year, c.Date.Month, 1))
            .ToDictionary(group => group.Key, group => group.Sum(c => c.Amount));

        var monthlyTransactions = filteredTransactions
            .GroupBy(t => new DateOnly(t.Date.Year, t.Date.Month, 1))
            .ToDictionary(group => group.Key, group => group.Sum(t => t.Amount));

        var months = monthlyContributions.Keys.Concat(monthlyTransactions.Keys).Distinct().OrderBy(month => month);

        foreach (var month in months)
        {
            var contributionsTotal = monthlyContributions.GetValueOrDefault(month, 0m);
            var transactionsTotal = monthlyTransactions.GetValueOrDefault(month, 0m);
            netCashFlowPoints.Add(new CashFlowMonthPoint(month.ToString("MMM yyyy"), contributionsTotal, transactionsTotal, contributionsTotal - transactionsTotal));
        }

        categoryGroupSpendingPoints.AddRange(filteredTransactions
            .GroupBy(t => t.Category.Group.Name)
            .Select(group => new CategoryBreakdownPoint(group.Key, group.Sum(t => t.Amount)))
            .OrderByDescending(point => point.Total));

        contributorBreakdownPoints.AddRange(filteredContributions
            .GroupBy(c => c.Contributor.Name)
            .Select(group => new CategoryBreakdownPoint(group.Key, group.Sum(c => c.Amount)))
            .OrderByDescending(point => point.Total));
    }

    private IReadOnlyList<T> FilterByRange<T>(List<T> items, Func<T, DateOnly> dateSelector, DateOnly latestDate)
    {
        if (selectedRangePreset == "all")
            return items;

        if (selectedRangePreset == "custom")
        {
            var customStart = DateOnly.FromDateTime(customStartDate);
            var customEnd = DateOnly.FromDateTime(customEndDate);
            return items.Where(item => dateSelector(item) >= customStart && dateSelector(item) <= customEnd).ToList();
        }

        if (selectedRangePreset == "ytd")
        {
            var startOfYear = new DateOnly(latestDate.Year, 1, 1);
            return items.Where(item => dateSelector(item) >= startOfYear && dateSelector(item) <= latestDate).ToList();
        }

        var months = selectedRangePreset switch
        {
            "3m" => 3,
            "6m" => 6,
            _ => 12
        };

        var threshold = latestDate.AddMonths(-months);
        return items.Where(item => dateSelector(item) >= threshold && dateSelector(item) <= latestDate).ToList();
    }

    private async Task CreateTransactionAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await TransactionsApiClient.CreateAsync(
            createTransactionModel.Date,
            createTransactionModel.CounterpartyName,
            createTransactionModel.Amount,
            createTransactionModel.TransactionCategoryId,
            createTransactionModel.AccountId,
            createTransactionModel.Description);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createTransactionModel.CounterpartyName = string.Empty;
        createTransactionModel.Amount = 0m;
        createTransactionModel.TransactionCategoryId = 0;
        createTransactionModel.AccountId = 0;
        createTransactionModel.Description = null;
        successMessage = "Transaction saved.";
        await LoadAllAsync();
    }

