@page "/cash-flow/{Section?}"
@attribute [Authorize]
@using System.Globalization
@inject NavigationManager NavigationManager
@inject ITransactionsApiClient TransactionsApiClient
@inject IContributionsApiClient ContributionsApiClient
@inject ITransactionCategoriesApiClient TransactionCategoriesApiClient
@inject ITransactionCategoryGroupsApiClient TransactionCategoryGroupsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Cash Flow</PageTitle>

<div class="cash-flow-page">
    <header class="cash-flow-hero">
        <div class="hero-top">
            <div class="hero-headline">
                <span class="hero-eyebrow">Cash Flow</span>
                <strong class="hero-figure @GetAmountClass(trailingNetTotal)">@FormatCurrency(trailingNetTotal)</strong>
                <span class="hero-asof">trailing 12 months</span>
            </div>

            <div class="hero-second-metric">
                <select class="form-select form-select-sm hero-group-select" @bind="selectedHeroMetric" aria-label="Secondary cash flow metric">
                    <option value="income">Income</option>
                    <option value="spending">Spending</option>
                </select>
                <strong class="hero-figure hero-figure-secondary">@FormatCurrency(GetHeroSecondMetricTotal())</strong>
            </div>

            <div class="hero-sparkline" aria-hidden="true" @key="chartVersion">
                @if (allTimeMonthlyPoints.Count > 1)
                {
                    <ApexChart TItem="CashFlowMonthPoint" Height="64" Options="@CreateSparklineChartOptions()">
                        <ApexPointSeries TItem="CashFlowMonthPoint"
                                         Items="allTimeMonthlyPoints"
                                         Name="Net Cash Flow"
                                         SeriesType="SeriesType.Area"
                                         XValue="point => point.Label"
                                         YValue="point => point.Net" />
                    </ApexChart>
                }
            </div>
        </div>

        <div class="hero-chips" aria-label="Cash Flow highlights">
            @foreach (var chip in GetHeroChips())
            {
                <article class="hero-chip">
                    <span class="hero-chip-label">@chip.Label</span>
                    <div class="hero-chip-metric">
                        @if (chip.Delta is not null)
                        {
                            <strong class="@GetAmountClass(chip.Delta.Amount)">@FormatDeltaCurrency(chip.Delta.Amount)</strong>
                            <span class="hero-chip-percent @GetAmountClass(chip.Delta.Amount)">@FormatPercent(chip.Delta.Percent)</span>
                        }
                        else
                        {
                            <strong class="amount-muted">&mdash;</strong>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="hero-actions">
            <div class="range-control">
                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">@GetRangeButtonLabel()</button>

                @if (showRangePicker)
                {
                    <div class="range-popover" role="dialog" aria-label="Date range options">
                        <div class="filter-presets" role="toolbar" aria-label="Cash Flow range presets">
                            <button class='@GetRangeClass("ytd")' @onclick='() => SetRangePreset("ytd")'>YTD</button>
                            <button class='@GetRangeClass("3m")' @onclick='() => SetRangePreset("3m")'>3M</button>
                            <button class='@GetRangeClass("6m")' @onclick='() => SetRangePreset("6m")'>6M</button>
                            <button class='@GetRangeClass("12m")' @onclick='() => SetRangePreset("12m")'>12M</button>
                            <button class='@GetRangeClass("all")' @onclick='() => SetRangePreset("all")'>All</button>
                        </div>
                        <div class="custom-range row g-2 align-items-end mt-1">
                            <div class="col-md-4">
                                <label class="form-label" for="cashFlowCustomStart">Start</label>
                                <InputDate id="cashFlowCustomStart" class="form-control" @bind-Value="customStartDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="cashFlowCustomEnd">End</label>
                                <InputDate id="cashFlowCustomEnd" class="form-control" @bind-Value="customEndDate" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyCustomRange">Apply</button>
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">Close</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="cash-flow-shell">
        <div class="cash-flow-content">
            <LoadingState IsVisible="@isLoading" />

            @if (!isLoading)
            {
                @if (activeSection == "overview")
                {
                    <section class="chart-panel" @key='("net-cash-flow", chartVersion)'>
                        <div class="section-header">
                            <h2>Net Cash Flow Trend (@GetSelectedRangeChartLabel())</h2>
                            <p class="range-delta @GetAmountClass(netCashFlow)">Net for range: @FormatCurrency(netCashFlow)</p>
                        </div>

                        <EmptyState IsVisible="@(netCashFlowPoints.Count == 0)" Message="Add transactions to render the trend chart." />

                        @if (netCashFlowPoints.Count > 0)
                        {
                            <ApexChart TItem="CashFlowMonthPoint" Title="Income vs Expenses" Height="320" Options="@CreateMonthlyChartOptions()">
                                <ApexPointSeries TItem="CashFlowMonthPoint"
                                                 Items="netCashFlowPoints"
                                                 Name="Income"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="point => point.Label"
                                                 YValue="point => point.IncomeTotal" />
                                <ApexPointSeries TItem="CashFlowMonthPoint"
                                                 Items="netCashFlowPoints"
                                                 Name="Expenses"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="point => point.Label"
                                                 YValue="point => point.ExpensesTotal" />
                                <ApexPointSeries TItem="CashFlowMonthPoint"
                                                 Items="netCashFlowPoints"
                                                 Name="Net"
                                                 SeriesType="SeriesType.Line"
                                                 XValue="point => point.Label"
                                                 YValue="point => point.Net" />
                            </ApexChart>
                        }
                    </section>

                    <section class="chart-panel" @key='("spending-by-category-group", chartVersion)'>
                        <div class="section-header">
                            <h2>Spending by Category Group</h2>
                        </div>

                        <EmptyState IsVisible="@(categoryGroupSpendingPoints.Count == 0)" Message="No transactions in this period." />

                        @if (categoryGroupSpendingPoints.Count > 0)
                        {
                            <ApexChart TItem="CategoryBreakdownPoint" Title="@($"Spending by Category Group ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateDonutChartOptions()">
                                <ApexPointSeries TItem="CategoryBreakdownPoint"
                                                 Items="categoryGroupSpendingPoints"
                                                 Name="Spending"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="point => point.Name"
                                                 YValue="point => point.Total" />
                            </ApexChart>
                        }
                    </section>
                }

                @if (activeSection == "transactions")
                {
                    var tableTransactions = GetTransactionsForTable();
                    <section class="content-section">
                        <div class="content-section-header">
                            <div>
                                <h2>Transactions</h2>
                                <p>Showing transactions within @GetSelectedRangeChartLabel().</p>
                            </div>
                            <button class="btn btn-primary" type="button" @onclick="OpenCreateTransactionModal">Add Transaction</button>
                        </div>

                        <div class="content-section-filters">
                            <select class="form-select form-select-sm" @bind="CategoryGroupFilterSelectValue" aria-label="Filter transactions by category group">
                                <option value="0">All Category Groups</option>
                                @foreach (var group in transactionCategoryGroups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                            <select class="form-select form-select-sm" @bind="categoryFilterId" aria-label="Filter transactions by category" disabled="@(categoryGroupFilterId == 0)">
                                <option value="0">@(categoryGroupFilterId == 0 ? "Select a category group first" : "All Categories")</option>
                                @foreach (var category in GetCategoryFilterOptions())
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            @if (categoryGroupFilterId != 0 || categoryFilterId != 0)
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ClearCategoryFilters">Clear category filters &times;</button>
                            }
                        </div>

                        <EmptyState IsVisible="@(tableTransactions.Count == 0)" Message="No transactions in this period." />

                        @if (tableTransactions.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-sm align-middle cash-flow-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Counterparty</th>
                                            <th>Category</th>
                                            <th>Account</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                        <tr class="table-total-row">
                                            <td colspan="4">Total (@tableTransactions.Count)</td>
                                            <td class="text-end">@FormatCurrency(tableTransactions.Sum(t => t.Amount))</td>
                                            <td></td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var transaction in tableTransactions)
                                        {
                                            <tr>
                                                <td>@transaction.Date.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    @transaction.CounterpartyName
                                                    @if (!string.IsNullOrWhiteSpace(transaction.Description))
                                                    {
                                                        <div class="cell-subtext">@transaction.Description</div>
                                                    }
                                                </td>
                                                <td>@transaction.Category.Name <span class="cell-subtext">(@transaction.Category.Group.Name)</span></td>
                                                <td>@transaction.Account.Name</td>
                                                <td class="text-end">@FormatCurrency(transaction.Amount)</td>
                                                <td class="text-end">
                                                    <div class="row-actions">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditTransaction(transaction)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTransactionAsync(transaction.Id)">Delete</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }

                @if (activeSection == "contributions")
                {
                    var tableContributions = GetContributionsForTable();

                    <section class="chart-panel" @key='("contributions-by-contributor", chartVersion)'>
                        <div class="section-header">
                            <h2>Contributions by Contributor</h2>
                        </div>

                        <EmptyState IsVisible="@(contributorBreakdownPoints.Count == 0)" Message="No contributions in this period." />

                        @if (contributorBreakdownPoints.Count > 0)
                        {
                            <ApexChart TItem="CategoryBreakdownPoint" Title="@($"Contributions by Contributor ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateDonutChartOptions()">
                                <ApexPointSeries TItem="CategoryBreakdownPoint"
                                                 Items="contributorBreakdownPoints"
                                                 Name="Contributions"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="point => point.Name"
                                                 YValue="point => point.Total" />
                            </ApexChart>
                        }
                    </section>

                    <section class="chart-panel" @key='("contributions-by-account", chartVersion)'>
                        <div class="section-header">
                            <h2>Contributions by Account</h2>
                        </div>

                        <EmptyState IsVisible="@(contributionAccountBreakdownPoints.Count == 0)" Message="No contributions in this period." />

                        @if (contributionAccountBreakdownPoints.Count > 0)
                        {
                            <ApexChart TItem="ContributionAccountBreakdownPoint" Title="@($"Contributions by Account ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateContributionBreakdownChartOptions()">
                                @if (ShowSelfContributions)
                                {
                                    <ApexPointSeries TItem="ContributionAccountBreakdownPoint"
                                                     Items="contributionAccountBreakdownPoints"
                                                     Name="Self"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="point => point.AccountName"
                                                     YValue="point => point.Self" />
                                }
                                @if (ShowEmployerContributions)
                                {
                                    <ApexPointSeries TItem="ContributionAccountBreakdownPoint"
                                                     Items="contributionAccountBreakdownPoints"
                                                     Name="Employer"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="point => point.AccountName"
                                                     YValue="point => point.Employer" />
                                }
                                @if (ShowOtherContributions)
                                {
                                    <ApexPointSeries TItem="ContributionAccountBreakdownPoint"
                                                     Items="contributionAccountBreakdownPoints"
                                                     Name="Other"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="point => point.AccountName"
                                                     YValue="point => point.Other" />
                                }
                            </ApexChart>

                            <div class="table-responsive contribution-breakdown-table">
                                <table class="table table-striped table-sm align-middle cash-flow-table">
                                    <thead>
                                        <tr>
                                            <th>Account</th>
                                            @if (ShowSelfContributions)
                                            {
                                                <th class="text-end">Self</th>
                                            }
                                            @if (ShowEmployerContributions)
                                            {
                                                <th class="text-end">Employer</th>
                                            }
                                            @if (ShowOtherContributions)
                                            {
                                                <th class="text-end">Other</th>
                                            }
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var point in contributionAccountBreakdownPoints)
                                        {
                                            <tr>
                                                <td>@point.AccountName</td>
                                                @if (ShowSelfContributions)
                                                {
                                                    <td class="text-end">@FormatCurrency(point.Self)</td>
                                                }
                                                @if (ShowEmployerContributions)
                                                {
                                                    <td class="text-end">@FormatCurrency(point.Employer)</td>
                                                }
                                                @if (ShowOtherContributions)
                                                {
                                                    <td class="text-end">@FormatCurrency(point.Other)</td>
                                                }
                                                <td class="text-end">@FormatCurrency(point.Self + point.Employer + point.Other)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="content-section">
                        <div class="content-section-header">
                            <div>
                                <h2>Contributions</h2>
                                <p>Showing contributions within @GetSelectedRangeChartLabel().</p>
                            </div>
                            <button class="btn btn-primary" type="button" @onclick="OpenCreateContributionModal">Add Contribution</button>
                        </div>

                        <div class="content-section-filters">
                            <select class="form-select form-select-sm" @bind="ContributorFilterSelectValue" aria-label="Filter contributions by contributor">
                                <option value="all">All Contributors</option>
                                @foreach (var contributorType in Enum.GetValues<ContributionContributorType>())
                                {
                                    <option value="@contributorType">@contributorType</option>
                                }
                            </select>
                            <select class="form-select form-select-sm" @bind="accountFilterId" aria-label="Filter contributions by account">
                                <option value="0">All Accounts</option>
                                @foreach (var account in GetContributionAccountFilterOptions())
                                {
                                    <option value="@account.Id">@account.Name</option>
                                }
                            </select>
                        </div>

                        <EmptyState IsVisible="@(tableContributions.Count == 0)" Message="No contributions in this period." />

                        @if (tableContributions.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-sm align-middle cash-flow-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Contributor</th>
                                            <th>Account</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                        <tr class="table-total-row">
                                            <td colspan="3">Total (@tableContributions.Count)</td>
                                            <td class="text-end">@FormatCurrency(tableContributions.Sum(c => c.Amount))</td>
                                            <td></td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var contribution in tableContributions)
                                        {
                                            <tr>
                                                <td>@contribution.Date.ToString("MMM dd, yyyy")</td>
                                                <td>@contribution.Contributor</td>
                                                <td>@contribution.Account.Name</td>
                                                <td class="text-end">@FormatCurrency(contribution.Amount)</td>
                                                <td class="text-end">
                                                    <div class="row-actions">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditContribution(contribution)">Edit</button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContributionAsync(contribution.Id)">Delete</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                }

                @if (activeSection == "categories")
                {
                    <section class="content-section">
                        <div class="content-section-header">
                            <div>
                                <h2>Category Insights</h2>
                                <p>Spending by category group for @GetSelectedRangeChartLabel() (Income excluded). Click a category to view its transactions.</p>
                            </div>
                        </div>

                        <div class="insights-summary-strip">
                            <div class="insights-summary-item">
                                <span class="insights-summary-label">Income</span>
                                <strong class="amount-positive">@FormatCurrency(insightsIncomeTotal)</strong>
                            </div>
                            <div class="insights-summary-item">
                                <span class="insights-summary-label">Spending</span>
                                <strong class="amount-negative">@FormatCurrency(insightsSpendingTotal)</strong>
                            </div>
                            <div class="insights-summary-item">
                                <span class="insights-summary-label">Net</span>
                                <strong class="@GetAmountClass(insightsIncomeTotal - insightsSpendingTotal)">@FormatCurrency(insightsIncomeTotal - insightsSpendingTotal)</strong>
                            </div>
                            <div class="insights-summary-item">
                                <span class="insights-summary-label">Savings Rate</span>
                                <strong>@FormatSavingsRate()</strong>
                            </div>
                        </div>

                        @if (topCounterparties.Count > 0)
                        {
                            <div class="top-counterparties">
                                <h3>Top Counterparties</h3>
                                <ol class="top-counterparties-list">
                                    @foreach (var point in topCounterparties)
                                    {
                                        <li><span>@point.Name</span><span class="amount-negative">@FormatCurrency(point.Total)</span></li>
                                    }
                                </ol>
                            </div>
                        }

                        <EmptyState IsVisible="@(categoryInsights.Count == 0)" Message="No transactions in this period." />

                        @if (categoryInsights.Count > 0)
                        {
                            <div class="category-insights">
                                @foreach (var group in categoryInsights)
                                {
                                    var isExpanded = expandedCategoryGroupIds.Contains(group.GroupId);
                                    <div class="allocation-row category-group-row">
                                        <div class="allocation-row-label">
                                            <span class="category-group-name">
                                                <button class="btn btn-sm btn-link expand-toggle" type="button" aria-label="@(isExpanded ? "Collapse group" : "Expand group")" @onclick="() => ToggleCategoryGroupExpanded(group.GroupId)">
                                                    <span class="expand-caret @(isExpanded ? "expanded" : null)">&#9656;</span>
                                                </button>
                                                @group.GroupName
                                            </span>
                                            <span class="allocation-row-value">@FormatCurrency(group.Total) &middot; @group.Percentage.ToString("0.#")%</span>
                                        </div>
                                        <div class="allocation-bar-track">
                                            <div class="allocation-bar-fill" style="width: @(group.Percentage.ToString("0.#"))%"></div>
                                        </div>
                                    </div>

                                    @if (isExpanded)
                                    {
                                        @foreach (var category in group.Categories)
                                        {
                                            <div class="allocation-row category-row" @onclick="() => GoToCategoryTransactions(category.CategoryId)">
                                                <div class="allocation-row-label">
                                                    <span>@category.CategoryName</span>
                                                    <span class="allocation-row-value">@FormatCurrency(category.Total) &middot; @category.Percentage.ToString("0.#")%</span>
                                                </div>
                                                <div class="allocation-bar-track allocation-bar-track-sm">
                                                    <div class="allocation-bar-fill" style="width: @(category.Percentage.ToString("0.#"))%"></div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                    </section>
                }
            }
        </div>
    </div>
</div>

<Modal Title="@(editTransactionModel is null ? "Add Transaction" : "Edit Transaction")"
       IsVisible="@(isCreatingTransaction || editTransactionModel is not null)"
       OnClose="CloseTransactionModal">
    @if (editTransactionModel is null)
    {
        <EditForm Model="createTransactionModel" OnValidSubmit="CreateTransactionAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="transactionDate">Date</label>
                    <InputDate id="transactionDate" class="form-control" @bind-Value="createTransactionModel.Date" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="transactionCounterparty">Counterparty</label>
                    <InputText id="transactionCounterparty" class="form-control" @bind-Value="createTransactionModel.CounterpartyName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="transactionAmount">Amount</label>
                    <InputNumber id="transactionAmount" class="form-control" @bind-Value="createTransactionModel.Amount" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="transactionCategory">Category</label>
                    <InputSelect id="transactionCategory" class="form-select" @bind-Value="createTransactionModel.TransactionCategoryId">
                        <option value="0">Select category</option>
                        @foreach (var category in transactionCategories)
                        {
                            <option value="@category.Id">@category.Name (@category.Group.Name)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="transactionAccount">Account</label>
                    <InputSelect id="transactionAccount" class="form-select" @bind-Value="createTransactionModel.AccountId">
                        <option value="0">Select account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label" for="transactionDescription">Description (optional)</label>
                    <InputText id="transactionDescription" class="form-control" @bind-Value="createTransactionModel.Description" />
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Transaction</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseTransactionModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="editTransactionModel" OnValidSubmit="UpdateTransactionAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="editTransactionDate">Date</label>
                    <InputDate id="editTransactionDate" class="form-control" @bind-Value="editTransactionModel.Date" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="editTransactionCounterparty">Counterparty</label>
                    <InputText id="editTransactionCounterparty" class="form-control" @bind-Value="editTransactionModel.CounterpartyName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="editTransactionAmount">Amount</label>
                    <InputNumber id="editTransactionAmount" class="form-control" @bind-Value="editTransactionModel.Amount" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="editTransactionCategory">Category</label>
                    <InputSelect id="editTransactionCategory" class="form-select" @bind-Value="editTransactionModel.TransactionCategoryId">
                        <option value="0">Select category</option>
                        @foreach (var category in transactionCategories)
                        {
                            <option value="@category.Id">@category.Name (@category.Group.Name)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="editTransactionAccount">Account</label>
                    <InputSelect id="editTransactionAccount" class="form-select" @bind-Value="editTransactionModel.AccountId">
                        <option value="0">Select account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label" for="editTransactionDescription">Description (optional)</label>
                    <InputText id="editTransactionDescription" class="form-control" @bind-Value="editTransactionModel.Description" />
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseTransactionModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
</Modal>

<Modal Title="@(editContributionModel is null ? "Add Contribution" : "Edit Contribution")"
       IsVisible="@(isCreatingContribution || editContributionModel is not null)"
       OnClose="CloseContributionModal"
       SizeClass="modal-md">
    @if (editContributionModel is null)
    {
        <EditForm Model="createContributionModel" OnValidSubmit="CreateContributionAsync">
            <DataAnnotationsValidator />
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="bulkAddToggle" checked="@isBulkAddMode" @onchange="ToggleBulkAddMode" />
                <label class="form-check-label" for="bulkAddToggle">Add multiple dates (same amount, contributor, and account)</label>
            </div>
            <div class="row g-3">
                @if (!isBulkAddMode)
                {
                    <div class="col-md-6">
                        <label class="form-label" for="contributionDate">Date</label>
                        <InputDate id="contributionDate" class="form-control" @bind-Value="createContributionModel.Date" />
                    </div>
                }
                <div class="col-md-6">
                    <label class="form-label" for="contributionAmount">Amount</label>
                    <InputNumber id="contributionAmount" class="form-control" @bind-Value="createContributionModel.Amount" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="contributionContributor">Contributor</label>
                    <InputSelect id="contributionContributor" class="form-select" @bind-Value="createContributionModel.Contributor">
                        @foreach (var contributorType in Enum.GetValues<ContributionContributorType>())
                        {
                            <option value="@contributorType">@contributorType</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="contributionAccount">Account</label>
                    <InputSelect id="contributionAccount" class="form-select" @bind-Value="createContributionModel.AccountId">
                        <option value="0">Select account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </InputSelect>
                </div>

                @if (isBulkAddMode)
                {
                    <div class="col-12">
                        <hr class="my-1" />
                        <label class="form-label mb-1">Dates</label>
                        <div class="bulk-date-generator d-flex gap-2 flex-wrap align-items-end mb-2">
                            <div>
                                <label class="form-label small mb-1" for="bulkStartDate">Start date</label>
                                <input type="date" id="bulkStartDate" class="form-control form-control-sm" @bind="bulkGenerateStartDate" />
                            </div>
                            <div>
                                <label class="form-label small mb-1" for="bulkFrequency">Frequency</label>
                                <select id="bulkFrequency" class="form-select form-select-sm" @bind="bulkGenerateFrequency">
                                    <option value="weekly">Weekly</option>
                                    <option value="biweekly">Every 2 weeks</option>
                                    <option value="semimonthly">Twice a month</option>
                                    <option value="monthly">Monthly</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label small mb-1" for="bulkCount">Count</label>
                                <input type="number" id="bulkCount" class="form-control form-control-sm bulk-count-input" min="1" max="52" @bind="bulkGenerateCount" />
                            </div>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="GenerateBulkDates">Generate Dates</button>
                        </div>

                        <div class="bulk-date-add d-flex gap-2 align-items-end mb-2">
                            <div class="flex-grow-1">
                                <label class="form-label small mb-1" for="bulkSingleDate">Add a single date</label>
                                <input type="date" id="bulkSingleDate" class="form-control form-control-sm" @bind="bulkSingleDate" />
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="AddBulkDate">+ Add Date</button>
                        </div>

                        <EmptyState IsVisible="@(bulkContributionDates.Count == 0)" Message="No dates added yet." />
                        @if (bulkContributionDates.Count > 0)
                        {
                            <div class="bulk-date-list d-flex gap-2 flex-wrap">
                                @foreach (var date in bulkContributionDates)
                                {
                                    <span class="badge bulk-date-chip">
                                        @date.ToString("MMM dd, yyyy")
                                        <button type="button" class="bulk-date-chip-remove" aria-label="Remove date" @onclick="() => RemoveBulkDate(date)">&times;</button>
                                    </span>
                                }
                            </div>
                            <p class="bulk-date-count small mt-1 mb-0">@bulkContributionDates.Count date(s) will be added.</p>
                        }
                    </div>
                }

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@(isSubmitting || (isBulkAddMode && bulkContributionDates.Count == 0))">
                        @(isBulkAddMode ? $"Add {bulkContributionDates.Count} Contribution(s)" : "Save Contribution")
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseContributionModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="editContributionModel" OnValidSubmit="UpdateContributionAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="editContributionDate">Date</label>
                    <InputDate id="editContributionDate" class="form-control" @bind-Value="editContributionModel.Date" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editContributionAmount">Amount</label>
                    <InputNumber id="editContributionAmount" class="form-control" @bind-Value="editContributionModel.Amount" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editContributionContributor">Contributor</label>
                    <InputSelect id="editContributionContributor" class="form-select" @bind-Value="editContributionModel.Contributor">
                        @foreach (var contributorType in Enum.GetValues<ContributionContributorType>())
                        {
                            <option value="@contributorType">@contributorType</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editContributionAccount">Account</label>
                    <InputSelect id="editContributionAccount" class="form-select" @bind-Value="editContributionModel.AccountId">
                        <option value="0">Select account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseContributionModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
</Modal>

@code {
    private readonly CreateTransactionModel createTransactionModel = new();
    private readonly CreateContributionModel createContributionModel = new();
    private readonly List<AccountResponse> accounts = [];
    private readonly List<TransactionCategoryResponse> transactionCategories = [];
    private readonly List<TransactionResponse> transactions = [];
    private readonly List<ContributionResponse> contributions = [];
    private readonly List<TransactionResponse> filteredTransactions = [];
    private readonly List<ContributionResponse> filteredContributions = [];
    private readonly List<CashFlowMonthPoint> netCashFlowPoints = [];
    private readonly List<CashFlowMonthPoint> allTimeMonthlyPoints = [];
    private readonly List<CategoryBreakdownPoint> categoryGroupSpendingPoints = [];
    private readonly List<CategoryBreakdownPoint> contributorBreakdownPoints = [];
    private readonly List<ContributionAccountBreakdownPoint> contributionAccountBreakdownPoints = [];

    private bool ShowSelfContributions => contributionAccountBreakdownPoints.Any(point => point.Self != 0m);
    private bool ShowEmployerContributions => contributionAccountBreakdownPoints.Any(point => point.Employer != 0m);
    private bool ShowOtherContributions => contributionAccountBreakdownPoints.Any(point => point.Other != 0m);
    private readonly List<CategoryGroupInsight> categoryInsights = [];
    private readonly List<CounterpartySpendPoint> topCounterparties = [];
    private readonly List<TransactionCategoryGroupResponse> transactionCategoryGroups = [];
    private readonly HashSet<int> expandedCategoryGroupIds = [];
    private EditTransactionModel? editTransactionModel;
    private EditContributionModel? editContributionModel;
    private bool isCreatingTransaction;
    private bool isCreatingContribution;
    private bool isBulkAddMode;
    private readonly List<DateOnly> bulkContributionDates = [];
    private DateOnly bulkGenerateStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly bulkSingleDate = DateOnly.FromDateTime(DateTime.Today);
    private string bulkGenerateFrequency = "biweekly";
    private int bulkGenerateCount = 1;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showRangePicker;
    private int chartVersion;
    private string activeSection = "overview";
    private string selectedHeroMetric = "income";
    private string selectedRangePreset = "ytd";
    private DateTime customStartDate = new(DateTime.Today.Year, 1, 1);
    private DateTime customEndDate = DateTime.Today;
    private int categoryGroupFilterId;
    private int categoryFilterId;
    private int accountFilterId;
    private ContributionContributorType? contributorFilter;
    private decimal totalTransactions;
    private decimal netCashFlow;
    private decimal trailingIncomeTotal;
    private decimal trailingSpendingTotal;
    private decimal trailingNetTotal;
    private decimal insightsIncomeTotal;
    private decimal insightsSpendingTotal;
    private HeroDelta? thisMonthDelta;
    private HeroDelta? thisQuarterDelta;
    private HeroDelta? ytdDelta;
    private HeroDelta? trailing12Delta;

    private string ContributorFilterSelectValue
    {
        get => contributorFilter?.ToString() ?? "all";
        set => contributorFilter = value == "all" ? null : Enum.Parse<ContributionContributorType>(value);
    }

    private int CategoryGroupFilterSelectValue
    {
        get => categoryGroupFilterId;
        set
        {
            categoryGroupFilterId = value;
            categoryFilterId = 0;
        }
    }

    [Parameter]
    public string? Section { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    protected override void OnParametersSet() => activeSection = Section ?? "overview";

    private async Task LoadAllAsync()
    {
        isLoading = true;

        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());

            transactionCategories.Clear();
            transactionCategories.AddRange(await TransactionCategoriesApiClient.GetAllAsync());

            transactionCategoryGroups.Clear();
            transactionCategoryGroups.AddRange(await TransactionCategoryGroupsApiClient.GetAllAsync());

            transactions.Clear();
            transactions.AddRange(await TransactionsApiClient.GetAllAsync());

            contributions.Clear();
            contributions.AddRange(await ContributionsApiClient.GetAllAsync());

            RebuildCashFlowView();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleRangePicker() => showRangePicker = !showRangePicker;

    private void SetRangePreset(string preset)
    {
        selectedRangePreset = preset;
        showRangePicker = false;
        RebuildCashFlowView();
    }

    private void ApplyCustomRange()
    {
        if (customEndDate < customStartDate)
            (customStartDate, customEndDate) = (customEndDate, customStartDate);

        selectedRangePreset = "custom";
        showRangePicker = false;
        RebuildCashFlowView();
    }

    private string GetRangeButtonLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "Range: YTD",
            "3m" => "Range: 3M",
            "6m" => "Range: 6M",
            "12m" => "Range: 12M",
            "all" => "Range: All",
            "custom" => $"Range: {customStartDate:MMM d} - {customEndDate:MMM d}",
            _ => "Range"
        };
    }

    private string GetSelectedRangeChartLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "3m" => "Last 3 Months",
            "6m" => "Last 6 Months",
            "12m" => "Last 12 Months",
            "all" => "All Time",
            "custom" => $"Custom: {customStartDate:MMM d, yyyy} to {customEndDate:MMM d, yyyy}",
            _ => "Selected Range"
        };
    }

    private string GetRangeClass(string preset)
    {
        return selectedRangePreset == preset
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
    }

    private List<TransactionResponse> GetTransactionsForTable() =>
        filteredTransactions
            .Where(t => categoryGroupFilterId == 0 || t.Category.Group.Id == categoryGroupFilterId)
            .Where(t => categoryFilterId == 0 || t.Category.Id == categoryFilterId)
            .ToList();

    private List<ContributionResponse> GetContributionsForTable() =>
        filteredContributions
            .Where(c => contributorFilter is null || c.Contributor == contributorFilter)
            .Where(c => accountFilterId == 0 || c.Account.Id == accountFilterId)
            .ToList();

    private IEnumerable<TransactionCategoryResponse> GetCategoryFilterOptions() =>
        categoryGroupFilterId == 0
            ? []
            : transactionCategories.Where(c => c.Group.Id == categoryGroupFilterId);

    private IEnumerable<AccountIdentityResponse> GetContributionAccountFilterOptions() =>
        filteredContributions
            .Select(c => c.Account)
            .DistinctBy(a => a.Id)
            .OrderBy(a => a.Name);

    private void ToggleCategoryGroupExpanded(int groupId)
    {
        if (!expandedCategoryGroupIds.Add(groupId))
            expandedCategoryGroupIds.Remove(groupId);
    }

    private void GoToCategoryTransactions(int categoryId)
    {
        categoryGroupFilterId = transactionCategories.FirstOrDefault(c => c.Id == categoryId)?.Group.Id ?? 0;
        categoryFilterId = categoryId;
        NavigationManager.NavigateTo("/cash-flow/transactions");
    }

    private void ClearCategoryFilters()
    {
        categoryGroupFilterId = 0;
        categoryFilterId = 0;
    }

    private void OpenCreateTransactionModal() => isCreatingTransaction = true;

    private void CloseTransactionModal()
    {
        isCreatingTransaction = false;
        editTransactionModel = null;
    }

    private void OpenCreateContributionModal()
    {
        isCreatingContribution = true;
        isBulkAddMode = false;
        bulkContributionDates.Clear();
        bulkGenerateStartDate = DateOnly.FromDateTime(DateTime.Today);
        bulkSingleDate = DateOnly.FromDateTime(DateTime.Today);
        bulkGenerateCount = 1;
    }

    private void CloseContributionModal()
    {
        isCreatingContribution = false;
        editContributionModel = null;
        isBulkAddMode = false;
        bulkContributionDates.Clear();
    }

    private void ToggleBulkAddMode(ChangeEventArgs e)
    {
        isBulkAddMode = e.Value is bool value && value;
        if (!isBulkAddMode)
            bulkContributionDates.Clear();
    }

    private void AddBulkDate()
    {
        if (bulkContributionDates.Contains(bulkSingleDate))
            return;

        bulkContributionDates.Add(bulkSingleDate);
        bulkContributionDates.Sort();
    }

    private void RemoveBulkDate(DateOnly date) => bulkContributionDates.Remove(date);

    private void GenerateBulkDates()
    {
        if (bulkGenerateCount < 1)
            return;

        IEnumerable<DateOnly> generated = bulkGenerateFrequency switch
        {
            "weekly" => Enumerable.Range(0, bulkGenerateCount).Select(i => bulkGenerateStartDate.AddDays(i * 7)),
            "biweekly" => Enumerable.Range(0, bulkGenerateCount).Select(i => bulkGenerateStartDate.AddDays(i * 14)),
            "monthly" => Enumerable.Range(0, bulkGenerateCount).Select(i => bulkGenerateStartDate.AddMonths(i)),
            "semimonthly" => GenerateSemiMonthlyDates(bulkGenerateStartDate, bulkGenerateCount),
            _ => []
        };

        foreach (var date in generated)
        {
            if (!bulkContributionDates.Contains(date))
                bulkContributionDates.Add(date);
        }

        bulkContributionDates.Sort();
    }

    private static List<DateOnly> GenerateSemiMonthlyDates(DateOnly startDate, int count)
    {
        var dates = new List<DateOnly>();
        var month = new DateOnly(startDate.Year, startDate.Month, 1);

        while (dates.Count < count)
        {
            foreach (var day in new[] { 1, 15 })
            {
                if (dates.Count >= count)
                    break;

                var candidate = new DateOnly(month.Year, month.Month, day);
                if (candidate >= startDate)
                    dates.Add(candidate);
            }

            month = month.AddMonths(1);
        }

        return dates;
    }

    private void RebuildCashFlowView()
    {
        chartVersion++;
        filteredTransactions.Clear();
        filteredContributions.Clear();
        netCashFlowPoints.Clear();
        allTimeMonthlyPoints.Clear();
        categoryGroupSpendingPoints.Clear();
        contributorBreakdownPoints.Clear();
        contributionAccountBreakdownPoints.Clear();
        categoryInsights.Clear();
        topCounterparties.Clear();

        var latestDate = new[] { transactions.Select(t => t.Date), contributions.Select(c => c.Date) }
            .SelectMany(dates => dates)
            .DefaultIfEmpty(DateOnly.FromDateTime(DateTime.Today))
            .Max();

        filteredTransactions.AddRange(FilterByRange(transactions, t => t.Date, latestDate).OrderByDescending(t => t.Date).ThenByDescending(t => t.Amount));
        filteredContributions.AddRange(FilterByRange(contributions, c => c.Date, latestDate).OrderByDescending(c => c.Date).ThenByDescending(c => c.Amount));

        totalTransactions = filteredTransactions.Sum(t => t.Amount);
        netCashFlow = totalTransactions;

        netCashFlowPoints.AddRange(BuildMonthlyPoints(filteredTransactions));
        allTimeMonthlyPoints.AddRange(BuildMonthlyPoints(transactions));

        categoryGroupSpendingPoints.AddRange(filteredTransactions
            .Where(t => t.Amount < 0m)
            .GroupBy(t => t.Category.Group.Name)
            .Select(group => new CategoryBreakdownPoint(group.Key, Math.Abs(group.Sum(t => t.Amount))))
            .OrderByDescending(point => point.Total));

        contributorBreakdownPoints.AddRange(filteredContributions
            .GroupBy(c => c.Contributor.ToString())
            .Select(group => new CategoryBreakdownPoint(group.Key, group.Sum(c => c.Amount)))
            .OrderByDescending(point => point.Total));

        contributionAccountBreakdownPoints.AddRange(filteredContributions
            .GroupBy(c => c.Account.Name)
            .Select(group => new ContributionAccountBreakdownPoint(
                group.Key,
                group.Where(c => c.Contributor == ContributionContributorType.Self).Sum(c => c.Amount),
                group.Where(c => c.Contributor == ContributionContributorType.Employer).Sum(c => c.Amount),
                group.Where(c => c.Contributor == ContributionContributorType.Other).Sum(c => c.Amount)))
            .OrderByDescending(point => point.Self + point.Employer + point.Other));

        categoryInsights.AddRange(BuildCategoryInsights());
        topCounterparties.AddRange(BuildTopCounterparties());

        insightsIncomeTotal = filteredTransactions.Where(t => t.Amount > 0m).Sum(t => t.Amount);
        insightsSpendingTotal = filteredTransactions.Where(t => t.Amount < 0m).Sum(t => Math.Abs(t.Amount));

        ComputeHeroMetrics();

        if (categoryGroupFilterId != 0 && transactionCategoryGroups.All(g => g.Id != categoryGroupFilterId))
            categoryGroupFilterId = 0;

        if (categoryFilterId != 0 && transactionCategories.All(c => c.Id != categoryFilterId))
            categoryFilterId = 0;

        if (accountFilterId != 0 && filteredContributions.All(c => c.Account.Id != accountFilterId))
            accountFilterId = 0;
    }

    private static List<CashFlowMonthPoint> BuildMonthlyPoints(IEnumerable<TransactionResponse> transactionsSource)
    {
        var monthlyGroups = transactionsSource
            .GroupBy(t => new DateOnly(t.Date.Year, t.Date.Month, 1))
            .OrderBy(group => group.Key);

        var points = new List<CashFlowMonthPoint>();
        foreach (var group in monthlyGroups)
        {
            var incomeTotal = group.Where(t => t.Amount > 0m).Sum(t => t.Amount);
            var expensesTotal = group.Where(t => t.Amount < 0m).Sum(t => Math.Abs(t.Amount));
            points.Add(new CashFlowMonthPoint(group.Key.ToString("MMM yyyy"), incomeTotal, expensesTotal, incomeTotal - expensesTotal));
        }

        return points;
    }

    private List<CategoryGroupInsight> BuildCategoryInsights()
    {
        // Only expense (negative-amount) transactions count as "spending"; Income nets out of this breakdown entirely.
        var spendingTransactions = filteredTransactions.Where(t => t.Amount < 0m).ToList();
        var total = spendingTransactions.Sum(t => Math.Abs(t.Amount));

        return spendingTransactions
            .GroupBy(t => t.Category.Group)
            .Select(groupGroup =>
            {
                var groupTotal = groupGroup.Sum(t => Math.Abs(t.Amount));
                var groupPercentage = total == 0m ? 0m : groupTotal / total * 100m;

                var categories = groupGroup
                    .GroupBy(t => t.Category)
                    .Select(catGroup =>
                    {
                        var catTotal = catGroup.Sum(t => Math.Abs(t.Amount));
                        var catPercentage = groupTotal == 0m ? 0m : catTotal / groupTotal * 100m;
                        return new CategoryInsightRow(catGroup.Key.Id, catGroup.Key.Name, catTotal, catPercentage);
                    })
                    .OrderByDescending(c => c.Total)
                    .ToList();

                return new CategoryGroupInsight(groupGroup.Key.Id, groupGroup.Key.Name, groupTotal, groupPercentage, categories);
            })
            .OrderByDescending(g => g.Total)
            .ToList();
    }

    private List<CounterpartySpendPoint> BuildTopCounterparties() =>
        filteredTransactions
            .Where(t => t.Amount < 0m)
            .GroupBy(t => t.CounterpartyName)
            .Select(group => new CounterpartySpendPoint(group.Key, Math.Abs(group.Sum(t => t.Amount))))
            .OrderByDescending(point => point.Total)
            .Take(8)
            .ToList();

    private void ComputeHeroMetrics()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        var trailingStart = today.AddDays(-364);
        var priorTrailingEnd = trailingStart.AddDays(-1);
        var priorTrailingStart = priorTrailingEnd.AddDays(-364);

        trailingIncomeTotal = SumIncome(trailingStart, today);
        trailingSpendingTotal = SumExpenses(trailingStart, today);
        trailingNetTotal = trailingIncomeTotal - trailingSpendingTotal;

        var monthStart = new DateOnly(today.Year, today.Month, 1);
        var previousMonthEnd = monthStart.AddDays(-1);
        var previousMonthStart = new DateOnly(previousMonthEnd.Year, previousMonthEnd.Month, 1);
        thisMonthDelta = BuildHeroDelta(ComputeNet(monthStart, today), ComputeNet(previousMonthStart, previousMonthEnd));

        var quarterStart = GetQuarterStart(today);
        var previousQuarterEnd = quarterStart.AddDays(-1);
        var previousQuarterStart = GetQuarterStart(previousQuarterEnd);
        thisQuarterDelta = BuildHeroDelta(ComputeNet(quarterStart, today), ComputeNet(previousQuarterStart, previousQuarterEnd));

        var yearStart = new DateOnly(today.Year, 1, 1);
        var priorYearStart = new DateOnly(today.Year - 1, 1, 1);
        var priorYearEnd = GetSameDayLastYear(today);
        ytdDelta = BuildHeroDelta(ComputeNet(yearStart, today), ComputeNet(priorYearStart, priorYearEnd));

        trailing12Delta = BuildHeroDelta(ComputeNet(trailingStart, today), ComputeNet(priorTrailingStart, priorTrailingEnd));
    }

    // Cash Flow is Income minus Expenses from Transactions only; Contributions are tracked separately.
    private decimal ComputeNet(DateOnly start, DateOnly end) => SumTransactions(start, end);

    private decimal SumIncome(DateOnly start, DateOnly end) =>
        transactions.Where(t => t.Date >= start && t.Date <= end && t.Amount > 0m).Sum(t => t.Amount);

    private decimal SumExpenses(DateOnly start, DateOnly end) =>
        transactions.Where(t => t.Date >= start && t.Date <= end && t.Amount < 0m).Sum(t => Math.Abs(t.Amount));

    private decimal SumTransactions(DateOnly start, DateOnly end) =>
        transactions.Where(t => t.Date >= start && t.Date <= end).Sum(t => t.Amount);

    private static DateOnly GetQuarterStart(DateOnly date) => new(date.Year, ((date.Month - 1) / 3) * 3 + 1, 1);

    private static DateOnly GetSameDayLastYear(DateOnly date)
    {
        try
        {
            return new DateOnly(date.Year - 1, date.Month, date.Day);
        }
        catch (ArgumentOutOfRangeException)
        {
            return new DateOnly(date.Year - 1, 2, 28);
        }
    }

    private static HeroDelta BuildHeroDelta(decimal current, decimal baseline)
    {
        var amount = current - baseline;
        decimal? percent = baseline != 0m ? amount / Math.Abs(baseline) * 100m : null;
        return new HeroDelta(amount, percent);
    }

    private IReadOnlyList<CashFlowHeroChip> GetHeroChips() =>
    [
        new("This Month", thisMonthDelta),
        new("This Quarter", thisQuarterDelta),
        new("Year to Date", ytdDelta),
        new("Trailing 12 Months", trailing12Delta)
    ];

    private decimal GetHeroSecondMetricTotal() => selectedHeroMetric == "income" ? trailingIncomeTotal : trailingSpendingTotal;

    private IReadOnlyList<T> FilterByRange<T>(List<T> items, Func<T, DateOnly> dateSelector, DateOnly latestDate)
    {
        if (selectedRangePreset == "all")
            return items;

        if (selectedRangePreset == "custom")
        {
            var customStart = DateOnly.FromDateTime(customStartDate);
            var customEnd = DateOnly.FromDateTime(customEndDate);
            return items.Where(item => dateSelector(item) >= customStart && dateSelector(item) <= customEnd).ToList();
        }

        if (selectedRangePreset == "ytd")
        {
            var startOfYear = new DateOnly(latestDate.Year, 1, 1);
            return items.Where(item => dateSelector(item) >= startOfYear && dateSelector(item) <= latestDate).ToList();
        }

        var months = selectedRangePreset switch
        {
            "3m" => 3,
            "6m" => 6,
            _ => 12
        };

        var threshold = latestDate.AddMonths(-months);
        return items.Where(item => dateSelector(item) >= threshold && dateSelector(item) <= latestDate).ToList();
    }

    private async Task CreateTransactionAsync()
    {
        isSubmitting = true;

        var result = await TransactionsApiClient.CreateAsync(
            createTransactionModel.Date,
            createTransactionModel.CounterpartyName,
            createTransactionModel.Amount,
            createTransactionModel.TransactionCategoryId,
            createTransactionModel.AccountId,
            createTransactionModel.Description);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

