        => matrixSnapshots.Count + (hasPendingMatrixEntry ? 1 : 0);

    private List<MatrixSnapshotColumn> BuildMatrixColumns()
    {
        var columns = matrixSnapshots
            .Select(snapshot => new MatrixSnapshotColumn(snapshot.Id, snapshot.Date, false))
            .ToList();

        if (hasPendingMatrixEntry)
            columns.Add(new MatrixSnapshotColumn(PendingMatrixSnapshotId, pendingMatrixEntryDate, true));

