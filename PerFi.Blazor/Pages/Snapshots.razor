@page "/snapshots/{Section?}"
@attribute [Authorize]
@using System.Globalization
@inject NavigationManager NavigationManager
@inject ISnapshotsApiClient SnapshotsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Net Worth</PageTitle>

<div class="networth-page">
    <header class="networth-hero">
        <div class="hero-top">
            <div class="hero-headline">
                <span class="hero-eyebrow">Net Worth</span>
                <strong class="hero-figure">@FormatCurrency(latestTotal)</strong>
                @if (matrixSnapshots.Count > 0)
                {
                    <span class="hero-asof">as of @matrixSnapshots[^1].Date.ToString("MMM d, yyyy")</span>
                }
            </div>

            <div class="hero-second-metric">
                <select class="form-select form-select-sm hero-group-select" @bind="selectedHeroGroupName" aria-label="Second net worth metric">
                    @foreach (var group in matrixGroups)
                    {
                        <option value="@group.AccountTypeGroupName">@group.AccountTypeGroupName</option>
                    }
                </select>
                <strong class="hero-figure hero-figure-secondary">@FormatCurrency(GetHeroSecondMetricTotal())</strong>
            </div>

            <div class="hero-sparkline" aria-hidden="true" @key="chartVersion">
                @if (allTimeTrendPoints.Count > 1)
                {
                    <ApexChart TItem="SnapshotTrendPoint" Height="64" Options="@CreateSparklineChartOptions()">
                        <ApexPointSeries TItem="SnapshotTrendPoint"
                                         Items="allTimeTrendPoints"
                                         Name="Net Worth"
                                         SeriesType="SeriesType.Area"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    </ApexChart>
                }
            </div>
        </div>

        <div class="hero-chips" aria-label="Net Worth highlights">
            @foreach (var chip in GetHeroChips())
            {
                <article class="hero-chip">
                    <span class="hero-chip-label">@chip.Label</span>
                    <div class="hero-chip-metric">
                        <span class="hero-chip-metric-name">Net Worth</span>
                        @if (chip.NetWorthDelta is not null)
                        {
                            <strong class="@GetAmountClass(chip.NetWorthDelta.Amount)">@FormatDeltaCurrency(chip.NetWorthDelta.Amount)</strong>
                            <span class="hero-chip-percent @GetAmountClass(chip.NetWorthDelta.Amount)">@FormatPercent(chip.NetWorthDelta.Percent)</span>
                        }
                        else
                        {
                            <strong class="amount-muted">&mdash;</strong>
                        }
                    </div>
                    <div class="hero-chip-metric">
                        <span class="hero-chip-metric-name">@selectedHeroGroupName</span>
                        @if (chip.GroupDelta is not null)
                        {
                            <strong class="@GetAmountClass(chip.GroupDelta.Amount)">@FormatDeltaCurrency(chip.GroupDelta.Amount)</strong>
                            <span class="hero-chip-percent @GetAmountClass(chip.GroupDelta.Amount)">@FormatPercent(chip.GroupDelta.Percent)</span>
                        }
                        else
                        {
                            <strong class="amount-muted">&mdash;</strong>
                        }
                    </div>
                </article>
            }
        </div>
    </header>

    <div class="networth-shell">
        <div class="networth-content">
            <LoadingState IsVisible="@isLoading" />

            @if (!isLoading)
            {
                @if (activeSection == "grid")
                {
                    <section class="matrix-panel">
                        <div class="section-header matrix-header">
                            <div>
                                <h2>Account Ledger</h2>
                                <p>Every net worth entry, account by account. Click a date to see its full breakdown.</p>
                            </div>
                            <div class="matrix-nav-actions">
                                @if (!isMatrixEditMode)
                                {
                                    <button class="btn btn-sm btn-primary" type="button" @onclick="StartNewMatrixEntry">New Entry</button>
                                    @if (matrixSnapshots.Count > 0)
                                    {
                                        <button class="btn btn-sm btn-primary" type="button" @onclick="EnterMatrixEditMode">Edit</button>
                                    }
                                }
                                else
                                {
                                    <span class="matrix-staged-chip @(HasPendingMatrixEdits ? string.Empty : "matrix-staged-chip-hidden")">@GetMatrixStagedChangesText()</span>
                                    <button class="btn btn-sm btn-primary" type="button" @onclick="SaveMatrixEditsAsync" disabled="@(isSubmitting || HasMatrixValidationErrors || !HasPendingMatrixEdits)">Save Changes</button>
                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelMatrixEditMode" disabled="@isSubmitting">Discard Changes</button>
                                }
                            </div>
                        </div>

                        @if (isMatrixEditMode && HasMatrixValidationErrors)
                        {
                            <div class="alert alert-warning matrix-validation-banner" role="alert">
                                Fix invalid cell values before saving table edits.
                            </div>
                        }

                        <EmptyState IsVisible="@(!isMatrixEditMode && matrixSnapshots.Count == 0)" Message="No net worth entries yet. Click New Entry to add your first one." />

                        @if (matrixSnapshots.Count > 0 || hasPendingMatrixEntry)
                        {
                            var visibleSnapshots = GetVisibleMatrixSnapshots();
                            <div class="matrix-wrap" id="ledger-scroll">
                                <table class="table table-sm snapshot-matrix">
                                    <thead>
                                        <tr>
                                            <th>Account</th>
                                            @foreach (var column in visibleSnapshots)
                                            {
                                                <th class="text-end @(column.IsDraft ? "new-entry-column-header" : "matrix-column-clickable")"
                                                    @onclick="() => OnMatrixColumnHeaderClicked(column)">
                                                    @if (column.IsDraft)
                                                    {
                                                        <input type="date" class="form-control form-control-sm text-end" value="@pendingMatrixEntryDate.ToString("yyyy-MM-dd")" @onchange="eventArgs => OnPendingMatrixEntryDateChanged(eventArgs.Value?.ToString())" @onclick:stopPropagation="true" />
                                                    }
                                                    else
                                                    {
                                                        <span>@column.Date.ToString("MMM dd, yyyy")</span>
                                                    }
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var group in matrixGroups)
                                        {
                                            <tr class="group-header-row">
                                                <th>@group.AccountTypeGroupName</th>
                                                @foreach (var column in visibleSnapshots)
                                                {
                                                    var groupTotal = GetGroupTotal(group, column.Id);
                                                    var groupDeltaDisplay = GetGroupDeltaDisplay(group, column.Id);
                                                    <th class="text-end @GetAmountClass(groupTotal)">
                                                        <div>@FormatCurrency(groupTotal)</div>
                                                        <div class="matrix-cell-delta @groupDeltaDisplay.CssClass">@groupDeltaDisplay.Text</div>
                                                    </th>
                                                }
                                            </tr>

                                            @foreach (var row in group.Rows)
                                            {
                                                <tr>
                                                    <th>
                                                        <div class="account-name">@row.AccountName</div>
                                                        <div class="account-meta">@row.InstitutionName</div>
                                                    </th>
                                                    @foreach (var column in visibleSnapshots)
                                                    {
                                                        <td class="@GetCellClass(column.Id, row.AccountId)">
                                                            @if (isMatrixEditMode)
                                                            {
                                                                <input class="form-control form-control-sm text-end matrix-cell-input @GetCellInputClass(column.Id, row.AccountId)"
                                                                       value="@GetCellInputValue(column.Id, row.AccountId)"
                                                                       @onchange='eventArgs => OnMatrixCellChanged(column.Id, row.AccountId, eventArgs.Value?.ToString())' />
                                                                @if (TryGetMatrixCellValidationError(column.Id, row.AccountId, out var validationError))
                                                                {
                                                                    <div class="matrix-cell-error">@validationError</div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                var displayedValue = GetDisplayedCellValue(column.Id, row.AccountId);
                                                                @if (displayedValue.HasValue)
                                                                {
                                                                    var deltaDisplay = GetCellDeltaDisplay(column.Id, row.AccountId);
                                                                    <div class="text-end @GetAmountClass(displayedValue.Value)">@FormatCurrency(displayedValue.Value)</div>
                                                                    <div class="text-end matrix-cell-delta @deltaDisplay.CssClass">@deltaDisplay.Text</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-end amount-muted">-</div>
                                                                }
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th>Total</th>
                                            @foreach (var column in visibleSnapshots)
                                            {
                                                var total = GetSnapshotTotal(column.Id);
                                                <th class="text-end @GetAmountClass(total)">@FormatCurrency(total)</th>
                                            }
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }

                        @if (selectedSnapshot is not null)
                        {
                            <SnapshotDetailPanel Snapshot="selectedSnapshot" OnClose="() => selectedSnapshot = null" OnDelete="HandleDeleteSnapshotAsync" />
                        }
                    </section>
                }

                @if (activeSection == "trends")
                {
                    <section class="panel range-panel">
                        <div class="section-header">
                            <h2>Trends</h2>
                            <p>@GetRangeLabel()</p>
                        </div>
                        <div class="filter-presets" role="toolbar" aria-label="Net Worth range presets">
                            <button class='@GetRangeClass("ytd")' @onclick='() => SetRangePreset("ytd")'>YTD</button>
                            <button class='@GetRangeClass("3m")' @onclick='() => SetRangePreset("3m")'>3M</button>
                            <button class='@GetRangeClass("6m")' @onclick='() => SetRangePreset("6m")'>6M</button>
                            <button class='@GetRangeClass("12m")' @onclick='() => SetRangePreset("12m")'>12M</button>
                            <button class='@GetRangeClass("all")' @onclick='() => SetRangePreset("all")'>All</button>
                            <button class='@GetRangeClass("custom")' @onclick="ToggleCustomRangeInputs">Custom</button>
                        </div>

                        @if (showCustomRangeInputs)
                        {
                            <div class="custom-range row g-2 align-items-end mt-2">
                                <div class="col-md-4">
                                    <label class="form-label" for="customStart">Start</label>
                                    <InputDate id="customStart" class="form-control" @bind-Value="customStartDate" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="customEnd">End</label>
                                    <InputDate id="customEnd" class="form-control" @bind-Value="customEndDate" />
                                </div>
                                <div class="col-md-4 d-flex gap-2">
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ApplyCustomRange">Apply</button>
                                </div>
                            </div>
                        }
                    </section>

                    <EmptyState IsVisible="@(filteredSnapshots.Count == 0)" Message="Add net worth entries to render trend charts." />

                    @if (filteredSnapshots.Count > 0)
                    {
                        var totalRangeDelta = GetTrendDelta(rangeTrendPoints);

                        <section class="chart-panel" @key="chartVersion">
                            <div class="section-header">
                                <h2>@GetSelectedRangeChartTitle()</h2>
                                @if (totalRangeDelta is not null)
                                {
                                    <p class="range-delta @GetAmountClass(totalRangeDelta.Amount)">@FormatDeltaCurrency(totalRangeDelta.Amount) (@FormatPercent(totalRangeDelta.Percent))</p>
                                }
                            </div>
                            <ApexChart TItem="SnapshotTrendPoint" Title="@($"Total Net Worth ({GetSelectedRangeChartLabel()})")" Height="420" Options="@CreateCurrencyChartOptions()">
                                <ApexPointSeries TItem="SnapshotTrendPoint"
                                                 Items="rangeTrendPoints"
                                                 Name="Net Worth"
                                                 SeriesType="SeriesType.Area"
                                                 XValue="point => point.Label"
                                                 YValue="point => point.Total" />
                            </ApexChart>
                        </section>

                        @foreach (var groupChart in accountTypeGroupCharts)
                        {
                            var groupRangeDelta = GetTrendDelta(groupChart.RangePoints);

                            <section class="chart-panel" @key="(groupChart.GroupName, chartVersion)">
                                <div class="section-header">
                                    <h2>@groupChart.GroupName (@GetSelectedRangeChartLabel())</h2>
                                    @if (groupRangeDelta is not null)
                                    {
                                        <p class="range-delta @GetAmountClass(groupRangeDelta.Amount)">@FormatDeltaCurrency(groupRangeDelta.Amount) (@FormatPercent(groupRangeDelta.Percent))</p>
                                    }
                                </div>
                                <ApexChart TItem="SnapshotTrendPoint" Title="@($"{groupChart.GroupName} ({GetSelectedRangeChartLabel()})")" Height="420" Options="@CreateCurrencyChartOptions()">
                                    <ApexPointSeries TItem="SnapshotTrendPoint"
                                                     Items="groupChart.RangePoints"
                                                     Name="@groupChart.GroupName"
                                                     SeriesType="SeriesType.Area"
                                                     XValue="point => point.Label"
                                                     YValue="point => point.Total" />
                                </ApexChart>
                            </section>
                        }
                    }
                }

                @if (activeSection == "milestones")
                {
                    <EmptyState IsVisible="@(milestoneSeries.Count == 0)" Message="Add net worth entries to see year and quarter milestones." />

                    @foreach (var series in milestoneSeries)
                    {
                        <section class="panel milestones-panel">
                            <div class="section-header">
                                <h2>@series.Name</h2>
                                <p>Net worth at the end of each year and quarter, using your actual entries (interpolated between the closest entries for closed periods).</p>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm align-middle milestones-table">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Period</th>
                                            <th class="text-end">@series.Name</th>
                                            <th class="text-end">Change</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var yearRow in series.YearRows)
                                        {
                                            var yearDelta = GetMilestoneDeltaDisplay(yearRow.EndTotal, yearRow.PriorYearEndTotal);
                                            <tr class="year-row" @onclick="() => ToggleMilestoneYear(series.Name, yearRow.Year)">
                                                <td><span class="expand-toggle @(IsMilestoneYearExpanded(series.Name, yearRow.Year) ? "expanded" : null)" aria-hidden="true">&#9656;</span></td>
                                                <td>@(yearRow.IsCurrentYear ? "Year to Date" : yearRow.Year.ToString(CultureInfo.InvariantCulture))</td>
                                                <td class="text-end @(yearRow.EndTotal.HasValue ? GetAmountClass(yearRow.EndTotal.Value) : "amount-muted")">
                                                    @(yearRow.EndTotal.HasValue ? FormatCurrency(yearRow.EndTotal.Value) : "-")
                                                </td>
                                                <td class="text-end @yearDelta.CssClass">@yearDelta.Text</td>
                                                <td><span class="@(yearRow.IsCurrentYear ? "badge-projected" : "badge-actual")">@(yearRow.IsCurrentYear ? "In Progress" : "Complete")</span></td>
                                            </tr>

                                            @if (IsMilestoneYearExpanded(series.Name, yearRow.Year))
                                            {
                                                @foreach (var quarter in yearRow.Quarters)
                                                {
                                                    var quarterDelta = GetMilestoneDeltaDisplay(quarter.EndTotal, quarter.PriorTotal);
                                                    <tr class="quarter-row @(quarter.DetailSnapshotId is not null ? "quarter-row-clickable" : null)" @onclick="() => OnMilestoneQuarterClicked(quarter)">
                                                        <td></td>
                                                        <td>Q@(quarter.Quarter)</td>
                                                        @if (quarter.EndTotal.HasValue)
                                                        {
                                                            <td class="text-end @GetAmountClass(quarter.EndTotal.Value)">@FormatCurrency(quarter.EndTotal.Value)@(quarter.IsInterpolated ? "*" : null)</td>
                                                            <td class="text-end @quarterDelta.CssClass">@quarterDelta.Text</td>
                                                            <td></td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-end amount-muted" colspan="3">No entry</td>
                                                        }
                                                    </tr>
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (series.YearRows.SelectMany(y => y.Quarters).Any(q => q.IsInterpolated))
                            {
                                <p class="milestones-footnote">* interpolated between the two closest entries</p>
                            }
                        </section>
                    }

                    @if (selectedSnapshot is not null)
                    {
                        <SnapshotDetailPanel Snapshot="selectedSnapshot" OnClose="() => selectedSnapshot = null" OnDelete="HandleDeleteSnapshotAsync" />
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    private readonly List<AccountResponse> accounts = [];
    private readonly List<FinanceSnapshotResponse> snapshots = [];
    private readonly List<FinanceSnapshotResponse> matrixSnapshots = [];
    private readonly List<FinanceSnapshotResponse> filteredSnapshots = [];
    private readonly List<AccountMatrixGroup> matrixGroups = [];
    private readonly List<SnapshotTrendPoint> rangeTrendPoints = [];
    private readonly List<SnapshotTrendPoint> allTimeTrendPoints = [];
    private readonly List<AccountTypeGroupTrendChart> accountTypeGroupCharts = [];
    private readonly List<MilestoneSeries> milestoneSeries = [];
    private readonly HashSet<(string SeriesName, int Year)> expandedMilestoneYears = [];
    private readonly Dictionary<int, decimal> totalsBySnapshotId = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), decimal> matrixCellEdits = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), string> matrixCellInputOverrides = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), string> matrixCellValidationErrors = [];
    private FinanceSnapshotResponse? selectedSnapshot;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool hasPendingMatrixEntry;
    private bool isMatrixEditMode;
    private bool showCustomRangeInputs;
    private bool shouldScrollLedgerToEnd;
    private DateOnly pendingMatrixEntryDate = DateOnly.FromDateTime(DateTime.Today);
    private string activeSection = "grid";
    private string selectedHeroGroupName = string.Empty;
    private string selectedRangePreset = "ytd";
    private DateTime customStartDate = new(DateTime.Today.Year, 1, 1);
    private DateTime customEndDate = DateTime.Today;
    private decimal latestTotal;
    private int chartVersion;
    private HeroDelta? sinceLastEntryDelta;
    private HeroDelta? ytdDelta;
    private HeroDelta? oneYearDelta;
    private int? sinceLastEntryBaselineSnapshotId;
    private int? ytdBaselineSnapshotId;
    private int? oneYearBaselineSnapshotId;
    private const int PendingMatrixSnapshotId = -1;

    private bool HasPendingMatrixEdits => matrixCellEdits.Count > 0;
    private bool HasMatrixValidationErrors => matrixCellValidationErrors.Count > 0;

    [Parameter]
    public string? Section { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadListAsync();
    }

    protected override void OnParametersSet() => activeSection = Section ?? "grid";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldScrollLedgerToEnd)
            return;

        shouldScrollLedgerToEnd = false;
        await JSRuntime.InvokeVoidAsync("perfiNetWorth.scrollToRight", "ledger-scroll");
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task LoadListAsync()
    {
        isLoading = true;

        try
        {
            snapshots.Clear();
            snapshots.AddRange(await SnapshotsApiClient.GetAllAsync());
            matrixCellEdits.Clear();
            matrixCellInputOverrides.Clear();
            matrixCellValidationErrors.Clear();
            isMatrixEditMode = false;
            RebuildSnapshotView();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        try
        {
            selectedSnapshot = await SnapshotsApiClient.GetByIdAsync(id);

            if (selectedSnapshot is null)
                ToastService.ShowError($"Net worth entry #{id} was not found.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private void StartNewMatrixEntry()
    {
        hasPendingMatrixEntry = true;
        isMatrixEditMode = true;
        pendingMatrixEntryDate = DateOnly.FromDateTime(DateTime.Today);
        RemoveWhere(matrixCellValidationErrors, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellInputOverrides, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellEdits, key => key.SnapshotId == PendingMatrixSnapshotId);
        shouldScrollLedgerToEnd = true;
    }

    private async Task OnMatrixColumnHeaderClicked(MatrixSnapshotColumn column)
    {
        if (column.IsDraft)
            return;

        await LoadDetailAsync(column.Id);
    }

    private async Task OnMilestoneQuarterClicked(QuarterPeriod quarter)
    {
        if (quarter.DetailSnapshotId is not { } id)
            return;

        await LoadDetailAsync(id);
    }

    private async Task HandleDeleteSnapshotAsync(int id)
    {
        await DeleteAsync(id);
    }

    private async Task DeleteAsync(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete net worth entry from your timeline? (ID {id})");
        if (!confirmed)
            return;

        var result = await SnapshotsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        if (selectedSnapshot?.Id == id)
            selectedSnapshot = null;

        ToastService.ShowSuccess("Net worth entry deleted.");

        await LoadListAsync();
    }

    private void SetRangePreset(string preset)
    {
        selectedRangePreset = preset;
        showCustomRangeInputs = false;
        RebuildSnapshotView();
    }

    private void ToggleCustomRangeInputs()
    {
        showCustomRangeInputs = !showCustomRangeInputs;
    }

    private void ApplyCustomRange()
    {
        if (customEndDate < customStartDate)
            (customStartDate, customEndDate) = (customEndDate, customStartDate);

        selectedRangePreset = "custom";
        showCustomRangeInputs = false;
        RebuildSnapshotView();
    }

    private void EnterMatrixEditMode()
    {
        isMatrixEditMode = true;
    }

    private void CancelMatrixEditMode()
    {
        hasPendingMatrixEntry = false;
        RemoveWhere(matrixCellEdits, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellInputOverrides, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellValidationErrors, key => key.SnapshotId == PendingMatrixSnapshotId);
        DiscardMatrixEdits();
        isMatrixEditMode = false;
    }

    private string GetRangeLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => $"YTD ({new DateTime(customEndDate.Year, 1, 1):MMM d} - {customEndDate:MMM d})",
            "3m" => "Last 3 months",
            "6m" => "Last 6 months",
            "12m" => "Last 12 months",
            "all" => "All time",
            "custom" => $"{customStartDate:MMM d, yyyy} - {customEndDate:MMM d, yyyy}",
            _ => "Custom"
        };
    }

    private string GetSelectedRangeChartLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "3m" => "Last 3 Months",
            "6m" => "Last 6 Months",
            "12m" => "Last 12 Months",
            "all" => "All Time",
            "custom" => $"Custom: {customStartDate:MMM d, yyyy} to {customEndDate:MMM d, yyyy}",
            _ => "Selected Range"
        };
    }

    private string GetSelectedRangeChartTitle()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "all" => "All Time",
            _ => GetSelectedRangeChartLabel()
        };
    }

    private string GetRangeClass(string preset)
    {
        return selectedRangePreset == preset
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
    }

    private void RebuildSnapshotView()
    {
        chartVersion++;
        matrixSnapshots.Clear();
        filteredSnapshots.Clear();
        matrixGroups.Clear();
        rangeTrendPoints.Clear();
        allTimeTrendPoints.Clear();
        accountTypeGroupCharts.Clear();
        totalsBySnapshotId.Clear();
        milestoneSeries.Clear();

        var orderedSnapshots = snapshots
            .OrderBy(s => s.Date)
            .ToList();

        matrixSnapshots.AddRange(orderedSnapshots);
        shouldScrollLedgerToEnd = true;

        if (orderedSnapshots.Count == 0)
        {
            latestTotal = 0m;
            ResetHeroDeltas();
            return;
        }

        foreach (var snapshot in orderedSnapshots)
        {
            totalsBySnapshotId[snapshot.Id] = snapshot.AccountBalances.Sum(b => b.Balance);
            allTimeTrendPoints.Add(new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd, yyyy"),
                totalsBySnapshotId[snapshot.Id]));
        }

        latestTotal = totalsBySnapshotId[orderedSnapshots[^1].Id];
        ComputeHeroDeltas(orderedSnapshots);

        var visibleRangeSnapshots = FilterSnapshotsBySelectedRange(orderedSnapshots);
        filteredSnapshots.AddRange(visibleRangeSnapshots);

        foreach (var snapshot in filteredSnapshots)
        {
            rangeTrendPoints.Add(new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd, yyyy"),
                totalsBySnapshotId[snapshot.Id]));
        }

        var accountLookup = accounts.ToDictionary(a => a.Id);

        var rows = orderedSnapshots
            .SelectMany(s => s.AccountBalances)
            .GroupBy(b => b.Account.Id)
            .Select(group =>
            {
                var sourceAccount = accountLookup.TryGetValue(group.Key, out var knownAccount)
                    ? knownAccount
                    : group.First().Account;

                var bySnapshot = group
                    .GroupBy(b => b.SnapshotId)
                    .ToDictionary(item => item.Key, item => item.Last().Balance);

                return new AccountMatrixRow(
                    sourceAccount.Id,
                    sourceAccount.Name,
                    sourceAccount.DisplayOrderInGroup,
                    sourceAccount.Institution.Name,
                    sourceAccount.Type.Id,
                    sourceAccount.Type.Name,
                    sourceAccount.Type.DisplayOrderInGroup,
                    sourceAccount.Type.Group.Id,
                    sourceAccount.Type.Group.Name,
                    sourceAccount.Type.Group.DisplayOrder,
                    bySnapshot);
            })
            .OrderBy(row => row.AccountTypeGroupDisplayOrder)
            .ThenBy(row => row.AccountTypeGroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountTypeGroupId)
            .ThenBy(row => row.AccountTypeDisplayOrder)
            .ThenBy(row => row.AccountTypeName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountTypeId)
            .ThenBy(row => row.AccountDisplayOrder)
            .ThenBy(row => row.AccountName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountId)
            .ToList();

        var groupedRows = rows
            .GroupBy(row => new
            {
                row.AccountTypeGroupId,
                row.AccountTypeGroupName,
                row.AccountTypeGroupDisplayOrder
            })
            .OrderBy(group => group.Key.AccountTypeGroupDisplayOrder)
            .ThenBy(group => group.Key.AccountTypeGroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(group => group.Key.AccountTypeGroupId)
            .Select(group => new AccountMatrixGroup(group.Key.AccountTypeGroupName, [.. group]))
            .ToList();

        matrixGroups.AddRange(groupedRows);

        var groupNames = matrixGroups
            .Select(group => group.AccountTypeGroupName)
            .Distinct()
            .ToList();

        if (!groupNames.Contains(selectedHeroGroupName, StringComparer.OrdinalIgnoreCase))
        {
            selectedHeroGroupName = groupNames.FirstOrDefault(name => string.Equals(name, "Investments", StringComparison.OrdinalIgnoreCase))
                ?? groupNames.OrderBy(name => name, StringComparer.OrdinalIgnoreCase).FirstOrDefault()
                ?? string.Empty;
        }

        foreach (var groupName in groupNames)
        {
            var rangePoints = BuildGroupTrendPoints(filteredSnapshots, groupName);
            var allTimePoints = BuildGroupTrendPoints(orderedSnapshots, groupName);
            accountTypeGroupCharts.Add(new AccountTypeGroupTrendChart(groupName, rangePoints, allTimePoints));
        }

        milestoneSeries.Add(BuildMilestoneSeries("Net Worth", orderedSnapshots, s => s.AccountBalances.Sum(b => b.Balance)));
        foreach (var groupName in groupNames)
        {
            milestoneSeries.Add(BuildMilestoneSeries(
                groupName,
                orderedSnapshots,
                s => s.AccountBalances
                    .Where(b => string.Equals(b.Account.Type.Group.Name, groupName, StringComparison.OrdinalIgnoreCase))
                    .Sum(b => b.Balance)));
        }

        foreach (var series in milestoneSeries)
        {
            if (series.YearRows.Count > 0 && !series.YearRows.Any(row => expandedMilestoneYears.Contains((series.Name, row.Year))))
                expandedMilestoneYears.Add((series.Name, series.YearRows[0].Year));
        }
    }

    private IReadOnlyList<FinanceSnapshotResponse> FilterSnapshotsBySelectedRange(List<FinanceSnapshotResponse> orderedSnapshots)
    {
        if (selectedRangePreset == "all")
            return orderedSnapshots;

        if (selectedRangePreset == "custom")
        {
            var customStart = DateOnly.FromDateTime(customStartDate);
            var customEnd = DateOnly.FromDateTime(customEndDate);

            return orderedSnapshots
                .Where(s => s.Date >= customStart && s.Date <= customEnd)
                .ToList();
        }

        if (selectedRangePreset == "ytd")
        {
            var latestDate = orderedSnapshots[^1].Date;
            var startOfYear = new DateOnly(latestDate.Year, 1, 1);

            return orderedSnapshots
                .Where(s => s.Date >= startOfYear && s.Date <= latestDate)
                .ToList();
        }

        var months = selectedRangePreset switch
        {
            "3m" => 3,
            "6m" => 6,
            _ => 12
        };

        var maxDate = orderedSnapshots[^1].Date;
        var threshold = maxDate.AddMonths(-months);

        return orderedSnapshots
            .Where(s => s.Date >= threshold)
            .ToList();
    }

    private void ComputeHeroDeltas(List<FinanceSnapshotResponse> orderedSnapshots)
    {
        var latest = orderedSnapshots[^1];
        var latestValue = totalsBySnapshotId[latest.Id];

        var previous = orderedSnapshots.Count > 1 ? orderedSnapshots[^2] : null;
        sinceLastEntryBaselineSnapshotId = previous?.Id;
        sinceLastEntryDelta = previous is not null
            ? BuildHeroDelta(latestValue, totalsBySnapshotId[previous.Id])
            : null;

        var yearStart = new DateOnly(latest.Date.Year, 1, 1);
        var ytdBaseline = orderedSnapshots.LastOrDefault(s => s.Date < yearStart);
        ytdBaselineSnapshotId = ytdBaseline?.Id;
        ytdDelta = ytdBaseline is not null
            ? BuildHeroDelta(latestValue, totalsBySnapshotId[ytdBaseline.Id])
            : null;

        var oneYearThreshold = latest.Date.AddYears(-1);
        var oneYearBaseline = orderedSnapshots.LastOrDefault(s => s.Date <= oneYearThreshold);
        oneYearBaselineSnapshotId = oneYearBaseline?.Id;
        oneYearDelta = oneYearBaseline is not null
            ? BuildHeroDelta(latestValue, totalsBySnapshotId[oneYearBaseline.Id])
            : null;
    }

    private void ResetHeroDeltas()
    {
        sinceLastEntryDelta = null;
        ytdDelta = null;
        oneYearDelta = null;
        sinceLastEntryBaselineSnapshotId = null;
        ytdBaselineSnapshotId = null;
        oneYearBaselineSnapshotId = null;
    }

    private static HeroDelta BuildHeroDelta(decimal current, decimal baseline)
    {
        var amount = current - baseline;
        decimal? percent = baseline != 0m ? amount / Math.Abs(baseline) * 100m : null;
        return new HeroDelta(amount, percent);
    }

    private IReadOnlyList<HeroChip> GetHeroChips()
    {
        return
        [
            new HeroChip("Since Last Entry", sinceLastEntryDelta, GetGroupHeroDelta(sinceLastEntryBaselineSnapshotId)),
            new HeroChip("Year to Date", ytdDelta, GetGroupHeroDelta(ytdBaselineSnapshotId)),
            new HeroChip("1 Year", oneYearDelta, GetGroupHeroDelta(oneYearBaselineSnapshotId))
        ];
    }

    private decimal GetHeroSecondMetricTotal()
    {
        if (matrixSnapshots.Count == 0)
            return 0m;

        var group = matrixGroups.FirstOrDefault(g => g.AccountTypeGroupName == selectedHeroGroupName);
        return group is null ? 0m : GetGroupTotal(group, matrixSnapshots[^1].Id);
    }

    private HeroDelta? GetGroupHeroDelta(int? baselineSnapshotId)
    {
        if (baselineSnapshotId is null || matrixSnapshots.Count == 0)
            return null;

        var group = matrixGroups.FirstOrDefault(g => g.AccountTypeGroupName == selectedHeroGroupName);
        if (group is null)
            return null;

        var latestValue = GetGroupTotal(group, matrixSnapshots[^1].Id);
        var baselineValue = GetGroupTotal(group, baselineSnapshotId.Value);
        return BuildHeroDelta(latestValue, baselineValue);
    }

    private static HeroDelta? GetTrendDelta(IReadOnlyList<SnapshotTrendPoint> points)
    {
        if (points.Count < 2)
            return null;

        return BuildHeroDelta(points[^1].Total, points[0].Total);
    }

    private static MilestoneSeries BuildMilestoneSeries(string name, List<FinanceSnapshotResponse> orderedSnapshots, Func<FinanceSnapshotResponse, decimal> valueSelector)
    {
        var points = orderedSnapshots
            .Select(s => new SeriesPoint(s.Date, s.Id, valueSelector(s)))
            .ToList();

        var first = orderedSnapshots[0].Date;
        var last = orderedSnapshots[^1].Date;
        var (year, quarter) = (first.Year, (first.Month - 1) / 3 + 1);
        var (lastYear, lastQuarter) = (last.Year, (last.Month - 1) / 3 + 1);

        var quarterPeriods = new List<QuarterPeriod>();

        while (year < lastYear || (year == lastYear && quarter <= lastQuarter))
        {
            var quarterEnd = GetQuarterEndDate(year, quarter);
            var value = ComputePeriodValue(points, quarterEnd);
            var priorTotal = quarterPeriods.Count > 0 ? quarterPeriods[^1].EndTotal : null;
            quarterPeriods.Add(new QuarterPeriod(year, quarter, value.Total, priorTotal, value.DetailSnapshotId, value.IsInterpolated));

            quarter++;
            if (quarter > 4)
            {
                quarter = 1;
                year++;
            }
        }

        var yearRows = new List<MilestoneYearRow>();
        var currentYear = DateTime.Today.Year;
        decimal? priorYearEnd = null;

        foreach (var yearGroup in quarterPeriods.GroupBy(q => q.Year).OrderBy(g => g.Key))
        {
            var yearEnd = new DateOnly(yearGroup.Key, 12, 31);
            var yearValue = ComputePeriodValue(points, yearEnd);
            var quartersDescending = yearGroup.OrderByDescending(q => q.Quarter).ToList();

            yearRows.Add(new MilestoneYearRow(
                yearGroup.Key,
                yearGroup.Key == currentYear,
                yearValue.Total,
                priorYearEnd,
                yearValue.DetailSnapshotId,
                yearValue.IsInterpolated,
                quartersDescending));

            if (yearValue.Total is { } endTotal)
                priorYearEnd = endTotal;
        }

        yearRows.Reverse();
        return new MilestoneSeries(name, yearRows);
    }

    private static DateOnly GetQuarterEndDate(int year, int quarter)
    {
        var endMonth = quarter * 3;
        return new DateOnly(year, endMonth, DateTime.DaysInMonth(year, endMonth));
    }

    // Finds the two closest snapshot points bracketing the target date and linearly interpolates between them;
    // falls back to carrying forward the last known value when there's nothing past the target date yet.
    private static PeriodValue ComputePeriodValue(List<SeriesPoint> points, DateOnly target)
    {
        SeriesPoint? before = null;
        SeriesPoint? after = null;

        foreach (var point in points)
        {
            if (point.Date <= target)
            {
                before = point;
                continue;
            }

            after = point;
            break;
        }

        if (before is not { } beforePoint)
            return new PeriodValue(null, null, false);

        if (beforePoint.Date == target || after is null)
            return new PeriodValue(beforePoint.Total, beforePoint.Id, false);

        var afterPoint = after.Value;
        var totalDays = afterPoint.Date.DayNumber - beforePoint.Date.DayNumber;
        var elapsedDays = target.DayNumber - beforePoint.Date.DayNumber;
        var fraction = totalDays == 0 ? 0m : (decimal)elapsedDays / totalDays;
        var interpolated = beforePoint.Total + fraction * (afterPoint.Total - beforePoint.Total);

        return new PeriodValue(interpolated, beforePoint.Id, true);
    }

    private void ToggleMilestoneYear(string seriesName, int year)
    {
        var key = (seriesName, year);
        if (!expandedMilestoneYears.Add(key))
            expandedMilestoneYears.Remove(key);
    }

