@page "/snapshots"
@attribute [Authorize]
@inject ISnapshotsApiClient SnapshotsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Net Worth</PageTitle>

<div class="snapshots-page">
    <header class="page-hero">
        <div>
            <h1>Net Worth</h1>
            <p class="hero-copy">Track every account over time in one central view.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadListAsync" disabled="@isLoading">Refresh</button>
            <button class="btn btn-primary" type="button" @onclick="StartCreate">New Entry</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="filter-panel">
        <div class="filter-presets" role="toolbar" aria-label="Net Worth range presets">
            <button class='@GetRangeClass("3m")' @onclick='() => SetRangePreset("3m")'>3M</button>
            <button class='@GetRangeClass("6m")' @onclick='() => SetRangePreset("6m")'>6M</button>
            <button class='@GetRangeClass("12m")' @onclick='() => SetRangePreset("12m")'>12M</button>
            <button class='@GetRangeClass("all")' @onclick='() => SetRangePreset("all")'>All</button>
        </div>
        <div class="custom-range row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="customStart">Start</label>
                <InputDate id="customStart" class="form-control" @bind-Value="customStartDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="customEnd">End</label>
                <InputDate id="customEnd" class="form-control" @bind-Value="customEndDate" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyCustomRange">Apply Custom Range</button>
            </div>
        </div>
    </section>

    <section class="summary-grid" aria-label="Net Worth highlights">
        <article class="summary-card">
            <span class="summary-label">Latest Net Worth</span>
            <strong>@FormatCurrency(latestTotal)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Previous Entry</span>
            <strong>@FormatCurrency(previousTotal)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Change</span>
            <strong class="@(latestTotal - previousTotal >= 0 ? "positive" : "negative")">
                @FormatCurrency(latestTotal - previousTotal)
            </strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Active Accounts</span>
            <strong>@activeAccountCount</strong>
        </article>
    </section>

    <section class="chart-panel">
        <div class="section-header">
            <h2>Net Worth Trend</h2>
            <p>Visual trend for the currently selected date range.</p>
        </div>

        <EmptyState IsVisible="@(filteredSnapshots.Count == 0)" Message="Add net worth entries to render this trend chart." />

        @if (filteredSnapshots.Count > 0)
        {
            <ApexChart TItem="SnapshotTrendPoint" Title="Net Worth Over Time" Height="320">
                <ApexPointSeries TItem="SnapshotTrendPoint"
                                 Items="trendPoints"
                                 Name="Net Worth"
                                 SeriesType="SeriesType.Line"
                                 XValue="point => point.Label"
                                 YValue="point => point.Total" />
            </ApexChart>
        }
    </section>

    <section class="chart-grid">
        <section class="chart-panel">
            <div class="section-header">
                <h2>Institution Trend</h2>
                <p>Stacked view of balances by institution over time.</p>
            </div>

            <EmptyState IsVisible="@(institutionTrendNames.Count == 0)" Message="No institution data available in this range." />

            @if (institutionTrendNames.Count > 0)
            {
                <ApexChart TItem="InstitutionTrendPoint" Title="Institution Trend" Height="320">
                    @foreach (var institutionName in institutionTrendNames)
                    {
                        <ApexPointSeries TItem="InstitutionTrendPoint"
                                         Items="GetInstitutionTrend(institutionName)"
                                         Name="@institutionName"
                                         SeriesType="SeriesType.Bar"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    }
                </ApexChart>
            }
        </section>

        <section class="chart-panel">
            <div class="section-header">
                <h2>Latest Breakdown</h2>
                <p>Balance distribution for the most recent entry in the selected range.</p>
            </div>

            <EmptyState IsVisible="@(latestCompositionPoints.Count == 0)" Message="No latest net worth breakdown to display." />

            @if (latestCompositionPoints.Count > 0)
            {
                <ApexChart TItem="SnapshotCompositionPoint" Title="Latest Net Worth Composition" Height="320">
                    <ApexPointSeries TItem="SnapshotCompositionPoint"
                                     Items="latestCompositionPoints"
                                     Name="Balance"
                                     SeriesType="SeriesType.Bar"
                                     XValue="point => point.Label"
                                     YValue="point => point.Total" />
                </ApexChart>
            }
        </section>
    </section>

    <section class="matrix-panel">
        <div class="section-header">
            <h2>Net Worth Matrix</h2>
            <p>Rows are accounts, columns are entry dates.</p>
        </div>

        <LoadingState IsVisible="@isLoading" />
        <EmptyState IsVisible="@(!isLoading && filteredSnapshots.Count == 0)" Message="No net worth entries in this period." />

        @if (!isLoading && filteredSnapshots.Count > 0)
        {
            <div class="table-responsive matrix-wrap">
                <table class="table table-sm snapshot-matrix">
                    <thead>
                        <tr>
                            <th>Account</th>
                            @foreach (var snapshot in filteredSnapshots)
                            {
                                <th class="text-end">@snapshot.Date.ToString("MMM dd, yyyy")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in matrixRows)
                        {
                            <tr>
                                <th>
                                    <div class="account-name">@row.AccountName</div>
                                    <div class="account-meta">@row.InstitutionName</div>
                                </th>
                                @foreach (var snapshot in filteredSnapshots)
                                {
                                    if (row.BalancesBySnapshotId.TryGetValue(snapshot.Id, out var amount))
                                    {
                                        <td class="text-end">@FormatCurrency(amount)</td>
                                    }
                                    else
                                    {
                                        <td class="text-end text-muted">-</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            @foreach (var snapshot in filteredSnapshots)
                            {
                                <th class="text-end">@FormatCurrency(GetSnapshotTotal(snapshot.Id))</th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="timeline-panel">
        <div class="section-header">
            <h2>History</h2>
            <p>Quickly open, edit, or remove a specific entry.</p>
        </div>

        <EmptyState IsVisible="@(!isLoading && filteredSnapshots.Count == 0)" Message="Create your first entry to begin tracking progress." />

        @if (filteredSnapshots.Count > 0)
        {
            <div class="timeline-grid">
                @foreach (var snapshot in filteredSnapshots.OrderByDescending(s => s.Date))
                {
                    <article class="timeline-card @(selectedSnapshot?.Id == snapshot.Id ? "selected" : null)">
                        <div>
                            <h3>@snapshot.Date.ToString("MMM dd, yyyy")</h3>
                            <p>@snapshot.AccountBalances.Count account entries</p>
                            <strong>@FormatCurrency(GetSnapshotTotal(snapshot.Id))</strong>
                        </div>
                        <div class="timeline-actions">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(snapshot.Id)">Open</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditAsync(snapshot.Id)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(snapshot.Id)">Delete</button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (showComposer)
    {
        <section class="composer-panel">
            <div class="section-header">
                <h2>@(editModel is null ? "Record Net Worth" : "Edit Net Worth Entry")</h2>
                <p>@(editModel is null ? "Capture today’s balances in account order." : $"Updating entry #{editModel.Id}.")</p>
            </div>

            @if (editModel is null)
            {
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge text-bg-secondary">Date locked to today</span>
                    <span>@DateTime.Today.ToString("MMMM dd, yyyy")</span>
                </div>

                <div class="composer-summary mb-3">
                    <div>
                        <strong>@createModel.Balances.Count accounts</strong>
                        <div class="small text-muted">Rows stay in the same order every week.</div>
                    </div>
                    <div class="small text-muted">Negative balances are expected for credit cards and loans.</div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Account</th>
                                <th>Institution</th>
                                <th>Type</th>
                                <th>Group</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < createModel.Balances.Count; i++)
                            {
                                var balance = createModel.Balances[i];
                                <tr>
                                    <td>@balance.AccountName</td>
                                    <td>@balance.InstitutionName</td>
                                    <td>@balance.AccountTypeName</td>
                                    <td>@balance.AccountTypeGroupName</td>
                                    <td class="text-end" style="min-width: 12rem;">
                                        <InputNumber class="form-control text-end" @bind-Value="balance.Balance" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-primary" type="button" @onclick="CreateAsync" disabled="@isSubmitting">Save Net Worth</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseComposer">Close</button>
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="editSnapshotDate">Entry Date</label>
                        <InputDate id="editSnapshotDate" class="form-control" @bind-Value="editModel.SnapshotDate" />
                    </div>
                </div>

                @for (var i = 0; i < editModel.Balances.Count; i++)
                {
                    var balance = editModel.Balances[i];
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Account</label>
                            <InputSelect class="form-select" @bind-Value="balance.AccountId">
                                <option value="0">Select account</option>
                                @foreach (var account in accounts)
                                {
                                    <option value="@account.Id">@account.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Balance</label>
                            <InputNumber class="form-control" @bind-Value="balance.Balance" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-danger" type="button" @onclick="() => RemoveEditBalanceRow(i)" disabled="@(editModel.Balances.Count == 1)">Remove</button>
                        </div>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-outline-secondary" type="button" @onclick="AddEditBalanceRow">Add Row</button>
                    <button class="btn btn-primary" type="button" @onclick="UpdateAsync" disabled="@isSubmitting">Save Changes</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                </div>
            }
        </section>
    }

    @if (selectedSnapshot is not null)
    {
        <section class="detail-panel">
            <div class="section-header">
                <h2>Net Worth Entry Detail</h2>
                <p>@selectedSnapshot.Date.ToString("MMMM dd, yyyy")</p>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Institution</th>
                            <th>Type</th>
                            <th>Group</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var balance in selectedSnapshot.AccountBalances.OrderBy(b => b.Account.Name))
                        {
                            <tr>
                                <td>@balance.Account.Name</td>
                                <td>@balance.Account.Institution.Name</td>
                                <td>@balance.Account.Type.Name</td>
                                <td>@balance.Account.Type.Group.Name</td>
                                <td class="text-end">@FormatCurrency(balance.Balance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private readonly CreateSnapshotModel createModel = new();
    private readonly List<AccountResponse> accounts = [];
    private readonly List<FinanceSnapshotResponse> snapshots = [];
    private readonly List<FinanceSnapshotResponse> filteredSnapshots = [];
    private readonly List<AccountMatrixRow> matrixRows = [];
    private readonly List<SnapshotTrendPoint> trendPoints = [];
    private readonly List<InstitutionTrendPoint> institutionTrendPoints = [];
    private readonly List<string> institutionTrendNames = [];
    private readonly List<SnapshotCompositionPoint> latestCompositionPoints = [];
    private readonly Dictionary<int, decimal> totalsBySnapshotId = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private FinanceSnapshotResponse? selectedSnapshot;
    private EditSnapshotModel? editModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showComposer;
    private string? errorMessage;
    private string? successMessage;
    private string selectedRangePreset = "12m";
    private DateTime customStartDate = DateTime.Today.AddMonths(-6);
    private DateTime customEndDate = DateTime.Today;
    private decimal latestTotal;
    private decimal previousTotal;
    private int activeAccountCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadListAsync();
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            snapshots.Clear();
            snapshots.AddRange(await SnapshotsApiClient.GetAllAsync());
            RebuildSnapshotView();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        if (createModel.Balances.Any(b => !b.Balance.HasValue))
        {
            isSubmitting = false;
            errorMessage = "Enter a balance for every account before saving.";
            return;
        }

        var map = BuildBalanceMap(createModel.Balances);
        if (map.Count == 0)
        {
            isSubmitting = false;
            errorMessage = "Add at least one account balance before saving an entry.";
            return;
        }

        var result = await SnapshotsApiClient.CreateAsync(
            DateOnly.FromDateTime(DateTime.Today),
            map);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.Reset(accounts);
        showComposer = false;
        successMessage = "Net worth entry saved.";
        await LoadListAsync();
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedSnapshot = await SnapshotsApiClient.GetByIdAsync(id);

            if (selectedSnapshot is null)
                errorMessage = $"Net worth entry #{id} was not found.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task StartEditAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var snapshot = await SnapshotsApiClient.GetByIdAsync(id);
        if (snapshot is null)
        {
                errorMessage = $"Net worth entry #{id} was not found.";
            return;
        }

        selectedSnapshot = snapshot;
        editModel = EditSnapshotModel.From(snapshot);
        showComposer = true;
    }

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = null;
        createModel.Reset(accounts);
        showComposer = true;
    }

    private void CloseComposer()
    {
        showComposer = false;
        editModel = null;
    }

    private void CancelEdit() => CloseComposer();

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var map = BuildBalanceMap(editModel.Balances);
        if (map.Count == 0)
        {
            isSubmitting = false;
            errorMessage = "Add at least one account balance before saving changes.";
            return;
        }

        var result = await SnapshotsApiClient.UpdateAsync(
            editModel.Id,
            DateOnly.FromDateTime(editModel.SnapshotDate),
            map);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        var updatedSnapshotId = editModel.Id;
        editModel = null;
        showComposer = false;
        successMessage = "Net worth entry updated.";
        await LoadListAsync();
        await LoadDetailAsync(updatedSnapshotId);
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete net worth entry from your timeline? (ID {id})");
        if (!confirmed)
            return;

        var result = await SnapshotsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedSnapshot?.Id == id)
            selectedSnapshot = null;

        if (editModel?.Id == id)
            editModel = null;

        successMessage = "Net worth entry deleted.";

        await LoadListAsync();
    }

    private void SetRangePreset(string preset)
    {
        selectedRangePreset = preset;
        RebuildSnapshotView();
    }

    private void ApplyCustomRange()
    {
        if (customEndDate < customStartDate)
            (customStartDate, customEndDate) = (customEndDate, customStartDate);

        selectedRangePreset = "custom";
        RebuildSnapshotView();
    }

    private string GetRangeClass(string preset)
    {
        return selectedRangePreset == preset
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
    }

    private void RebuildSnapshotView()
    {
        filteredSnapshots.Clear();
        matrixRows.Clear();
        trendPoints.Clear();
        institutionTrendPoints.Clear();
        institutionTrendNames.Clear();
        latestCompositionPoints.Clear();
        totalsBySnapshotId.Clear();

        var orderedSnapshots = snapshots
            .OrderBy(s => s.Date)
            .ToList();

        if (orderedSnapshots.Count == 0)
        {
            latestTotal = 0m;
            previousTotal = 0m;
            activeAccountCount = 0;
            return;
        }

        var visibleSnapshots = FilterSnapshotsBySelectedRange(orderedSnapshots);
        filteredSnapshots.AddRange(visibleSnapshots);

        foreach (var snapshot in filteredSnapshots)
        {
            totalsBySnapshotId[snapshot.Id] = snapshot.AccountBalances.Sum(b => b.Balance);
            trendPoints.Add(new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd"),
                totalsBySnapshotId[snapshot.Id]));

            var byInstitution = snapshot.AccountBalances
                .GroupBy(b => b.Account.Institution.Name)
                .ToDictionary(g => g.Key, g => g.Sum(item => item.Balance));

            foreach (var item in byInstitution)
            {
                institutionTrendPoints.Add(new InstitutionTrendPoint(
                    snapshot.Date,
                    snapshot.Date.ToString("MMM dd"),
                    item.Key,
                    item.Value));
            }
        }

        institutionTrendNames.AddRange(
            institutionTrendPoints
                .Select(point => point.InstitutionName)
                .Distinct()
                .OrderBy(name => name));

        latestTotal = filteredSnapshots.Count > 0
            ? totalsBySnapshotId[filteredSnapshots[^1].Id]
            : 0m;

        previousTotal = filteredSnapshots.Count > 1
            ? totalsBySnapshotId[filteredSnapshots[^2].Id]
            : 0m;

        activeAccountCount = filteredSnapshots
            .SelectMany(s => s.AccountBalances)
            .Select(b => b.Account.Id)
            .Distinct()
            .Count();

        var accountLookup = accounts.ToDictionary(a => a.Id);

        var rows = filteredSnapshots
            .SelectMany(s => s.AccountBalances)
            .GroupBy(b => b.Account.Id)
            .Select(group =>
            {
                var sourceAccount = accountLookup.TryGetValue(group.Key, out var knownAccount)
                    ? knownAccount
                    : group.First().Account;

                var bySnapshot = group
                    .GroupBy(b => b.SnapshotId)
                    .ToDictionary(item => item.Key, item => item.Last().Balance);

                return new AccountMatrixRow(
                    sourceAccount.Name,
                    sourceAccount.Institution.Name,
                    bySnapshot);
            })
            .OrderBy(row => row.AccountName)
            .ToList();

        matrixRows.AddRange(rows);

        var latestSnapshot = filteredSnapshots.LastOrDefault();
        if (latestSnapshot is null)
            return;

        var byType = latestSnapshot.AccountBalances
            .GroupBy(b => b.Account.Type.Group.Name)
            .Select(group => new SnapshotCompositionPoint(group.Key, group.Sum(x => x.Balance)))
            .OrderByDescending(item => item.Total)
            .ToList();

        latestCompositionPoints.AddRange(byType);
    }

    private IReadOnlyList<FinanceSnapshotResponse> FilterSnapshotsBySelectedRange(List<FinanceSnapshotResponse> orderedSnapshots)
    {
        if (selectedRangePreset == "all")
            return orderedSnapshots;

        if (selectedRangePreset == "custom")
        {
            var customStart = DateOnly.FromDateTime(customStartDate);
            var customEnd = DateOnly.FromDateTime(customEndDate);

            return orderedSnapshots
                .Where(s => s.Date >= customStart && s.Date <= customEnd)
                .ToList();
        }

        var months = selectedRangePreset switch
        {
            "3m" => 3,
            "6m" => 6,
            _ => 12
        };

        var maxDate = orderedSnapshots[^1].Date;
        var threshold = maxDate.AddMonths(-months);

        return orderedSnapshots
            .Where(s => s.Date >= threshold)
            .ToList();
    }

    private decimal GetSnapshotTotal(int snapshotId)
    {
        return totalsBySnapshotId.TryGetValue(snapshotId, out var total)
            ? total
            : 0m;
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C");
    }

    private IEnumerable<InstitutionTrendPoint> GetInstitutionTrend(string institutionName)
    {
        return institutionTrendPoints
            .Where(point => point.InstitutionName == institutionName)
            .OrderBy(point => point.Date);
    }

    private void AddEditBalanceRow()
    {
        if (editModel is null)
            return;

        editModel.Balances.Add(new BalanceEntry());
    }

    private void RemoveEditBalanceRow(int index)
    {
        if (editModel is null || editModel.Balances.Count <= 1)
            return;

        editModel.Balances.RemoveAt(index);
    }

    private static Dictionary<int, decimal> BuildBalanceMap(List<BalanceEntry> balances)
    {
        return balances
            .Where(b => b.AccountId > 0 && b.Balance.HasValue)
            .GroupBy(b => b.AccountId)
            .ToDictionary(g => g.Key, g => g.Last().Balance!.Value);
    }

    private sealed record AccountMatrixRow(
        string AccountName,
        string InstitutionName,
        Dictionary<int, decimal> BalancesBySnapshotId);

    private sealed record SnapshotTrendPoint(string Label, decimal Total);

    private sealed record InstitutionTrendPoint(DateOnly Date, string Label, string InstitutionName, decimal Total);

    private sealed record SnapshotCompositionPoint(string Label, decimal Total);

    private sealed class CreateSnapshotModel
    {
        public List<BalanceEntry> Balances { get; } = [];

        public void Reset(IEnumerable<AccountResponse> accounts)
        {
            Balances.Clear();

            foreach (var account in accounts.OrderBy(account => account.Name))
            {
                Balances.Add(new BalanceEntry
                {
                    AccountId = account.Id,
                    AccountName = account.Name,
                    InstitutionName = account.Institution.Name,
                    AccountTypeName = account.Type.Name,
                    AccountTypeGroupName = account.Type.Group.Name,
                    Balance = null
                });
            }
        }
    }

    private sealed class BalanceEntry
    {
        public int AccountId { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public string InstitutionName { get; set; } = string.Empty;
        public string AccountTypeName { get; set; } = string.Empty;
        public string AccountTypeGroupName { get; set; } = string.Empty;
        public decimal? Balance { get; set; }
    }

    private sealed class EditSnapshotModel
    {
        public int Id { get; set; }
        public DateTime SnapshotDate { get; set; } = DateTime.Today;
        public List<BalanceEntry> Balances { get; } = [new()];

        public static EditSnapshotModel From(FinanceSnapshotResponse snapshot)
        {
            var model = new EditSnapshotModel
            {
                Id = snapshot.Id,
                SnapshotDate = snapshot.Date.ToDateTime(TimeOnly.MinValue)
            };

            model.Balances.Clear();
            foreach (var balance in snapshot.AccountBalances)
            {
                model.Balances.Add(new BalanceEntry
                {
                    AccountId = balance.Account.Id,
                    Balance = balance.Balance
                });
            }

            if (model.Balances.Count == 0)
                model.Balances.Add(new BalanceEntry());

            return model;
        }
    }
}
