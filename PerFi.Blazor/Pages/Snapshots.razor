@page "/snapshots"
@attribute [Authorize]
@inject ISnapshotsApiClient SnapshotsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Snapshots</PageTitle>

<h1>Snapshots</h1>

<ErrorState Message="@errorMessage" />
<ValidationSummaryPanel Errors="@validationErrors" />

<section class="mb-4">
    <h2>Create</h2>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label" for="snapshotDate">Snapshot Date</label>
            <InputDate id="snapshotDate" class="form-control" @bind-Value="createModel.SnapshotDate" />
        </div>
    </div>

    <h3>Account Balances</h3>
    @for (var i = 0; i < createModel.Balances.Count; i++)
    {
        var balance = createModel.Balances[i];
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Account</label>
                <InputSelect class="form-select" @bind-Value="balance.AccountId">
                    <option value="0">Select account</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Balance</label>
                <InputNumber class="form-control" @bind-Value="balance.Balance" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-danger" @onclick="() => RemoveBalanceRow(i)" disabled="@(createModel.Balances.Count == 1)">Remove</button>
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="AddBalanceRow">Add Row</button>
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@isSubmitting">Create Snapshot</button>
    </div>
</section>

<section class="mb-4">
    <h2>Edit</h2>

    @if (editModel is null)
    {
        <p><em>Select Edit from the list to modify a snapshot.</em></p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="editSnapshotDate">Snapshot Date</label>
                <InputDate id="editSnapshotDate" class="form-control" @bind-Value="editModel.SnapshotDate" />
            </div>
        </div>

        <h3>Account Balances</h3>
        @for (var i = 0; i < editModel.Balances.Count; i++)
        {
            var balance = editModel.Balances[i];
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Account</label>
                    <InputSelect class="form-select" @bind-Value="balance.AccountId">
                        <option value="0">Select account</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Balance</label>
                    <InputNumber class="form-control" @bind-Value="balance.Balance" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-danger" type="button" @onclick="() => RemoveEditBalanceRow(i)" disabled="@(editModel.Balances.Count == 1)">Remove</button>
                </div>
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" @onclick="AddEditBalanceRow">Add Row</button>
            <button class="btn btn-primary" type="button" @onclick="UpdateAsync" disabled="@isSubmitting">Update Snapshot</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
        </div>
    }
</section>

<section class="mb-4">
    <h2>List</h2>
    <LoadingState IsVisible="@isLoading" />
    <EmptyState IsVisible="@(!isLoading && snapshots.Count == 0)" Message="No snapshots found." />

    @if (snapshots.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Account Balances</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var snapshot in snapshots)
                {
                    <tr>
                        <td>@snapshot.Id</td>
                        <td>@snapshot.Date</td>
                        <td>@snapshot.AccountBalances.Count</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(snapshot.Id)">View</button>
                            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEditAsync(snapshot.Id)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(snapshot.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Detail by ID</h2>
    <p><em>Use View from the list, or enter an ID to load directly.</em></p>

    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label" for="snapshotId">Snapshot ID</label>
            <InputNumber id="snapshotId" class="form-control" @bind-Value="detailId" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadDetailAsync">Load Detail</button>
        </div>
    </div>

    @if (selectedSnapshot is not null)
    {
        <dl>
            <dt>ID</dt>
            <dd>@selectedSnapshot.Id</dd>
            <dt>Date</dt>
            <dd>@selectedSnapshot.Date</dd>
        </dl>

        <h3>Balances</h3>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Snapshot ID</th>
                    <th>Account</th>
                    <th>Institution</th>
                    <th>Type</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var balance in selectedSnapshot.AccountBalances)
                {
                    <tr>
                        <td>@balance.SnapshotId</td>
                        <td>@balance.Account.Name</td>
                        <td>@balance.Account.Institution.Name</td>
                        <td>@balance.Account.Type.Name</td>
                        <td>@balance.Balance</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private readonly CreateSnapshotModel createModel = new();
    private readonly List<AccountResponse> accounts = [];
    private readonly List<FinanceSnapshotResponse> snapshots = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private FinanceSnapshotResponse? selectedSnapshot;
    private EditSnapshotModel? editModel;
    private int detailId;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadListAsync();
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            snapshots.Clear();
            snapshots.AddRange(await SnapshotsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync()
    {
        if (detailId <= 0)
        {
            errorMessage = "Snapshot ID must be greater than zero.";
            return;
        }

        errorMessage = null;

        try
        {
            selectedSnapshot = await SnapshotsApiClient.GetByIdAsync(detailId);

            if (selectedSnapshot is null)
                errorMessage = $"No snapshot found with ID '{detailId}'.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var map = createModel.Balances
            .Where(b => b.AccountId > 0)
            .GroupBy(b => b.AccountId)
            .ToDictionary(g => g.Key, g => g.Last().Balance);

        var result = await SnapshotsApiClient.CreateAsync(
            DateOnly.FromDateTime(createModel.SnapshotDate),
            map);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.Reset();
        await LoadListAsync();
    }

    private async Task LoadDetailAsync(int id)
    {
        detailId = id;
        await LoadDetailAsync();
    }

    private async Task StartEditAsync(int id)
    {
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var snapshot = await SnapshotsApiClient.GetByIdAsync(id);
        if (snapshot is null)
        {
            errorMessage = $"No snapshot found with ID '{id}'.";
            return;
        }

        selectedSnapshot = snapshot;
        detailId = snapshot.Id;
        editModel = EditSnapshotModel.From(snapshot);
    }

    private void CancelEdit() => editModel = null;

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var map = BuildBalanceMap(editModel.Balances);
        var result = await SnapshotsApiClient.UpdateAsync(
            editModel.Id,
            DateOnly.FromDateTime(editModel.SnapshotDate),
            map);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editModel = null;
        await LoadListAsync();
        await LoadDetailAsync(detailId);
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete snapshot #{id}?");
        if (!confirmed)
            return;

        var result = await SnapshotsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedSnapshot?.Id == id)
            selectedSnapshot = null;

        if (editModel?.Id == id)
            editModel = null;

        if (detailId == id)
            detailId = 0;

        await LoadListAsync();
    }

    private void AddBalanceRow() => createModel.Balances.Add(new BalanceEntry());

    private void AddEditBalanceRow()
    {
        if (editModel is null)
            return;

        editModel.Balances.Add(new BalanceEntry());
    }

    private void RemoveBalanceRow(int index)
    {
        if (createModel.Balances.Count <= 1)
            return;

        createModel.Balances.RemoveAt(index);
    }

    private void RemoveEditBalanceRow(int index)
    {
        if (editModel is null || editModel.Balances.Count <= 1)
            return;

        editModel.Balances.RemoveAt(index);
    }

    private static Dictionary<int, decimal> BuildBalanceMap(List<BalanceEntry> balances)
    {
        return balances
            .Where(b => b.AccountId > 0)
            .GroupBy(b => b.AccountId)
            .ToDictionary(g => g.Key, g => g.Last().Balance);
    }

    private sealed class CreateSnapshotModel
    {
        public DateTime SnapshotDate { get; set; } = DateTime.Today;
        public List<BalanceEntry> Balances { get; } = [new()];

        public void Reset()
        {
            SnapshotDate = DateTime.Today;
            Balances.Clear();
            Balances.Add(new BalanceEntry());
        }
    }

    private sealed class BalanceEntry
    {
        public int AccountId { get; set; }
        public decimal Balance { get; set; }
    }

    private sealed class EditSnapshotModel
    {
        public int Id { get; set; }
        public DateTime SnapshotDate { get; set; } = DateTime.Today;
        public List<BalanceEntry> Balances { get; } = [new()];

        public static EditSnapshotModel From(FinanceSnapshotResponse snapshot)
        {
            var model = new EditSnapshotModel
            {
                Id = snapshot.Id,
                SnapshotDate = snapshot.Date.ToDateTime(TimeOnly.MinValue)
            };

            model.Balances.Clear();
            foreach (var balance in snapshot.AccountBalances)
            {
                model.Balances.Add(new BalanceEntry
                {
                    AccountId = balance.Account.Id,
                    Balance = balance.Balance
                });
            }

            if (model.Balances.Count == 0)
                model.Balances.Add(new BalanceEntry());

            return model;
        }
    }
}
