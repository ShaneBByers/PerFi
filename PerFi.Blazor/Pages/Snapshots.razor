    private CellDeltaDisplay GetMilestoneDeltaDisplay(decimal? current, decimal? prior)
    {
        if (!current.HasValue || !prior.HasValue)
            return new CellDeltaDisplay("-", "amount-muted");

        var delta = current.Value - prior.Value;
        if (delta == 0m)
            return new CellDeltaDisplay(FormatCurrency(0m), "amount-muted");

        var percent = prior.Value != 0m ? delta / Math.Abs(prior.Value) * 100m : (decimal?)null;
        var text = percent.HasValue
            ? $"{FormatDeltaCurrency(delta)} ({FormatPercent(percent)})"
            : FormatDeltaCurrency(delta);

        return new CellDeltaDisplay(text, GetDeltaClass(delta));
    }

    private static string FormatPercent(decimal? percent)
    {
        if (!percent.HasValue)
            return "-";

        var sign = percent.Value > 0 ? "+" : string.Empty;
        return $"{sign}{percent.Value.ToString("0.0", CultureInfo.InvariantCulture)}%";
    }

    private decimal GetSnapshotTotal(int snapshotId)
    {
        var total = totalsBySnapshotId.TryGetValue(snapshotId, out var existingTotal)
            ? existingTotal
            : 0m;

        foreach (var ((editedSnapshotId, editedAccountId), editedAmount) in matrixCellEdits)
        {
            if (editedSnapshotId != snapshotId)
                continue;

            var original = GetOriginalCellValue(snapshotId, editedAccountId);
            total -= original ?? 0m;
            total += editedAmount;
        }

        return total;
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C");
    }

