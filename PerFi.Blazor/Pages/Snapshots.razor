@page "/snapshots"
@attribute [Authorize]
@using System.Globalization
@inject ISnapshotsApiClient SnapshotsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Net Worth</PageTitle>

<div class="snapshots-page">
    <header class="page-hero">
        <div>
            <h1>Net Worth</h1>
        </div>
        <div class="hero-actions">
            <div class="range-control">
                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">@GetRangeButtonLabel()</button>

                @if (showRangePicker)
                {
                    <div class="range-popover" role="dialog" aria-label="Date range options">
                        <div class="filter-presets" role="toolbar" aria-label="Net Worth range presets">
                            <button class='@GetRangeClass("ytd")' @onclick='() => SetRangePreset("ytd")'>YTD</button>
                            <button class='@GetRangeClass("3m")' @onclick='() => SetRangePreset("3m")'>3M</button>
                            <button class='@GetRangeClass("6m")' @onclick='() => SetRangePreset("6m")'>6M</button>
                            <button class='@GetRangeClass("12m")' @onclick='() => SetRangePreset("12m")'>12M</button>
                            <button class='@GetRangeClass("all")' @onclick='() => SetRangePreset("all")'>All</button>
                        </div>
                        <div class="custom-range row g-2 align-items-end mt-1">
                            <div class="col-md-4">
                                <label class="form-label" for="customStart">Start</label>
                                <InputDate id="customStart" class="form-control" @bind-Value="customStartDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="customEnd">End</label>
                                <InputDate id="customEnd" class="form-control" @bind-Value="customEndDate" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button class="btn btn-outline-secondary" type="button" @onclick="ApplyCustomRange">Apply</button>
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleRangePicker">Close</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadListAsync" disabled="@isLoading">Refresh</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="summary-grid" aria-label="Net Worth highlights">
        <article class="summary-card">
            <span class="summary-label">Latest Net Worth</span>
            <strong>@FormatCurrency(latestTotal)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Previous Entry</span>
            <strong>@FormatCurrency(previousTotal)</strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Change</span>
            <strong class="@(latestTotal - previousTotal >= 0 ? "positive" : "negative")">
                @FormatCurrency(latestTotal - previousTotal)
            </strong>
        </article>
        <article class="summary-card">
            <span class="summary-label">Active Accounts</span>
            <strong>@activeAccountCount</strong>
        </article>
    </section>

    <section class="matrix-panel">
        <div class="section-header matrix-header">
            <div>
                <h2>Net Worth Matrix</h2>
            </div>
            <div class="matrix-nav-actions">
                @if (!isMatrixEditMode)
                {
                    <button class="btn btn-sm btn-primary" type="button" @onclick="StartNewMatrixEntry">New Entry</button>
                    @if (filteredSnapshots.Count > 0)
                    {
                        <button class="btn btn-sm btn-primary" type="button" @onclick="EnterMatrixEditMode">Edit</button>
                    }
                }
                else
                {
                    <span class="matrix-staged-chip @(HasPendingMatrixEdits ? string.Empty : "matrix-staged-chip-hidden")">@GetMatrixStagedChangesText()</span>
                    <button class="btn btn-sm btn-primary" type="button" @onclick="SaveMatrixEditsAsync" disabled="@(isSubmitting || HasMatrixValidationErrors || !HasPendingMatrixEdits)">Save Changes</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelMatrixEditMode" disabled="@isSubmitting">Discard Changes</button>
                }

                @if (filteredSnapshots.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="PreviousMatrixPage" disabled="@(!CanGoToPreviousMatrixPage())">Prev</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="NextMatrixPage" disabled="@(!CanGoToNextMatrixPage())">Next</button>
                }
            </div>
        </div>

        @if (isMatrixEditMode && HasMatrixValidationErrors)
        {
            <div class="alert alert-warning matrix-validation-banner" role="alert">
                Fix invalid cell values before saving table edits.
            </div>
        }

        <LoadingState IsVisible="@isLoading" />
        <EmptyState IsVisible="@(!isLoading && filteredSnapshots.Count == 0)" Message="No net worth entries in this period." />

        @if (!isLoading && filteredSnapshots.Count > 0)
        {
            var visibleSnapshots = GetVisibleMatrixSnapshots();
            <div class="matrix-wrap">
                <table class="table table-sm snapshot-matrix">
                    <thead>
                        <tr>
                            <th>Account</th>
                            @foreach (var column in visibleSnapshots)
                            {
                                <th class="text-end @(column.IsDraft ? "new-entry-column-header" : string.Empty)">
                                    <span>@column.Date.ToString("MMM dd, yyyy")</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in matrixGroups)
                        {
                            <tr class="group-header-row">
                                <th>@group.AccountTypeGroupName</th>
                                @foreach (var column in visibleSnapshots)
                                {
                                    var groupTotal = GetGroupTotal(group, column.Id);
                                    <th class="text-end @GetAmountClass(groupTotal)">@FormatCurrency(groupTotal)</th>
                                }
                            </tr>

                            @foreach (var row in group.Rows)
                            {
                                <tr>
                                    <th>
                                        <div class="account-name">@row.AccountName</div>
                                        <div class="account-meta">@row.InstitutionName</div>
                                    </th>
                                    @foreach (var column in visibleSnapshots)
                                    {
                                        <td class="@GetCellClass(column.Id, row.AccountId)">
                                            @if (isMatrixEditMode)
                                            {
                                                <input class="form-control form-control-sm text-end matrix-cell-input @GetCellInputClass(column.Id, row.AccountId)"
                                                       value="@GetCellInputValue(column.Id, row.AccountId)"
                                                       @onchange='eventArgs => OnMatrixCellChanged(column.Id, row.AccountId, eventArgs.Value?.ToString())' />
                                                @if (TryGetMatrixCellValidationError(column.Id, row.AccountId, out var validationError))
                                                {
                                                    <div class="matrix-cell-error">@validationError</div>
                                                }
                                            }
                                            else
                                            {
                                                var displayedValue = GetDisplayedCellValue(column.Id, row.AccountId);
                                                @if (displayedValue.HasValue)
                                                {
                                                    <div class="text-end @GetAmountClass(displayedValue.Value)">@FormatCurrency(displayedValue.Value)</div>
                                                }
                                                else
                                                {
                                                    <div class="text-end amount-muted">-</div>
                                                }
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            @foreach (var column in visibleSnapshots)
                            {
                                var total = GetSnapshotTotal(column.Id);
                                <th class="text-end @GetAmountClass(total)">@FormatCurrency(total)</th>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="chart-panel">
        <div class="section-header">
            <h2>Total Net Worth Trend</h2>
        </div>

        <EmptyState IsVisible="@(filteredSnapshots.Count == 0)" Message="Add net worth entries to render trend charts." />

        @if (filteredSnapshots.Count > 0)
        {
            <div class="chart-grid">
                <section class="chart-surface">
                    <div class="section-header">
                        <h3>@GetSelectedRangeChartTitle()</h3>
                    </div>
                    <ApexChart TItem="SnapshotTrendPoint" Title="@($"Total Net Worth ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateCurrencyChartOptions()">
                        <ApexPointSeries TItem="SnapshotTrendPoint"
                                         Items="rangeTrendPoints"
                                         Name="Net Worth"
                                         SeriesType="SeriesType.Line"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    </ApexChart>
                </section>

                <section class="chart-surface">
                    <div class="section-header">
                        <h3>All-Time</h3>
                    </div>
                    <ApexChart TItem="SnapshotTrendPoint" Title="Total Net Worth (All-Time)" Height="320" Options="@CreateCurrencyChartOptions()">
                        <ApexPointSeries TItem="SnapshotTrendPoint"
                                         Items="allTimeTrendPoints"
                                         Name="Net Worth"
                                         SeriesType="SeriesType.Line"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    </ApexChart>
                </section>
            </div>
        }
    </section>

    @foreach (var groupChart in accountTypeGroupCharts)
    {
        <section class="chart-panel">
            <div class="section-header">
                <h2>@groupChart.GroupName</h2>
            </div>
            <div class="chart-grid">
                <section class="chart-surface">
                    <div class="section-header">
                        <h3>@GetSelectedRangeChartTitle()</h3>
                    </div>
                    <ApexChart TItem="SnapshotTrendPoint" Title="@($"{groupChart.GroupName} ({GetSelectedRangeChartLabel()})")" Height="320" Options="@CreateCurrencyChartOptions()">
                        <ApexPointSeries TItem="SnapshotTrendPoint"
                                         Items="groupChart.RangePoints"
                                         Name="@groupChart.GroupName"
                                         SeriesType="SeriesType.Line"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    </ApexChart>
                </section>

                <section class="chart-surface">
                    <div class="section-header">
                        <h3>All-Time</h3>
                    </div>
                    <ApexChart TItem="SnapshotTrendPoint" Title="@($"{groupChart.GroupName} (All-Time)")" Height="320" Options="@CreateCurrencyChartOptions()">
                        <ApexPointSeries TItem="SnapshotTrendPoint"
                                         Items="groupChart.AllTimePoints"
                                         Name="@groupChart.GroupName"
                                         SeriesType="SeriesType.Line"
                                         XValue="point => point.Label"
                                         YValue="point => point.Total" />
                    </ApexChart>
                </section>
            </div>
        </section>
    }

    @if (selectedSnapshot is not null)
    {
        <section class="detail-panel">
            <div class="section-header">
                <h2>Net Worth Entry Detail</h2>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Institution</th>
                            <th>Type</th>
                            <th>Group</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var balance in selectedSnapshot.AccountBalances.OrderBy(b => b.Account.Name))
                        {
                            <tr>
                                <td>@balance.Account.Name</td>
                                <td>@balance.Account.Institution.Name</td>
                                <td>@balance.Account.Type.Name</td>
                                <td>@balance.Account.Type.Group.Name</td>
                                <td class="text-end">@FormatCurrency(balance.Balance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private readonly List<AccountResponse> accounts = [];
    private readonly List<FinanceSnapshotResponse> snapshots = [];
    private readonly List<FinanceSnapshotResponse> filteredSnapshots = [];
    private readonly List<AccountMatrixGroup> matrixGroups = [];
    private readonly List<SnapshotTrendPoint> rangeTrendPoints = [];
    private readonly List<SnapshotTrendPoint> allTimeTrendPoints = [];
    private readonly List<AccountTypeGroupTrendChart> accountTypeGroupCharts = [];
    private readonly Dictionary<int, decimal> totalsBySnapshotId = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), decimal> matrixCellEdits = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), string> matrixCellInputOverrides = [];
    private readonly Dictionary<(int SnapshotId, int AccountId), string> matrixCellValidationErrors = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private FinanceSnapshotResponse? selectedSnapshot;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool hasPendingMatrixEntry;
    private bool showRangePicker;
    private bool isMatrixEditMode;
    private string? errorMessage;
    private string? successMessage;
    private string selectedRangePreset = "ytd";
    private DateTime customStartDate = new(DateTime.Today.Year, 1, 1);
    private DateTime customEndDate = DateTime.Today;
    private decimal latestTotal;
    private decimal previousTotal;
    private int activeAccountCount;
    private int matrixStartColumnIndex;
    private const int MatrixColumnPageSize = 8;
    private const int PendingMatrixSnapshotId = -1;

    private bool HasPendingMatrixEdits => matrixCellEdits.Count > 0;
    private bool HasMatrixValidationErrors => matrixCellValidationErrors.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        await LoadListAsync();
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            snapshots.Clear();
            snapshots.AddRange(await SnapshotsApiClient.GetAllAsync());
            matrixCellEdits.Clear();
            matrixCellInputOverrides.Clear();
            matrixCellValidationErrors.Clear();
            isMatrixEditMode = false;
            RebuildSnapshotView();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedSnapshot = await SnapshotsApiClient.GetByIdAsync(id);

            if (selectedSnapshot is null)
                errorMessage = $"Net worth entry #{id} was not found.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartNewMatrixEntry()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        hasPendingMatrixEntry = true;
        isMatrixEditMode = true;
        RemoveWhere(matrixCellValidationErrors, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellInputOverrides, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellEdits, key => key.SnapshotId == PendingMatrixSnapshotId);
        ResetMatrixPagingToLatest();
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete net worth entry from your timeline? (ID {id})");
        if (!confirmed)
            return;

        var result = await SnapshotsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedSnapshot?.Id == id)
            selectedSnapshot = null;

        successMessage = "Net worth entry deleted.";

        await LoadListAsync();
    }

    private void SetRangePreset(string preset)
    {
        selectedRangePreset = preset;
        showRangePicker = false;
        RebuildSnapshotView();
    }

    private void ApplyCustomRange()
    {
        if (customEndDate < customStartDate)
            (customStartDate, customEndDate) = (customEndDate, customStartDate);

        selectedRangePreset = "custom";
        showRangePicker = false;
        RebuildSnapshotView();
    }

    private void ToggleRangePicker()
    {
        showRangePicker = !showRangePicker;
    }

    private void EnterMatrixEditMode()
    {
        isMatrixEditMode = true;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelMatrixEditMode()
    {
        hasPendingMatrixEntry = false;
        RemoveWhere(matrixCellEdits, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellInputOverrides, key => key.SnapshotId == PendingMatrixSnapshotId);
        RemoveWhere(matrixCellValidationErrors, key => key.SnapshotId == PendingMatrixSnapshotId);
        DiscardMatrixEdits();
        isMatrixEditMode = false;
    }

    private string GetRangeButtonLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "Range: YTD",
            "3m" => "Range: 3M",
            "6m" => "Range: 6M",
            "12m" => "Range: 12M",
            "all" => "Range: All",
            "custom" => $"Range: {customStartDate:MMM d} - {customEndDate:MMM d}",
            _ => "Range"
        };
    }

    private string GetRangeLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => $"YTD ({new DateTime(customEndDate.Year, 1, 1):MMM d} - {customEndDate:MMM d})",
            "3m" => "Last 3 months",
            "6m" => "Last 6 months",
            "12m" => "Last 12 months",
            "all" => "All time",
            "custom" => $"{customStartDate:MMM d, yyyy} - {customEndDate:MMM d, yyyy}",
            _ => "Custom"
        };
    }

    private string GetSelectedRangeChartLabel()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "3m" => "Last 3 Months",
            "6m" => "Last 6 Months",
            "12m" => "Last 12 Months",
            "all" => "All Time",
            "custom" => $"Custom: {customStartDate:MMM d, yyyy} to {customEndDate:MMM d, yyyy}",
            _ => "Selected Range"
        };
    }

    private string GetSelectedRangeChartTitle()
    {
        return selectedRangePreset switch
        {
            "ytd" => "YTD",
            "all" => "All Time",
            _ => GetSelectedRangeChartLabel()
        };
    }

    private string GetRangeClass(string preset)
    {
        return selectedRangePreset == preset
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
    }

    private void RebuildSnapshotView()
    {
        filteredSnapshots.Clear();
        matrixGroups.Clear();
        rangeTrendPoints.Clear();
        allTimeTrendPoints.Clear();
        accountTypeGroupCharts.Clear();
        totalsBySnapshotId.Clear();

        var orderedSnapshots = snapshots
            .OrderBy(s => s.Date)
            .ToList();

        if (orderedSnapshots.Count == 0)
        {
            latestTotal = 0m;
            previousTotal = 0m;
            activeAccountCount = 0;
            matrixStartColumnIndex = 0;
            return;
        }

        var visibleSnapshots = FilterSnapshotsBySelectedRange(orderedSnapshots);
        filteredSnapshots.AddRange(visibleSnapshots);

        var allTimeTotalsBySnapshotId = new Dictionary<int, decimal>();

        foreach (var snapshot in orderedSnapshots)
        {
            allTimeTotalsBySnapshotId[snapshot.Id] = snapshot.AccountBalances.Sum(b => b.Balance);
            allTimeTrendPoints.Add(new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd, yyyy"),
                allTimeTotalsBySnapshotId[snapshot.Id]));
        }

        foreach (var snapshot in filteredSnapshots)
        {
            totalsBySnapshotId[snapshot.Id] = snapshot.AccountBalances.Sum(b => b.Balance);
            rangeTrendPoints.Add(new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd, yyyy"),
                totalsBySnapshotId[snapshot.Id]));
        }

        latestTotal = filteredSnapshots.Count > 0
            ? totalsBySnapshotId[filteredSnapshots[^1].Id]
            : 0m;

        previousTotal = filteredSnapshots.Count > 1
            ? totalsBySnapshotId[filteredSnapshots[^2].Id]
            : 0m;

        activeAccountCount = filteredSnapshots
            .SelectMany(s => s.AccountBalances)
            .Select(b => b.Account.Id)
            .Distinct()
            .Count();

        var accountLookup = accounts.ToDictionary(a => a.Id);

        var rows = filteredSnapshots
            .SelectMany(s => s.AccountBalances)
            .GroupBy(b => b.Account.Id)
            .Select(group =>
            {
                var sourceAccount = accountLookup.TryGetValue(group.Key, out var knownAccount)
                    ? knownAccount
                    : group.First().Account;

                var bySnapshot = group
                    .GroupBy(b => b.SnapshotId)
                    .ToDictionary(item => item.Key, item => item.Last().Balance);

                return new AccountMatrixRow(
                    sourceAccount.Id,
                    sourceAccount.Name,
                    sourceAccount.DisplayOrder,
                    sourceAccount.Institution.Name,
                    sourceAccount.Type.Id,
                    sourceAccount.Type.Name,
                    sourceAccount.Type.DisplayOrder,
                    sourceAccount.Type.Group.Id,
                    sourceAccount.Type.Group.Name,
                    sourceAccount.Type.Group.DisplayOrder,
                    bySnapshot);
            })
            .OrderBy(row => row.AccountTypeGroupDisplayOrder)
            .ThenBy(row => row.AccountTypeGroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountTypeGroupId)
            .ThenBy(row => row.AccountTypeDisplayOrder)
            .ThenBy(row => row.AccountTypeName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountTypeId)
            .ThenBy(row => row.AccountDisplayOrder)
            .ThenBy(row => row.AccountName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(row => row.AccountId)
            .ToList();

        var groupedRows = rows
            .GroupBy(row => new
            {
                row.AccountTypeGroupId,
                row.AccountTypeGroupName,
                row.AccountTypeGroupDisplayOrder
            })
            .OrderBy(group => group.Key.AccountTypeGroupDisplayOrder)
            .ThenBy(group => group.Key.AccountTypeGroupName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(group => group.Key.AccountTypeGroupId)
            .Select(group => new AccountMatrixGroup(group.Key.AccountTypeGroupName, [.. group]))
            .ToList();

        matrixGroups.AddRange(groupedRows);
        ResetMatrixPagingToLatest();

        var groupNames = matrixGroups
            .Select(group => group.AccountTypeGroupName)
            .Distinct()
            .ToList();

        foreach (var groupName in groupNames)
        {
            var rangePoints = BuildGroupTrendPoints(filteredSnapshots, groupName);
            var allTimePoints = BuildGroupTrendPoints(orderedSnapshots, groupName);
            accountTypeGroupCharts.Add(new AccountTypeGroupTrendChart(groupName, rangePoints, allTimePoints));
        }
    }

    private IReadOnlyList<FinanceSnapshotResponse> FilterSnapshotsBySelectedRange(List<FinanceSnapshotResponse> orderedSnapshots)
    {
        if (selectedRangePreset == "all")
            return orderedSnapshots;

        if (selectedRangePreset == "custom")
        {
            var customStart = DateOnly.FromDateTime(customStartDate);
            var customEnd = DateOnly.FromDateTime(customEndDate);

            return orderedSnapshots
                .Where(s => s.Date >= customStart && s.Date <= customEnd)
                .ToList();
        }

        if (selectedRangePreset == "ytd")
        {
            var latestDate = orderedSnapshots[^1].Date;
            var startOfYear = new DateOnly(latestDate.Year, 1, 1);

            return orderedSnapshots
                .Where(s => s.Date >= startOfYear && s.Date <= latestDate)
                .ToList();
        }

        var months = selectedRangePreset switch
        {
            "3m" => 3,
            "6m" => 6,
            _ => 12
        };

        var maxDate = orderedSnapshots[^1].Date;
        var threshold = maxDate.AddMonths(-months);

        return orderedSnapshots
            .Where(s => s.Date >= threshold)
            .ToList();
    }

    private decimal GetSnapshotTotal(int snapshotId)
    {
        var total = totalsBySnapshotId.TryGetValue(snapshotId, out var existingTotal)
            ? existingTotal
            : 0m;

        foreach (var ((editedSnapshotId, editedAccountId), editedAmount) in matrixCellEdits)
        {
            if (editedSnapshotId != snapshotId)
                continue;

            var original = GetOriginalCellValue(snapshotId, editedAccountId);
            total -= original ?? 0m;
            total += editedAmount;
        }

        return total;
    }

    private static string FormatCurrency(decimal value)
    {
        return value.ToString("C");
    }

    private static ApexChartOptions<SnapshotTrendPoint> CreateCurrencyChartOptions()
    {
        const string currencyFormatter = "function (value) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(value); }";

        return new ApexChartOptions<SnapshotTrendPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar
                {
                    Show = false
                },
                Zoom = new Zoom
                {
                    Enabled = false
                },
                Selection = new Selection
                {
                    Enabled = false
                }
            },
            Xaxis = new XAxis
            {
                TickAmount = 6,
                TickPlacement = TickPlacement.On
            },
            Yaxis = new List<YAxis>
            {
                new()
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = currencyFormatter
                    }
                }
            },
            Tooltip = new Tooltip
            {
                Y = new TooltipY
                {
                    Formatter = currencyFormatter
                }
            }
        };
    }

    private static List<SnapshotTrendPoint> BuildGroupTrendPoints(IEnumerable<FinanceSnapshotResponse> sourceSnapshots, string groupName)
    {
        return sourceSnapshots
            .Select(snapshot => new SnapshotTrendPoint(
                snapshot.Date.ToString("MMM dd, yyyy"),
                snapshot.AccountBalances
                    .Where(balance => string.Equals(balance.Account.Type.Group.Name, groupName, StringComparison.OrdinalIgnoreCase))
                    .Sum(balance => balance.Balance)))
            .ToList();
    }

    private IReadOnlyList<MatrixSnapshotColumn> GetVisibleMatrixSnapshots()
    {
        var columns = BuildMatrixColumns();
        if (columns.Count == 0)
            return [];

        var start = Math.Clamp(matrixStartColumnIndex, 0, Math.Max(0, columns.Count - 1));
        var count = Math.Min(MatrixColumnPageSize, columns.Count - start);
        return columns.GetRange(start, count);
    }

    private void ResetMatrixPagingToLatest()
    {
        var columnCount = GetMatrixColumnCount();
        matrixStartColumnIndex = columnCount <= MatrixColumnPageSize
            ? 0
            : columnCount - MatrixColumnPageSize;
    }

    private bool CanGoToPreviousMatrixPage()
        => matrixStartColumnIndex > 0;

    private bool CanGoToNextMatrixPage()
        => GetMatrixColumnCount() > 0 && matrixStartColumnIndex + MatrixColumnPageSize < GetMatrixColumnCount();

    private void PreviousMatrixPage()
    {
        if (!CanGoToPreviousMatrixPage())
            return;

        matrixStartColumnIndex = Math.Max(0, matrixStartColumnIndex - MatrixColumnPageSize);
    }

    private void NextMatrixPage()
    {
        if (!CanGoToNextMatrixPage())
            return;

        matrixStartColumnIndex = Math.Min(Math.Max(0, GetMatrixColumnCount() - MatrixColumnPageSize), matrixStartColumnIndex + MatrixColumnPageSize);
    }

    private int GetMatrixColumnCount()
        => filteredSnapshots.Count + (hasPendingMatrixEntry ? 1 : 0);

    private List<MatrixSnapshotColumn> BuildMatrixColumns()
    {
        var columns = filteredSnapshots
            .Select(snapshot => new MatrixSnapshotColumn(snapshot.Id, snapshot.Date, false))
            .ToList();

        if (hasPendingMatrixEntry)
            columns.Add(new MatrixSnapshotColumn(PendingMatrixSnapshotId, DateOnly.FromDateTime(DateTime.Today), true));

        return columns;
    }

    private decimal GetGroupTotal(AccountMatrixGroup group, int snapshotId)
    {
        return group.Rows.Sum(row => GetDisplayedCellValue(snapshotId, row.AccountId) ?? 0m);
    }

    private decimal? GetDisplayedCellValue(int snapshotId, int accountId)
    {
        if (matrixCellEdits.TryGetValue((snapshotId, accountId), out var edited))
            return edited;

        return GetOriginalCellValue(snapshotId, accountId);
    }

    private decimal? GetOriginalCellValue(int snapshotId, int accountId)
    {
        if (snapshotId == PendingMatrixSnapshotId)
            return null;

        foreach (var group in matrixGroups)
        {
            var row = group.Rows.FirstOrDefault(item => item.AccountId == accountId);
            if (row is null)
                continue;

            if (row.BalancesBySnapshotId.TryGetValue(snapshotId, out var value))
                return value;

            return null;
        }

        return null;
    }

    private string GetCellInputValue(int snapshotId, int accountId)
    {
        if (matrixCellInputOverrides.TryGetValue((snapshotId, accountId), out var overrideValue))
            return overrideValue;

        var value = GetDisplayedCellValue(snapshotId, accountId);
        return value?.ToString(CultureInfo.CurrentCulture) ?? string.Empty;
    }

    private string GetCellInputClass(int snapshotId, int accountId)
    {
        var classes = new List<string>();

        if (IsCellEdited(snapshotId, accountId))
            classes.Add("matrix-cell-input-edited");

        if (matrixCellValidationErrors.ContainsKey((snapshotId, accountId)))
            classes.Add("is-invalid");

        var value = GetDisplayedCellValue(snapshotId, accountId);
        classes.Add(value.HasValue ? GetAmountClass(value.Value) : "amount-muted");
        return string.Join(' ', classes);
    }

    private string GetCellClass(int snapshotId, int accountId)
    {
        if (!isMatrixEditMode)
            return string.Empty;

        if (matrixCellValidationErrors.ContainsKey((snapshotId, accountId)))
            return "matrix-cell matrix-cell-invalid";

        return IsCellEdited(snapshotId, accountId)
            ? "matrix-cell matrix-cell-edited"
            : "matrix-cell";
    }

    private bool IsCellEdited(int snapshotId, int accountId)
    {
        return matrixCellEdits.ContainsKey((snapshotId, accountId));
    }

    private string GetMatrixStagedChangesText()
    {
        var count = matrixCellEdits.Count;
        if (count == 0)
            return "0 changes staged";

        return count == 1
            ? "1 change staged"
            : $"{count} changes staged";
    }

    private bool TryGetMatrixCellValidationError(int snapshotId, int accountId, out string error)
    {
        return matrixCellValidationErrors.TryGetValue((snapshotId, accountId), out error!);
    }

    private static string GetAmountClass(decimal value)
    {
        if (value > 0m)
            return "amount-positive";

        if (value < 0m)
            return "amount-negative";

        return "amount-muted";
    }

    private void OnMatrixCellChanged(int snapshotId, int accountId, string? rawValue)
    {
        matrixCellInputOverrides[(snapshotId, accountId)] = rawValue ?? string.Empty;

        if (string.IsNullOrWhiteSpace(rawValue))
        {
            matrixCellEdits.Remove((snapshotId, accountId));
            matrixCellInputOverrides.Remove((snapshotId, accountId));
            matrixCellValidationErrors.Remove((snapshotId, accountId));
            return;
        }

        if (!decimal.TryParse(rawValue, NumberStyles.Number | NumberStyles.AllowCurrencySymbol, CultureInfo.CurrentCulture, out var parsed))
        {
            matrixCellEdits.Remove((snapshotId, accountId));
            matrixCellValidationErrors[(snapshotId, accountId)] = "Enter a valid dollar amount.";
            return;
        }

        matrixCellValidationErrors.Remove((snapshotId, accountId));
        matrixCellInputOverrides.Remove((snapshotId, accountId));

        var original = GetOriginalCellValue(snapshotId, accountId);
        if (original.HasValue && original.Value == parsed)
        {
            matrixCellEdits.Remove((snapshotId, accountId));
            return;
        }

        matrixCellEdits[(snapshotId, accountId)] = parsed;
    }

    private void DiscardMatrixEdits()
    {
        matrixCellEdits.Clear();
        matrixCellInputOverrides.Clear();
        matrixCellValidationErrors.Clear();
    }

    private async Task SaveMatrixEditsAsync()
    {
        if (!HasPendingMatrixEdits || HasMatrixValidationErrors)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        if (hasPendingMatrixEntry)
        {
            foreach (var accountId in matrixGroups.SelectMany(group => group.Rows).Select(row => row.AccountId).Distinct())
            {
                if (matrixCellEdits.ContainsKey((PendingMatrixSnapshotId, accountId)))
                    continue;

                matrixCellValidationErrors[(PendingMatrixSnapshotId, accountId)] = "Enter a value for this account.";
            }

            if (HasMatrixValidationErrors)
            {
                isSubmitting = false;
                errorMessage = "Enter a value for every account in the new entry column before saving.";
                return;
            }

            var createResult = await SnapshotsApiClient.CreateAsync(
                DateOnly.FromDateTime(DateTime.Today),
                matrixCellEdits
                    .Where(item => item.Key.SnapshotId == PendingMatrixSnapshotId)
                    .ToDictionary(item => item.Key.AccountId, item => item.Value));

            if (!createResult.IsSuccess)
            {
                isSubmitting = false;
                errorMessage = createResult.ErrorMessage;
                validationErrors = createResult.ValidationErrors ?? new Dictionary<string, string[]>();
                return;
            }

            hasPendingMatrixEntry = false;
            RemoveWhere(matrixCellEdits, key => key.SnapshotId == PendingMatrixSnapshotId);
            RemoveWhere(matrixCellInputOverrides, key => key.SnapshotId == PendingMatrixSnapshotId);
            RemoveWhere(matrixCellValidationErrors, key => key.SnapshotId == PendingMatrixSnapshotId);
        }

        var updates = matrixCellEdits
            .Where(item => item.Key.SnapshotId > 0)
            .Select(item => new SnapshotCellUpdateRequest(item.Key.SnapshotId, item.Key.AccountId, item.Value))
            .ToList();

        ApiResult result = updates.Count == 0
            ? ApiResult.Success()
            : await SnapshotsApiClient.BulkUpdateCellsAsync(updates);

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        matrixCellEdits.Clear();
        matrixCellInputOverrides.Clear();
        matrixCellValidationErrors.Clear();
        isMatrixEditMode = false;
        successMessage = "Table edits saved.";
        await LoadListAsync();
    }

    private sealed record AccountMatrixGroup(
        string AccountTypeGroupName,
        List<AccountMatrixRow> Rows);

    private sealed record AccountMatrixRow(
        int AccountId,
        string AccountName,
        int AccountDisplayOrder,
        string InstitutionName,
        int AccountTypeId,
        string AccountTypeName,
        int AccountTypeDisplayOrder,
        int AccountTypeGroupId,
        string AccountTypeGroupName,
        int AccountTypeGroupDisplayOrder,
        Dictionary<int, decimal> BalancesBySnapshotId);

    private sealed record SnapshotTrendPoint(string Label, decimal Total);

    private sealed record MatrixSnapshotColumn(int Id, DateOnly Date, bool IsDraft);

    private sealed record AccountTypeGroupTrendChart(
        string GroupName,
        IReadOnlyList<SnapshotTrendPoint> RangePoints,
        IReadOnlyList<SnapshotTrendPoint> AllTimePoints);


    private static void RemoveWhere(Dictionary<(int SnapshotId, int AccountId), decimal> source, Func<(int SnapshotId, int AccountId), bool> predicate)
    {
        var keys = source.Keys.Where(predicate).ToList();
        foreach (var key in keys)
            source.Remove(key);
    }

    private static void RemoveWhere(Dictionary<(int SnapshotId, int AccountId), string> source, Func<(int SnapshotId, int AccountId), bool> predicate)
    {
        var keys = source.Keys.Where(predicate).ToList();
        foreach (var key in keys)
            source.Remove(key);
    }
}
