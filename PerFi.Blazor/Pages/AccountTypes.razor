@page "/account-types"
@attribute [Authorize]
@inject IAccountTypesApiClient AccountTypesApiClient
@inject IAccountTypeGroupsApiClient AccountTypeGroupsApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Account Types</PageTitle>

<div class="crud-page">
    <header class="page-hero">
        <div>
            <h1>Account Types</h1>
            <p>Define clear categories for each account in your financial model.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadListAsync" disabled="@isLoading">Refresh</button>
            <button class="btn btn-primary" type="button" @onclick="StartCreate">New Type</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (showEditor)
    {
        <section class="panel">
            <div class="section-header">
                <h2>@(editModel is null ? "Add Account Type" : "Edit Account Type")</h2>
                <p>@(editModel is null ? "Use short, recognizable names like Checking, Credit, or Investment." : $"Updating type #{editModel.Id}.")</p>
            </div>

            @if (editModel is null)
            {
                <EditForm Model="createModel" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="name">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="createModel.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="createGroup">Group</label>
                            <InputSelect id="createGroup" class="form-select" @bind-Value="createModel.AccountTypeGroupId">
                                <option value="0">Select group</option>
                                @foreach (var group in accountTypeGroups.OrderBy(item => item.Name))
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Type</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditor">Close</button>
                        </div>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="editModel" OnValidSubmit="UpdateAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="editName">Name</label>
                            <InputText id="editName" class="form-control" @bind-Value="editModel.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="editGroup">Group</label>
                            <InputSelect id="editGroup" class="form-select" @bind-Value="editModel.AccountTypeGroupId">
                                <option value="0">Select group</option>
                                @foreach (var group in accountTypeGroups.OrderBy(item => item.Name))
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </div>
                </EditForm>
            }
        </section>
    }

    <section class="panel">
        <div class="section-header">
            <h2>Catalog</h2>
            <p>Manage all available account type labels.</p>
        </div>

        <LoadingState IsVisible="@isLoading" />
        <EmptyState IsVisible="@(!isLoading && accountTypes.Count == 0)" Message="No account types yet." />

        @if (accountTypes.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Group</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in accountTypes.OrderBy(a => a.Name))
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Group.Name</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(item.Id)">Open</button>
                                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (selectedAccountType is not null)
    {
        <section class="panel detail-panel">
            <div class="section-header">
                <h2>Type Details</h2>
                <p>Selected account type information.</p>
            </div>

            <dl>
                <dt>Name</dt>
                <dd>@selectedAccountType.Name</dd>
                <dt>Group</dt>
                <dd>@selectedAccountType.Group.Name</dd>
            </dl>
        </section>
    }
</div>

@code {
    private readonly CreateModel createModel = new();
    private readonly List<AccountTypeResponse> accountTypes = [];
    private readonly List<AccountTypeGroupResponse> accountTypeGroups = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private AccountTypeResponse? selectedAccountType;
    private EditModel? editModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showEditor;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync() => await LoadListAsync();

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            accountTypeGroups.Clear();
            accountTypeGroups.AddRange(await AccountTypeGroupsApiClient.GetAllAsync());

            accountTypes.Clear();
            accountTypes.AddRange(await AccountTypesApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedAccountType = await AccountTypesApiClient.GetByIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountTypesApiClient.CreateAsync(createModel.Name, createModel.AccountTypeGroupId);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.Name = string.Empty;
        createModel.AccountTypeGroupId = 0;
        showEditor = false;
        successMessage = "Account type saved.";
        await LoadListAsync();
    }

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editModel = null;
    }

    private void StartEdit(AccountTypeResponse accountType)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = new EditModel
        {
            Id = accountType.Id,
            Name = accountType.Name,
            AccountTypeGroupId = accountType.Group.Id
        };
        showEditor = true;
    }

    private void CancelEdit() => CloseEditor();

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountTypesApiClient.UpdateAsync(editModel.Id, editModel.Name, editModel.AccountTypeGroupId);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editModel = null;
        showEditor = false;
        successMessage = "Account type updated.";
        await LoadListAsync();
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete this account type? (ID {id})");
        if (!confirmed)
            return;

        var result = await AccountTypesApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedAccountType?.Id == id)
            selectedAccountType = null;

        if (editModel?.Id == id)
            editModel = null;

        successMessage = "Account type deleted.";

        await LoadListAsync();
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public int AccountTypeGroupId { get; set; }
    }

    private sealed class EditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int AccountTypeGroupId { get; set; }
    }
}
