@page "/account-types"
@attribute [Authorize]
@inject IAccountTypesApiClient AccountTypesApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Account Types</PageTitle>

<h1>Account Types</h1>

<ErrorState Message="@errorMessage" />
<ValidationSummaryPanel Errors="@validationErrors" />

<section class="mb-4">
    <h2>Create</h2>
    <EditForm Model="createModel" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="name">Name</label>
                <InputText id="name" class="form-control" @bind-Value="createModel.Name" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Create</button>
            </div>
        </div>
    </EditForm>
</section>

<section class="mb-4">
    <h2>Edit</h2>
    @if (editModel is null)
    {
        <p><em>Select Edit from the list to modify an account type.</em></p>
    }
    else
    {
        <EditForm Model="editModel" OnValidSubmit="UpdateAsync">
            <DataAnnotationsValidator />
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="editName">Name</label>
                    <InputText id="editName" class="form-control" @bind-Value="editModel.Name" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Update</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
</section>

<section class="mb-4">
    <h2>List</h2>
    <LoadingState IsVisible="@isLoading" />
    <EmptyState IsVisible="@(!isLoading && accountTypes.Count == 0)" Message="No account types found." />

    @if (accountTypes.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in accountTypes)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadDetailAsync(item.Id)">View</button>
                            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => StartEdit(item)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(item.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Detail</h2>
    <p><em>Select View from the list to load detail from <code>GET /api/accounttypes/{id}</code>.</em></p>

    @if (selectedAccountType is not null)
    {
        <dl>
            <dt>ID</dt>
            <dd>@selectedAccountType.Id</dd>
            <dt>Name</dt>
            <dd>@selectedAccountType.Name</dd>
        </dl>
    }
</section>

@code {
    private readonly CreateModel createModel = new();
    private readonly List<AccountTypeResponse> accountTypes = [];
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();
    private AccountTypeResponse? selectedAccountType;
    private EditModel? editModel;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadListAsync();

    private async Task LoadListAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            accountTypes.Clear();
            accountTypes.AddRange(await AccountTypesApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDetailAsync(int id)
    {
        errorMessage = null;

        try
        {
            selectedAccountType = await AccountTypesApiClient.GetByIdAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountTypesApiClient.CreateAsync(createModel.Name);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createModel.Name = string.Empty;
        await LoadListAsync();
    }

    private void StartEdit(AccountTypeResponse accountType)
    {
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editModel = new EditModel
        {
            Id = accountType.Id,
            Name = accountType.Name
        };
    }

    private void CancelEdit() => editModel = null;

    private async Task UpdateAsync()
    {
        if (editModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await AccountTypesApiClient.UpdateAsync(editModel.Id, editModel.Name);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editModel = null;
        await LoadListAsync();
    }

    private async Task DeleteAsync(int id)
    {
        errorMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete account type #{id}?");
        if (!confirmed)
            return;

        var result = await AccountTypesApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        if (selectedAccountType?.Id == id)
            selectedAccountType = null;

        if (editModel?.Id == id)
            editModel = null;

        await LoadListAsync();
    }

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
    }

    private sealed class EditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
