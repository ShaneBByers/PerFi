@page "/projection/{Section?}"
@attribute [Authorize]
@inject INetWorthProjectionApiClient NetWorthProjectionApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IAccountContributionPlansApiClient AccountContributionPlansApiClient
@inject IContributionsApiClient ContributionsApiClient
@inject IToastService ToastService

<PageTitle>Projection</PageTitle>

<div class="projection-page">
    <header class="projection-hero">
        <div class="hero-top">
            <div class="hero-headline">
                <span class="hero-eyebrow">Projection</span>
                <strong class="hero-figure">@FormatCurrency(currentTotalNetWorth)</strong>
                @if (heroAsOfDate is not null)
                {
                    <span class="hero-asof">as of @heroAsOfDate.Value.ToString("MMM d, yyyy")</span>
                }
            </div>

            @if (groupNames.Count > 0)
            {
                <div class="hero-second-metric">
                    <select class="form-select form-select-sm hero-group-select" @bind="selectedHeroGroupName" aria-label="Second projection metric">
                        @foreach (var groupName in groupNames)
                        {
                            <option value="@groupName">@groupName</option>
                        }
                    </select>
                    <strong class="hero-figure hero-figure-secondary">@FormatCurrency(GetHeroSecondMetricValue())</strong>
                </div>
            }

            <div class="hero-sparkline" aria-hidden="true">
                @if (totalTrendPoints.Count > 1)
                {
                    <ApexChart @key="useTodaysDollars" TItem="TrendPoint" Height="64" Options="@CreateSparklineChartOptions()">
                        <ApexPointSeries TItem="TrendPoint" Items="totalTrendPoints" Name="Actual" SeriesType="SeriesType.Line" XValue="point => point.Label" YValue="point => point.ActualFinal" />
                        <ApexPointSeries TItem="TrendPoint" Items="totalTrendPoints" Name="Projected" SeriesType="SeriesType.Line" XValue="point => point.Label" YValue="point => point.ProjectedFinal" />
                    </ApexChart>
                }
            </div>
        </div>

        <div class="hero-chips" aria-label="Projection highlights">
            @foreach (var chip in GetHeroChips())
            {
                <article class="hero-chip">
                    <span class="hero-chip-label">@chip.Label</span>
                    <div class="hero-chip-metric">
                        <span class="hero-chip-metric-name">Total</span>
                        <strong class="@chip.TotalValueClass">@chip.TotalDisplay</strong>
                    </div>
                    @if (chip.GroupDisplay is not null)
                    {
                        <div class="hero-chip-metric">
                            <span class="hero-chip-metric-name">@selectedHeroGroupName</span>
                            <strong class="@chip.GroupValueClass">@chip.GroupDisplay</strong>
                        </div>
                    }
                </article>
            }
        </div>

        <div class="hero-actions">
            <div class="filter-presets" role="toolbar" aria-label="Dollar view">
                <button class="@GetDollarViewClass(false)" type="button" @onclick="() => SetDollarView(false)">Nominal</button>
                <button class="@GetDollarViewClass(true)" type="button" @onclick="() => SetDollarView(true)">Today's Dollars</button>
            </div>
        </div>
    </header>

    <LoadingState IsVisible="@isLoading" />
    <EmptyState IsVisible="@(!isLoading && !hasLoadError && yearRows.Count == 0)" Message="Add accounts, a net worth entry, and complete Settings to see a projection." />

    @if (!isLoading && yearRows.Count > 0)
    {
        <div class="projection-shell">
            <div class="projection-content">
                @if (activeSection == "trends")
                {
                    <section class="chart-panel">
                        <div class="section-header">
                            <h2>Composition Over Time (Annual)</h2>
                        </div>
                        <ApexChart @key="useTodaysDollars" TItem="CompositionPoint" Title="Net Worth Composition by Account Type" Height="320" Options="@CreateCompositionChartOptions()">
                            @foreach (var groupName in activeGroupNames)
                            {
                                <ApexPointSeries TItem="CompositionPoint"
                                                 Items="compositionPoints"
                                                 Name="@groupName"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="point => point.Label"
                                                 YValue="point => point.GetValue(groupName)" />
                            }
                        </ApexChart>
                    </section>

                    @foreach (var groupChart in groupTrendCharts)
                    {
                        <section class="chart-panel">
                            <div class="section-header">
                                <h2>@groupChart.GroupName Trend (Annual)</h2>
                            </div>
                            <ApexChart @key="@($"{groupChart.GroupName}-{useTodaysDollars}")" TItem="TrendPoint" Title="@($"{groupChart.GroupName}: Contributions & Growth")" Height="320" Options="@CreateTrendChartOptions()">
                                <ApexPointSeries TItem="TrendPoint" Items="groupChart.Points" Name="Contributed" SeriesType="SeriesType.Bar" XValue="point => point.Label" YValue="point => point.Contributed" />
                                <ApexPointSeries TItem="TrendPoint" Items="groupChart.Points" Name="Growth" SeriesType="SeriesType.Bar" XValue="point => point.Label" YValue="point => point.Growth" />
                            </ApexChart>
                        </section>
                    }
                }

                @if (activeSection == "detail")
                {
                    <section class="panel">
                        <div class="section-header group-select-header">
                            <div>
                                <h2>@selectedGroupName Detail (@(useTodaysDollars ? "Today's Dollars" : "Nominal"))</h2>
                                <p>Click a year to expand quarterly detail.</p>
                            </div>
                            <select class="form-select group-select" @bind="selectedGroupName" @bind:after="OnGroupSelectionChanged">
                                <option value="Total">Total</option>
                                @foreach (var groupName in detailGroupNames)
                                {
                                    <option value="@groupName">@groupName</option>
                                }
                            </select>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle projection-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Period</th>
                                        <th>Age</th>
                                        <th class="text-end">Salary</th>
                                        <th class="text-end">Starting</th>
                                        <th class="text-end">Contributed</th>
                                        <th class="text-end">Growth</th>
                                        <th class="text-end">Final</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in yearRows)
                                    {
                                        var annualAmounts = GetAmounts(GetGroup(row.Annual, selectedGroupName));
                                        <tr class="year-row" @onclick="() => ToggleYear(row.Annual.CalendarYear)">
                                            <td>
                                                <span class="expand-toggle @(IsExpanded(row.Annual.CalendarYear) ? "expanded" : null)" aria-hidden="true">&#9656;</span>
                                            </td>
                                            <td>@row.Annual.CalendarYear</td>
                                            <td>@row.Annual.UserAgeAtStart</td>
                                            <td class="text-end">@FormatCurrency(row.Annual.SalaryAtStart)</td>
                                            <td class="text-end">@FormatCurrency(annualAmounts.StartingAmount)</td>
                                            <td class="text-end">@FormatCurrency(annualAmounts.ContributedAmount)</td>
                                            <td class="text-end @GetAmountClass(annualAmounts.GrowthAmount)">@FormatCurrency(annualAmounts.GrowthAmount)</td>
                                            <td class="text-end">@FormatCurrency(annualAmounts.FinalAmount)</td>
                                            <td><span class="@(row.Annual.IsProjected ? "badge-projected" : "badge-actual")">@(row.Annual.IsProjected ? "Projected" : "Actual")</span></td>
                                        </tr>

                                        @if (IsExpanded(row.Annual.CalendarYear))
                                        {
                                            @foreach (var quarter in row.Quarters)
                                            {
                                                var quarterAmounts = GetAmounts(GetGroup(quarter, selectedGroupName));
                                                <tr class="quarter-row">
                                                    <td></td>
                                                    <td>
                                                        Q@(quarter.Quarter)
                                                        <div class="period-range">@quarter.PeriodStart.ToString("MMM d") &ndash; @quarter.PeriodEnd.ToString("MMM d")</div>
                                                    </td>
                                                    <td>@FormatAge(quarter.FractionalAge)</td>
                                                    <td class="text-end">@FormatCurrency(quarter.SalaryAtStart)</td>
                                                    <td class="text-end">@FormatCurrency(quarterAmounts.StartingAmount)</td>
                                                    <td class="text-end">@FormatCurrency(quarterAmounts.ContributedAmount)</td>
                                                    <td class="text-end @GetAmountClass(quarterAmounts.GrowthAmount)">@FormatCurrency(quarterAmounts.GrowthAmount)</td>
                                                    <td class="text-end">@FormatCurrency(quarterAmounts.FinalAmount)</td>
                                                    <td><span class="@(quarter.IsProjected ? "badge-projected" : "badge-actual")">@(quarter.IsProjected ? "Projected" : "Actual")</span></td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    @if (accuracyRows.Count > 0)
                    {
                        <section class="panel">
                            <div class="section-header">
                                <h2>Projection Accuracy: @selectedGroupName</h2>
                                <p>How past projections compared to what actually happened, once each year completed.</p>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Year</th>
                                            <th class="text-end">Expected</th>
                                            <th class="text-end">Actual</th>
                                            <th class="text-end">Variance</th>
                                            <th class="text-end">Variance %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in accuracyRows)
                                        {
                                            <tr>
                                                <td>@row.Year</td>
                                                <td class="text-end">@FormatCurrency(row.ExpectedFinal)</td>
                                                <td class="text-end">@FormatCurrency(row.ActualFinal)</td>
                                                <td class="text-end @GetAmountClass(row.VarianceAmount)">@FormatCurrency(row.VarianceAmount)</td>
                                                <td class="text-end @GetAmountClass(row.VarianceAmount)">@row.VariancePercent.ToString("+0.0%;-0.0%;0.0%")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly List<ProjectionPeriodResponse> allPeriods = [];
    private readonly List<string> groupNames = [];
    private readonly List<string> activeGroupNames = [];
    private readonly List<string> detailGroupNames = [];
    private readonly HashSet<string> qualifyingGroupNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> contributionQualifyingGroupNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<YearRow> yearRows = [];
    private readonly HashSet<int> expandedYears = [];
    private List<CompositionPoint> compositionPoints = [];
    private List<TrendPoint> totalTrendPoints = [];
    private readonly List<GroupTrendChart> groupTrendCharts = [];
    private readonly List<AccuracyRow> accuracyRows = [];
    private string selectedGroupName = "Total";
    private string selectedHeroGroupName = string.Empty;
    private string activeSection = "trends";
    private bool useTodaysDollars;
    private bool isLoading = true;
    private bool hasLoadError;
    private decimal currentTotalNetWorth;
    private DateOnly? heroAsOfDate;
    private ProjectionPeriodResponse? latestHistoricalQuarter;
    private int retirementAge;
    private int yearsToRetirement;

    private const string CurrencyFormatter = "function (value) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(value); }";

    [Parameter]
    public string? Section { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override void OnParametersSet() => activeSection = Section ?? "trends";

    private async Task LoadAsync()
    {
        isLoading = true;
        hasLoadError = false;

        try
        {
            var periodsTask = NetWorthProjectionApiClient.GetProjectionAsync();
            var qualifyingGroupNamesTask = LoadQualifyingGroupNamesAsync();

            allPeriods.Clear();
            allPeriods.AddRange(await periodsTask);

            var (chartQualifying, contributionQualifying) = await qualifyingGroupNamesTask;

            qualifyingGroupNames.Clear();
            qualifyingGroupNames.UnionWith(chartQualifying);

            contributionQualifyingGroupNames.Clear();
            contributionQualifyingGroupNames.UnionWith(contributionQualifying);

            RebuildDerivedData();
        }
        catch (Exception ex)
        {
            hasLoadError = true;
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RebuildDerivedData()
    {
        groupNames.Clear();
        groupNames.AddRange(allPeriods
            .SelectMany(period => period.Groups)
            .Select(group => group.GroupName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase));

        detailGroupNames.Clear();
        detailGroupNames.AddRange(groupNames.Where(contributionQualifyingGroupNames.Contains));

        if (selectedGroupName != "Total" && !detailGroupNames.Contains(selectedGroupName, StringComparer.OrdinalIgnoreCase))
            selectedGroupName = "Total";

        if (string.IsNullOrEmpty(selectedHeroGroupName) || !groupNames.Contains(selectedHeroGroupName, StringComparer.OrdinalIgnoreCase))
            selectedHeroGroupName = groupNames.FirstOrDefault() ?? string.Empty;

        activeGroupNames.Clear();
        activeGroupNames.AddRange(groupNames.Where(qualifyingGroupNames.Contains));

        yearRows.Clear();
        foreach (var year in allPeriods.Select(period => period.CalendarYear).Distinct().OrderBy(year => year))
        {
            var annual = allPeriods.FirstOrDefault(period => period.PeriodType == ProjectionPeriodType.Annual && period.CalendarYear == year);
            if (annual is null)
                continue;

            var quarters = allPeriods
                .Where(period => period.PeriodType == ProjectionPeriodType.Quarterly && period.CalendarYear == year)
                .OrderBy(period => period.Quarter)
                .ToList();

            yearRows.Add(new YearRow(annual, quarters));
        }

        latestHistoricalQuarter = allPeriods
            .Where(period => period.PeriodType == ProjectionPeriodType.Quarterly && !period.IsProjected)
            .OrderByDescending(period => period.PeriodEnd)
            .FirstOrDefault();

        RebuildDollarViewDependentData();
    }

    private void OnGroupSelectionChanged() => RebuildAccuracyRows();

    private void RebuildDollarViewDependentData()
    {
        RebuildCompositionPoints();
        RebuildTotalTrendPoints();
        RebuildGroupTrendCharts();
        RebuildHeroMetrics();
        RebuildAccuracyRows();
    }

    private void RebuildCompositionPoints()
    {
        var points = new List<CompositionPoint>();

        foreach (var row in yearRows)
        {
            var amountsByGroup = row.Annual.Groups.ToDictionary(
                group => group.GroupName,
                group => GetAmounts(group).FinalAmount,
                StringComparer.OrdinalIgnoreCase);

            points.Add(new CompositionPoint(row.Annual.CalendarYear.ToString(), amountsByGroup));
        }

        // reassign (not mutate in place) so ApexCharts sees a new list reference and redraws
        compositionPoints = points;
    }

    private List<TrendPoint> BuildTrendPoints(string groupName)
    {
        var points = new List<TrendPoint>();

        foreach (var row in yearRows)
        {
            var amounts = GetAmounts(GetGroup(row.Annual, groupName));

            points.Add(new TrendPoint
            {
                Label = row.Annual.CalendarYear.ToString(),
                Contributed = amounts.ContributedAmount,
                Growth = amounts.GrowthAmount,
                ActualFinal = row.Annual.IsProjected ? null : amounts.FinalAmount,
                ProjectedFinal = row.Annual.IsProjected ? amounts.FinalAmount : null
            });
        }

        // bridge the actual/projected series so the line connects at the historical-to-projected transition
        for (var index = 1; index < points.Count; index++)
        {
            if (points[index].ProjectedFinal is not null && points[index - 1] is { ActualFinal: not null, ProjectedFinal: null } previous)
                previous.ProjectedFinal = previous.ActualFinal;
        }

        return points;
    }

    private void RebuildTotalTrendPoints()
    {
        // reassign (not mutate in place) so ApexCharts sees a new list reference and redraws
        totalTrendPoints = BuildTrendPoints("Total");
    }

    private void RebuildGroupTrendCharts()
    {
        groupTrendCharts.Clear();

        foreach (var groupName in activeGroupNames)
            groupTrendCharts.Add(new GroupTrendChart(groupName, BuildTrendPoints(groupName)));
    }

    // a group is only chart-worthy if it has at least 1 account with a nonzero growth % and/or an AccountContributionPlan defined;
    // the Details dropdown instead only cares whether a group has actual contributions or a contribution plan (growth % alone doesn't qualify)
    private async Task<(HashSet<string> ChartQualifying, HashSet<string> ContributionQualifying)> LoadQualifyingGroupNamesAsync(CancellationToken cancellationToken = default)
    {
        var accountsTask = AccountsApiClient.GetAllAsync(cancellationToken);
        var contributionsTask = ContributionsApiClient.GetAllAsync(cancellationToken);

        var accounts = await accountsTask;
        var contributedAccountIds = (await contributionsTask).Select(contribution => contribution.Account.Id).ToHashSet();

        var accountsWithPlanCounts = await Task.WhenAll(accounts.Select(async account =>
            (Account: account, PlanCount: (await AccountContributionPlansApiClient.GetAllByAccountIdAsync(account.Id, cancellationToken)).Count)));

        // projection GroupName is the AccountType name, not the AccountTypeGroup name
        var chartQualifying = accountsWithPlanCounts
            .Where(x => x.Account.ExpectedAnnualGrowthPercentage != 0m || x.PlanCount > 0)
            .Select(x => x.Account.Type.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var contributionQualifying = accountsWithPlanCounts
            .Where(x => x.PlanCount > 0 || contributedAccountIds.Contains(x.Account.Id))
            .Select(x => x.Account.Type.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return (chartQualifying, contributionQualifying);
    }

    private void RebuildAccuracyRows()
    {
        accuracyRows.Clear();

        foreach (var row in yearRows.Where(row => !row.Annual.IsProjected))
        {
            var group = GetGroup(row.Annual, selectedGroupName);
            var expected = GetExpectedAmounts(group);
            if (expected is null)
                continue;

            var actualFinal = GetAmounts(group).FinalAmount;
            var varianceAmount = actualFinal - expected.FinalAmount;
            var variancePercent = expected.FinalAmount == 0m ? 0m : varianceAmount / expected.FinalAmount;

            accuracyRows.Add(new AccuracyRow(row.Annual.CalendarYear, expected.FinalAmount, actualFinal, varianceAmount, variancePercent));
        }
    }

    private void RebuildHeroMetrics()
    {
        var lastAnnual = yearRows.Count > 0 ? yearRows[^1].Annual : null;

        currentTotalNetWorth = latestHistoricalQuarter is null ? 0m : GetAmounts(GetGroup(latestHistoricalQuarter, "Total")).FinalAmount;
        heroAsOfDate = latestHistoricalQuarter?.PeriodEnd;
        retirementAge = lastAnnual?.UserAgeAtEnd ?? 0;
        yearsToRetirement = lastAnnual is not null && latestHistoricalQuarter is not null
            ? Math.Max(0, lastAnnual.UserAgeAtEnd - latestHistoricalQuarter.UserAgeAtEnd)
            : 0;
    }

    private static ProjectionGroupResponse GetGroup(ProjectionPeriodResponse period, string groupName)
    {
        if (groupName == "Total")
            return period.Total;

        return period.Groups.FirstOrDefault(group => string.Equals(group.GroupName, groupName, StringComparison.OrdinalIgnoreCase)) ?? period.Total;
    }

    private ProjectionAmountsResponse GetAmounts(ProjectionGroupResponse group) =>
        useTodaysDollars ? group.AmountsInTodaysDollars : group.Amounts;

    private ProjectionAmountsResponse? GetExpectedAmounts(ProjectionGroupResponse group) =>
        useTodaysDollars ? group.ExpectedAmountsInTodaysDollars : group.ExpectedAmounts;

    private decimal GetHeroSecondMetricValue() =>
        latestHistoricalQuarter is null ? 0m : GetAmounts(GetGroup(latestHistoricalQuarter, selectedHeroGroupName)).FinalAmount;

    private IReadOnlyList<ProjectionHeroChip> GetHeroChips()
    {
        var lastAnnual = yearRows.Count > 0 ? yearRows[^1].Annual : null;

        var totalAtRetirement = lastAnnual is null ? 0m : GetAmounts(GetGroup(lastAnnual, "Total")).FinalAmount;
        var groupAtRetirement = lastAnnual is null ? 0m : GetAmounts(GetGroup(lastAnnual, selectedHeroGroupName)).FinalAmount;

        var projectedAnnuals = allPeriods.Where(period => period.PeriodType == ProjectionPeriodType.Annual && period.IsProjected).ToList();
        var totalGrowth = projectedAnnuals.Sum(period => GetAmounts(GetGroup(period, "Total")).GrowthAmount);
        var groupGrowth = projectedAnnuals.Sum(period => GetAmounts(GetGroup(period, selectedHeroGroupName)).GrowthAmount);

        return
        [
            new ProjectionHeroChip($"Projected at Retirement (Age {retirementAge})", FormatCurrency(totalAtRetirement), string.Empty, FormatCurrency(groupAtRetirement), string.Empty),
            new ProjectionHeroChip("Total Projected Growth", FormatCurrency(totalGrowth), GetAmountClass(totalGrowth), FormatCurrency(groupGrowth), GetAmountClass(groupGrowth)),
            new ProjectionHeroChip("Years to Retirement", yearsToRetirement.ToString(), string.Empty, null, null)
        ];
    }

    private void SetDollarView(bool todaysDollars)
    {
        useTodaysDollars = todaysDollars;
        RebuildDollarViewDependentData();
    }

    private string GetDollarViewClass(bool todaysDollars) =>
        useTodaysDollars == todaysDollars ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-secondary";

    private void ToggleYear(int year)
    {
        if (!expandedYears.Add(year))
            expandedYears.Remove(year);
    }

    private bool IsExpanded(int year) => expandedYears.Contains(year);

    private static string FormatCurrency(decimal value) => value.ToString("C");

    private static string FormatAge(decimal fractionalAge)
    {
        var wholeYears = decimal.ToInt32(Math.Floor(fractionalAge));
        var quarters = decimal.ToInt32(Math.Round((fractionalAge - wholeYears) * 4, MidpointRounding.AwayFromZero));

        return quarters switch
        {
            1 => $"{wholeYears} \u00bc",
            2 => $"{wholeYears} \u00bd",
            3 => $"{wholeYears} \u00be",
            _ => $"{wholeYears}"
        };
    }

    private static string GetAmountClass(decimal value) => value switch
    {
        > 0m => "amount-positive",
        < 0m => "amount-negative",
        _ => "amount-muted"
    };

    private static ApexChartOptions<CompositionPoint> CreateCompositionChartOptions() => new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Stacked = true,
            Zoom = new Zoom { Enabled = false },
            Selection = new Selection { Enabled = false }
        },
        Xaxis = new XAxis { TickPlacement = TickPlacement.On },
        Yaxis = new List<YAxis> { new() { Labels = new YAxisLabels { Formatter = CurrencyFormatter } } },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = CurrencyFormatter } }
    };

    private static ApexChartOptions<TrendPoint> CreateTrendChartOptions() => new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Zoom = new Zoom { Enabled = false },
            Selection = new Selection { Enabled = false }
        },
        Xaxis = new XAxis { TickPlacement = TickPlacement.On },
        Yaxis = new List<YAxis> { new() { Labels = new YAxisLabels { Formatter = CurrencyFormatter } } },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = CurrencyFormatter } }
    };

    private static ApexChartOptions<TrendPoint> CreateSparklineChartOptions() => new()
    {
        Chart = new Chart
        {
            Sparkline = new ChartSparkline { Enabled = true },
            Animations = new Animations { Enabled = false },
            Toolbar = new Toolbar { Show = false },
            Zoom = new Zoom { Enabled = false },
            Selection = new Selection { Enabled = false }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = CurrencyFormatter } }
    };

    private sealed record YearRow(ProjectionPeriodResponse Annual, IReadOnlyList<ProjectionPeriodResponse> Quarters);

    private sealed record CompositionPoint(string Label, IReadOnlyDictionary<string, decimal> AmountsByGroup)
    {
        public decimal GetValue(string groupName) => AmountsByGroup.TryGetValue(groupName, out var value) ? value : 0m;
    }

    private sealed class TrendPoint
    {
        public required string Label { get; init; }
        public decimal Contributed { get; init; }
        public decimal Growth { get; init; }
        public decimal? ActualFinal { get; set; }
        public decimal? ProjectedFinal { get; set; }
    }

    private sealed record GroupTrendChart(string GroupName, IReadOnlyList<TrendPoint> Points);

    private sealed record AccuracyRow(int Year, decimal ExpectedFinal, decimal ActualFinal, decimal VarianceAmount, decimal VariancePercent);

    private sealed record ProjectionHeroChip(string Label, string TotalDisplay, string TotalValueClass, string? GroupDisplay, string? GroupValueClass);
}
