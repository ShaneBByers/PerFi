@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <InputText id="password" class="form-control" type="password" @bind-Value="loginModel.Password" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">Login</button>
</EditForm>

@code {
    private readonly LoginModel loginModel = new();
    private bool isSubmitting;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
            NavigationManager.NavigateTo(GetDestinationUrl(), forceLoad: false);
    }

    private async Task HandleLoginAsync()
    {
        isSubmitting = true;

        var result = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage);
            return;
        }

        NavigationManager.NavigateTo(GetDestinationUrl(), forceLoad: false);
    }

    private string GetDestinationUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
            return "/";

        if (!ReturnUrl.StartsWith('/'))
            return "/";

        return ReturnUrl;
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
