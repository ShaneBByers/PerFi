@page "/settings"
@attribute [Authorize]
@inject IUserConfigurationApiClient UserConfigurationApiClient
@inject ISalaryProgressionsApiClient SalaryProgressionsApiClient

<PageTitle>Settings</PageTitle>

<div class="crud-page">
    <header class="page-hero">
        <div>
            <h1>Settings</h1>
            <p>Configure your personal projection assumptions and salary history.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadAllAsync" disabled="@isLoading">Refresh</button>
        </div>
    </header>

    <ErrorState Message="@errorMessage" />
    <ValidationSummaryPanel Errors="@validationErrors" />

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="panel">
        <div class="section-header">
            <h2>@(userConfiguration is null ? "Add User Configuration" : "Edit User Configuration")</h2>
            <p>Birth date and pay cycle drive age and pay-period calculations; the percentages drive future projections.</p>
        </div>

        <LoadingState IsVisible="@isLoading" />

        @if (!isLoading)
        {
            <EditForm Model="userConfigurationModel" OnValidSubmit="SaveUserConfigurationAsync">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="birthDate">Birth Date</label>
                        <InputDate id="birthDate" class="form-control" @bind-Value="userConfigurationModel.BirthDate" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="payCycleType">Pay Cycle</label>
                        <InputSelect id="payCycleType" class="form-select" @bind-Value="userConfigurationModel.PayCycleType">
                            @foreach (var payCycleType in Enum.GetValues<PayCycleType>())
                            {
                                <option value="@payCycleType">@payCycleType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="referencePayDate">Reference Pay Date</label>
                        <InputDate id="referencePayDate" class="form-control" @bind-Value="userConfigurationModel.ReferencePayDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="salaryRaise">Expected Annual Salary Raise %</label>
                        <InputNumber id="salaryRaise" class="form-control" @bind-Value="userConfigurationModel.ExpectedAnnualSalaryRaisePercentage" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="inflation">Expected Annual Inflation %</label>
                        <InputNumber id="inflation" class="form-control" @bind-Value="userConfigurationModel.ExpectedAnnualInflationPercentage" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save</button>
                </div>
            </EditForm>
        }
    </section>

    <section class="panel">
        <div class="section-header">
            <h2>Salary Progression</h2>
            <p>Track dated salary entries used for historical and future salary projections.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel nested-panel h-100">
                    <div class="section-header">
                        <h3>@(editSalaryProgressionModel is null ? "Add Salary Entry" : "Edit Salary Entry")</h3>
                    </div>

                    @if (editSalaryProgressionModel is null)
                    {
                        <EditForm Model="createSalaryProgressionModel" OnValidSubmit="CreateSalaryProgressionAsync">
                            <DataAnnotationsValidator />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="effectiveDate">Effective Date</label>
                                    <InputDate id="effectiveDate" class="form-control" @bind-Value="createSalaryProgressionModel.EffectiveDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="annualSalary">Annual Salary</label>
                                    <InputNumber id="annualSalary" class="form-control" @bind-Value="createSalaryProgressionModel.AnnualSalary" />
                                </div>
                                <div class="col-12 d-flex gap-2 flex-wrap">
                                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Add Entry</button>
                                </div>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="editSalaryProgressionModel" OnValidSubmit="UpdateSalaryProgressionAsync">
                            <DataAnnotationsValidator />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="editEffectiveDate">Effective Date</label>
                                    <InputDate id="editEffectiveDate" class="form-control" @bind-Value="editSalaryProgressionModel.EffectiveDate" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="editAnnualSalary">Annual Salary</label>
                                    <InputNumber id="editAnnualSalary" class="form-control" @bind-Value="editSalaryProgressionModel.AnnualSalary" />
                                </div>
                                <div class="col-12 d-flex gap-2 flex-wrap">
                                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelSalaryProgressionEdit">Cancel</button>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>

            <div class="col-lg-7">
                <div class="panel nested-panel h-100">
                    <div class="section-header">
                        <h3>Salary History</h3>
                    </div>

                    <LoadingState IsVisible="@isLoading" />
                    <EmptyState IsVisible="@(!isLoading && salaryProgressions.Count == 0)" Message="No salary entries yet." />

                    @if (salaryProgressions.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Effective Date</th>
                                        <th>Annual Salary</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var salaryProgression in salaryProgressions)
                                    {
                                        <tr>
                                            <td>@salaryProgression.EffectiveDate</td>
                                            <td>@salaryProgression.AnnualSalary.ToString("C")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditSalaryProgression(salaryProgression)">Edit</button>
                                                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteSalaryProgressionAsync(salaryProgression.Id)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly List<SalaryProgressionResponse> salaryProgressions = [];
    private readonly UserConfigurationModel userConfigurationModel = new();
    private readonly CreateSalaryProgressionModel createSalaryProgressionModel = new();
    private EditSalaryProgressionModel? editSalaryProgressionModel;
    private UserConfigurationResponse? userConfiguration;

    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? successMessage;
    private IReadOnlyDictionary<string, string[]> validationErrors = new Dictionary<string, string[]>();

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            userConfiguration = await UserConfigurationApiClient.GetAsync();
            if (userConfiguration is not null)
            {
                userConfigurationModel.BirthDate = userConfiguration.BirthDate;
                userConfigurationModel.PayCycleType = userConfiguration.PayCycleType;
                userConfigurationModel.ReferencePayDate = userConfiguration.ReferencePayDate;
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage = userConfiguration.ExpectedAnnualSalaryRaisePercentage;
                userConfigurationModel.ExpectedAnnualInflationPercentage = userConfiguration.ExpectedAnnualInflationPercentage;
            }

            salaryProgressions.Clear();
            salaryProgressions.AddRange(await SalaryProgressionsApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveUserConfigurationAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = userConfiguration is null
            ? await UserConfigurationApiClient.CreateAsync(new CreateUserConfigurationRequest(
                userConfigurationModel.BirthDate,
                userConfigurationModel.PayCycleType,
                userConfigurationModel.ReferencePayDate,
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage,
                userConfigurationModel.ExpectedAnnualInflationPercentage))
            : await UserConfigurationApiClient.UpdateAsync(userConfiguration.Id, new UpdateUserConfigurationRequest(
                userConfigurationModel.BirthDate,
                userConfigurationModel.PayCycleType,
                userConfigurationModel.ReferencePayDate,
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage,
                userConfigurationModel.ExpectedAnnualInflationPercentage));

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        successMessage = "User configuration saved.";
        await LoadAllAsync();
    }

    private async Task CreateSalaryProgressionAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await SalaryProgressionsApiClient.CreateAsync(createSalaryProgressionModel.EffectiveDate, createSalaryProgressionModel.AnnualSalary);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        createSalaryProgressionModel.EffectiveDate = default;
        createSalaryProgressionModel.AnnualSalary = 0;
        successMessage = "Salary entry saved.";
        await LoadAllAsync();
    }

    private void StartEditSalaryProgression(SalaryProgressionResponse salaryProgression)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();
        editSalaryProgressionModel = new EditSalaryProgressionModel
        {
            Id = salaryProgression.Id,
            EffectiveDate = salaryProgression.EffectiveDate,
            AnnualSalary = salaryProgression.AnnualSalary
        };
    }

    private void CancelSalaryProgressionEdit() => editSalaryProgressionModel = null;

    private async Task UpdateSalaryProgressionAsync()
    {
        if (editSalaryProgressionModel is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await SalaryProgressionsApiClient.UpdateAsync(editSalaryProgressionModel.Id, editSalaryProgressionModel.EffectiveDate, editSalaryProgressionModel.AnnualSalary);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        editSalaryProgressionModel = null;
        successMessage = "Salary entry updated.";
        await LoadAllAsync();
    }

    private async Task DeleteSalaryProgressionAsync(int id)
    {
        errorMessage = null;
        successMessage = null;
        validationErrors = new Dictionary<string, string[]>();

        var result = await SalaryProgressionsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
            validationErrors = result.ValidationErrors ?? new Dictionary<string, string[]>();
            return;
        }

        successMessage = "Salary entry deleted.";
        await LoadAllAsync();
    }

    private sealed class UserConfigurationModel
    {
        public DateOnly BirthDate { get; set; }
        public PayCycleType PayCycleType { get; set; }
        public DateOnly ReferencePayDate { get; set; }
        public decimal ExpectedAnnualSalaryRaisePercentage { get; set; }
        public decimal ExpectedAnnualInflationPercentage { get; set; }
    }

    private sealed class CreateSalaryProgressionModel
    {
        public DateOnly EffectiveDate { get; set; }
        public decimal AnnualSalary { get; set; }
    }

    private sealed class EditSalaryProgressionModel
    {
        public int Id { get; set; }
        public DateOnly EffectiveDate { get; set; }
        public decimal AnnualSalary { get; set; }
    }
}
