    private async Task MoveWithinParentAsync<T>(List<T> items, int parentId, Func<T, int> parentIdSelector, int id, int delta, Func<T, int> idSelector, Func<IReadOnlyList<int>, Task<ApiResult>> persistAsync, string successText)
    {

        var parentItems = items.Where(item => parentIdSelector(item) == parentId).ToList();
        if (!TryMove(parentItems, idSelector, id, delta))
            return;

        var result = await persistAsync(parentItems.Select(idSelector).ToList());

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage);
            await LoadAllAsync();
            return;
        }

        ToastService.ShowSuccess(successText);
        await LoadAllAsync();
    }

    private async Task MoveAndPersistAsync<T>(List<T> items, int id, int delta, Func<T, int> idSelector, Func<IReadOnlyList<int>, Task<ApiResult>> persistAsync, string successText)
    {

        if (!TryMove(items, idSelector, id, delta))
            return;

        var orderedIds = items.Select(idSelector).ToList();
        var result = await persistAsync(orderedIds);

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage);
            await LoadAllAsync();
            return;
        }

        ToastService.ShowSuccess(successText);
        await LoadAllAsync();
    }

    private static bool TryMove<T>(List<T> items, Func<T, int> idSelector, int id, int delta)
    {
        var currentIndex = items.FindIndex(item => idSelector(item) == id);
        var targetIndex = currentIndex + delta;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= items.Count)
            return false;

        (items[currentIndex], items[targetIndex]) = (items[targetIndex], items[currentIndex]);
        return true;
    }

    private static string FormatPayCycleType(PayCycleType payCycleType) => payCycleType switch
    {
        PayCycleType.BiWeekly => "Bi-Weekly",
        PayCycleType.SemiMonthly => "Semi-Monthly",
        _ => payCycleType.ToString()
    };

