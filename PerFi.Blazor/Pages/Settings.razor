    @if (selectedAccount is not null)
    {
        <EmptyState IsVisible="@(selectedAccountContributionPlans.Count == 0)" Message="No contribution plans yet." />

        @if (selectedAccountContributionPlans.Count > 0)
        {
            <ul class="relationship-list">
                @foreach (var plan in selectedAccountContributionPlans)
                {
                    <li>
                        <div class="d-flex justify-content-between gap-2 align-items-start">
                            <div class="small">
                                <strong>@plan.ContributorType</strong>
                                <div>Effective @plan.EffectiveDate.ToString("yyyy-MM-dd")</div>
                                <div>$@plan.DollarAmountPerPayCycle.ToString("0.##")/cycle (+$@plan.DollarAmountPerPayCycleAnnualIncrease.ToString("0.##")/yr)</div>
                                <div>$@plan.DollarAmountAnnual.ToString("0.##")/yr (+$@plan.DollarAmountAnnualIncrease.ToString("0.##")/yr)</div>
                                <div>@plan.PercentagePerPayCycle.ToString("0.####")%/cycle (+@plan.PercentagePerPayCycleAnnualIncrease.ToString("0.####")%/yr)</div>
                                <div>@plan.PercentageAnnual.ToString("0.####")%/yr (+@plan.PercentageAnnualIncrease.ToString("0.####")%/yr)</div>
