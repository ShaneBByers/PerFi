@page "/settings"
@attribute [Authorize]
@inject IUserConfigurationApiClient UserConfigurationApiClient
@inject ISalaryProgressionsApiClient SalaryProgressionsApiClient
@inject IAccountsApiClient AccountsApiClient
@inject IInstitutionsApiClient InstitutionsApiClient
@inject IAccountTypesApiClient AccountTypesApiClient
@inject IAccountTypeGroupsApiClient AccountTypeGroupsApiClient
@inject ITransactionCategoryGroupsApiClient TransactionCategoryGroupsApiClient
@inject ITransactionCategoriesApiClient TransactionCategoriesApiClient
@inject IAccountContributionPlansApiClient AccountContributionPlansApiClient
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <header class="page-hero">
        <div>
            <h1>Settings</h1>
            <p>Manage your profile, net worth structure, and cash flow categories in one place.</p>
        </div>
        <div class="hero-actions">
            <button class="btn btn-outline-secondary" type="button" @onclick="LoadAllAsync" disabled="@isLoading">Refresh</button>
        </div>
    </header>


    <div class="settings-shell">
        <nav class="settings-nav" aria-label="Settings sections">
            <div class="settings-nav-group">
                <div class="settings-nav-group-title">Profile</div>
                <button class="settings-nav-item @(activeSection == "profile" ? "active" : null)" type="button" @onclick='() => SetSection("profile")'>Personal Info</button>
                <button class="settings-nav-item @(activeSection == "salary" ? "active" : null)" type="button" @onclick='() => SetSection("salary")'>
                    Salary History <span class="settings-nav-count">@salaryProgressions.Count</span>
                </button>
            </div>
            <div class="settings-nav-group">
                <div class="settings-nav-group-title">Net Worth Setup</div>
                <button class="settings-nav-item @(activeSection == "accounts" ? "active" : null)" type="button" @onclick='() => SetSection("accounts")'>
                    Accounts <span class="settings-nav-count">@accounts.Count</span>
                </button>
                <button class="settings-nav-item @(activeSection == "account-types" ? "active" : null)" type="button" @onclick='() => SetSection("account-types")'>
                    Account Types <span class="settings-nav-count">@accountTypeGroups.Count</span>
                </button>
            </div>
            <div class="settings-nav-group">
                <div class="settings-nav-group-title">Cash Flow Setup</div>
                <button class="settings-nav-item @(activeSection == "transaction-categories" ? "active" : null)" type="button" @onclick='() => SetSection("transaction-categories")'>
                    Transaction Categories <span class="settings-nav-count">@transactionCategories.Count</span>
                </button>
            </div>
        </nav>

        <div class="settings-content">
            @if (activeSection == "profile")
            {
                <section class="content-section">
                    <div class="content-section-header">
                        <div>
                            <h2>Personal Info</h2>
                            <p>Birth date and pay cycle drive age and pay-period calculations; the percentages drive future projections.</p>
                        </div>
                    </div>

                    <LoadingState IsVisible="@isLoading" />

                    @if (!isLoading)
                    {
                        <EditForm Model="userConfigurationModel" OnValidSubmit="SaveUserConfigurationAsync">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="birthDate">Birth Date</label>
                                    <InputDate id="birthDate" class="form-control" @bind-Value="userConfigurationModel.BirthDate" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="payCycleType">Pay Cycle</label>
                                    <InputSelect id="payCycleType" class="form-select" @bind-Value="userConfigurationModel.PayCycleType">
                                        @foreach (var payCycleType in Enum.GetValues<PayCycleType>())
                                        {
                                            <option value="@payCycleType">@FormatPayCycleType(payCycleType)</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="referencePayDate">Reference Pay Date</label>
                                    <InputDate id="referencePayDate" class="form-control" @bind-Value="userConfigurationModel.ReferencePayDate" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="salaryRaise">Expected Annual Salary Raise %</label>
                                    <InputNumber id="salaryRaise" class="form-control" @bind-Value="userConfigurationModel.ExpectedAnnualSalaryRaisePercentage" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="inflation">Expected Annual Inflation %</label>
                                    <InputNumber id="inflation" class="form-control" @bind-Value="userConfigurationModel.ExpectedAnnualInflationPercentage" />
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save</button>
                            </div>
                        </EditForm>
                    }
                </section>
            }

            @if (activeSection == "salary")
            {
                <section class="content-section">
                    <div class="content-section-header">
                        <div>
                            <h2>Salary History</h2>
                            <p>Track dated salary entries used for historical and future salary projections.</p>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="StartCreateSalaryProgression">Add Entry</button>
                    </div>

                    <LoadingState IsVisible="@isLoading" />
                    <EmptyState IsVisible="@(!isLoading && salaryProgressions.Count == 0)" Message="No salary entries yet." />

                    @if (salaryProgressions.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle settings-table">
                                <thead>
                                    <tr>
                                        <th>Effective Date</th>
                                        <th>Annual Salary</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var salaryProgression in salaryProgressions)
                                    {
                                        <tr>
                                            <td>@salaryProgression.EffectiveDate</td>
                                            <td>@salaryProgression.AnnualSalary.ToString("C")</td>
                                            <td class="text-end">
                                                <div class="row-actions">
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditSalaryProgression(salaryProgression)">Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteSalaryProgressionAsync(salaryProgression.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (activeSection == "accounts")
            {
                <section class="content-section">
                    <div class="content-section-header">
                        <div>
                            <h2>Accounts</h2>
                            <p>Expand an institution to manage the accounts within it.</p>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="StartCreateInstitution">Add Institution</button>
                    </div>

                    <LoadingState IsVisible="@isLoading" />
                    <EmptyState IsVisible="@(!isLoading && institutions.Count == 0)" Message="No institutions yet." />

                    @if (institutions.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle settings-table">
                                <thead>
                                    <tr>
                                        <th class="order-column"><span class="visually-hidden">Reorder</span></th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Group</th>
                                        <th>Growth %</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var institution in institutions)
                                    {
                                        var institutionAccounts = accounts.Where(account => account.Institution.Id == institution.Id).ToList();
                                        var isExpanded = expandedInstitutionIds.Contains(institution.Id);
                                        <tr class="group-row">
                                            <td class="order-column">
                                                <OrderStepper OnMoveUp="() => MoveInstitutionAsync(institution.Id, -1)" OnMoveDown="() => MoveInstitutionAsync(institution.Id, 1)" />
                                            </td>
                                            <td colspan="4">
                                                <button class="btn btn-sm btn-link expand-toggle" type="button" aria-label="@(isExpanded ? "Collapse institution" : "Expand institution")" @onclick="() => ToggleInstitutionExpanded(institution.Id)">
                                                    <span class="expand-caret @(isExpanded ? "expanded" : null)">&#9656;</span>
                                                </button>
                                                <strong>@institution.Name</strong>
                                                <span class="row-subtext">(@institutionAccounts.Count account@(institutionAccounts.Count == 1 ? "" : "s"))</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="row-actions">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => StartCreateAccount(institution.Id)">Add Account</button>
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditInstitution(institution)">Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteInstitutionAsync(institution.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>

                                        @if (isExpanded)
                                        {
                                            @if (institutionAccounts.Count == 0)
                                            {
                                                <tr class="type-row">
                                                    <td></td>
                                                    <td colspan="5" class="row-subtext">No accounts at this institution yet.</td>
                                                </tr>
                                            }
                                            @foreach (var account in institutionAccounts)
                                            {
                                                <tr class="type-row">
                                                    <td class="order-column">
                                                        <OrderStepper OnMoveUp="() => MoveAccountWithinInstitutionAsync(institution.Id, account.Id, -1)" OnMoveDown="() => MoveAccountWithinInstitutionAsync(institution.Id, account.Id, 1)" />
                                                    </td>
                                                    <td class="type-name-cell">@account.Name</td>
                                                    <td>@account.Type.Name</td>
                                                    <td>@account.Type.Group.Name</td>
                                                    <td>@account.ExpectedAnnualGrowthPercentage.ToString("0.####")%</td>
                                                    <td class="text-end">
                                                        <div class="row-actions">
                                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenContributionsModalAsync(account.Id)">Contributions</button>
                                                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditAccount(account)">Edit</button>
                                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteAccountAsync(account.Id)">Delete</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (activeSection == "account-types")
            {
                <section class="content-section">
                    <div class="content-section-header">
                        <div>
                            <h2>Account Types</h2>
                            <p>Expand a group to manage the account types within it.</p>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="StartCreateAccountTypeGroup">Add Group</button>
                    </div>

                    <LoadingState IsVisible="@isLoading" />
                    <EmptyState IsVisible="@(!isLoading && accountTypeGroups.Count == 0)" Message="No account type groups yet." />

                    @if (accountTypeGroups.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle settings-table">
                                <thead>
                                    <tr>
                                        <th class="order-column"><span class="visually-hidden">Reorder</span></th>
                                        <th>Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in accountTypeGroups)
                                    {
                                        var groupTypes = accountTypes.Where(type => type.Group.Id == group.Id).ToList();
                                        var isExpanded = expandedAccountTypeGroupIds.Contains(group.Id);
                                        <tr class="group-row">
                                            <td class="order-column">
                                                <OrderStepper OnMoveUp="() => MoveAccountTypeGroupAsync(group.Id, -1)" OnMoveDown="() => MoveAccountTypeGroupAsync(group.Id, 1)" />
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-link expand-toggle" type="button" aria-label="@(isExpanded ? "Collapse group" : "Expand group")" @onclick="() => ToggleAccountTypeGroupExpanded(group.Id)">
                                                    <span class="expand-caret @(isExpanded ? "expanded" : null)">&#9656;</span>
                                                </button>
                                                <strong>@group.Name</strong>
                                                <span class="row-subtext">(@groupTypes.Count type@(groupTypes.Count == 1 ? "" : "s"))</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="row-actions">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => StartCreateAccountType(group.Id)">Add Type</button>
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditAccountTypeGroup(group)">Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteAccountTypeGroupAsync(group.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>

                                        @if (isExpanded)
                                        {
                                            @if (groupTypes.Count == 0)
                                            {
                                                <tr class="type-row">
                                                    <td></td>
                                                    <td colspan="2" class="row-subtext">No account types in this group yet.</td>
                                                </tr>
                                            }
                                            @foreach (var type in groupTypes)
                                            {
                                                <tr class="type-row">
                                                    <td class="order-column">
                                                        <OrderStepper OnMoveUp="() => MoveAccountTypeWithinGroupAsync(group.Id, type.Id, -1)" OnMoveDown="() => MoveAccountTypeWithinGroupAsync(group.Id, type.Id, 1)" />
                                                    </td>
                                                    <td class="type-name-cell">@type.Name</td>
                                                    <td class="text-end">
                                                        <div class="row-actions">
                                                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditAccountType(type)">Edit</button>
                                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteAccountTypeAsync(type.Id)">Delete</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (activeSection == "transaction-categories")
            {
                <section class="content-section">
                    <div class="content-section-header">
                        <div>
                            <h2>Transaction Categories</h2>
                            <p>Expand a group to manage the categories within it.</p>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="StartCreateTransactionCategoryGroup">Add Group</button>
                    </div>

                    <LoadingState IsVisible="@isLoading" />
                    <EmptyState IsVisible="@(!isLoading && transactionCategoryGroups.Count == 0)" Message="No transaction category groups yet." />

                    @if (transactionCategoryGroups.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle settings-table">
                                <thead>
                                    <tr>
                                        <th class="order-column"><span class="visually-hidden">Reorder</span></th>
                                        <th>Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in transactionCategoryGroups)
                                    {
                                        var groupCategories = transactionCategories.Where(category => category.Group.Id == group.Id).ToList();
                                        var isExpanded = expandedTransactionCategoryGroupIds.Contains(group.Id);
                                        <tr class="group-row">
                                            <td class="order-column">
                                                <OrderStepper OnMoveUp="() => MoveTransactionCategoryGroupAsync(group.Id, -1)" OnMoveDown="() => MoveTransactionCategoryGroupAsync(group.Id, 1)" />
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-link expand-toggle" type="button" aria-label="@(isExpanded ? "Collapse group" : "Expand group")" @onclick="() => ToggleTransactionCategoryGroupExpanded(group.Id)">
                                                    <span class="expand-caret @(isExpanded ? "expanded" : null)">&#9656;</span>
                                                </button>
                                                <strong>@group.Name</strong>
                                                <span class="row-subtext">(@groupCategories.Count categor@(groupCategories.Count == 1 ? "y" : "ies"))</span>
                                            </td>
                                            <td class="text-end">
                                                <div class="row-actions">
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => StartCreateTransactionCategory(group.Id)">Add Category</button>
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditTransactionCategoryGroup(group)">Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteTransactionCategoryGroupAsync(group.Id)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>

                                        @if (isExpanded)
                                        {
                                            @if (groupCategories.Count == 0)
                                            {
                                                <tr class="type-row">
                                                    <td></td>
                                                    <td colspan="2" class="row-subtext">No categories in this group yet.</td>
                                                </tr>
                                            }
                                            @foreach (var category in groupCategories)
                                            {
                                                <tr class="type-row">
                                                    <td class="order-column">
                                                        <OrderStepper OnMoveUp="() => MoveTransactionCategoryWithinGroupAsync(group.Id, category.Id, -1)" OnMoveDown="() => MoveTransactionCategoryWithinGroupAsync(group.Id, category.Id, 1)" />
                                                    </td>
                                                    <td class="type-name-cell">@category.Name</td>
                                                    <td class="text-end">
                                                        <div class="row-actions">
                                                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditTransactionCategory(category)">Edit</button>
                                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteTransactionCategoryAsync(category.Id)">Delete</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

<Modal Title="@(editInstitutionModel is null ? "Add Institution" : "Edit Institution")"
       IsVisible="@(isCreatingInstitution || editInstitutionModel is not null)"
       OnClose="CloseInstitutionModal">
    @if (editInstitutionModel is null)
    {
        <EditForm Model="createInstitutionModel" OnValidSubmit="CreateInstitutionAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="institutionName">Institution Name</label>
                <InputText id="institutionName" class="form-control" @bind-Value="createInstitutionModel.InstitutionName" />
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Institution</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseInstitutionModal">Cancel</button>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="editInstitutionModel" OnValidSubmit="UpdateInstitutionAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="editInstitutionName">Institution Name</label>
                <InputText id="editInstitutionName" class="form-control" @bind-Value="editInstitutionModel.InstitutionName" />
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseInstitutionModal">Cancel</button>
            </div>
        </EditForm>
    }
</Modal>

<Modal Title="@(editAccountModel is null ? "Add Account" : "Edit Account")"
       IsVisible="@(isCreatingAccount || editAccountModel is not null)"
       OnClose="CloseAccountModal">
    @if (editAccountModel is null)
    {
        <EditForm Model="createAccountModel" OnValidSubmit="CreateAccountAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="accountName">Account Name</label>
                    <InputText id="accountName" class="form-control" @bind-Value="createAccountModel.AccountName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="institution">Institution</label>
                    <InputSelect id="institution" class="form-select" @bind-Value="createAccountModel.InstitutionId">
                        <option value="0">Select institution</option>
                        @foreach (var institution in institutions)
                        {
                            <option value="@institution.Id">@institution.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="accountType">Account Type</label>
                    <InputSelect id="accountType" class="form-select" @bind-Value="createAccountModel.AccountTypeId">
                        <option value="0">Select account type</option>
                        @foreach (var accountType in accountTypes)
                        {
                            <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="accountGrowth">Expected Annual Growth %</label>
                    <InputNumber id="accountGrowth" class="form-control" @bind-Value="createAccountModel.ExpectedAnnualGrowthPercentage" />
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Account</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseAccountModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="editAccountModel" OnValidSubmit="UpdateAccountAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="editAccountName">Account Name</label>
                    <InputText id="editAccountName" class="form-control" @bind-Value="editAccountModel.AccountName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editInstitution">Institution</label>
                    <InputSelect id="editInstitution" class="form-select" @bind-Value="editAccountModel.InstitutionId">
                        <option value="0">Select institution</option>
                        @foreach (var institution in institutions)
                        {
                            <option value="@institution.Id">@institution.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editAccountType">Account Type</label>
                    <InputSelect id="editAccountType" class="form-select" @bind-Value="editAccountModel.AccountTypeId">
                        <option value="0">Select account type</option>
                        @foreach (var accountType in accountTypes)
                        {
                            <option value="@accountType.Id">@accountType.Name (@accountType.Group.Name)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editAccountGrowth">Expected Annual Growth %</label>
                    <InputNumber id="editAccountGrowth" class="form-control" @bind-Value="editAccountModel.ExpectedAnnualGrowthPercentage" />
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Changes</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseAccountModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
</Modal>

<Modal Title="@(editAccountTypeModel is null ? "Add Account Type" : "Edit Account Type")"
       IsVisible="@(isCreatingAccountType || editAccountTypeModel is not null)"
       OnClose="CloseAccountTypeModal"
       SizeClass="modal-md">
    @if (editAccountTypeModel is null)
    {
        <EditForm Model="createAccountTypeModel" OnValidSubmit="CreateAccountTypeAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="name">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="createAccountTypeModel.Name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="accountTypeGroup">Group</label>
                    <InputSelect id="accountTypeGroup" class="form-select" @bind-Value="createAccountTypeModel.AccountTypeGroupId">
                        <option value="0">Select group</option>
                        @foreach (var group in accountTypeGroups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">Save Type</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseAccountTypeModal">Cancel</button>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="editAccountTypeModel" OnValidSubmit="UpdateAccountTypeAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="editName">Name</label>
                    <InputText id="editName" class="form-control" @bind-Value="editAccountTypeModel.Name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="editAccountTypeGroup">Group</label>
                    <InputSelect id="editAccountTypeGroup" class="form-select" @bind-Value="editAccountTypeModel.AccountTypeGroupId">
