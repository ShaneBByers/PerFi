@code {
    private readonly List<AccountResponse> accounts = [];
    private readonly List<InstitutionResponse> institutions = [];
    private readonly List<AccountTypeResponse> accountTypes = [];
    private readonly List<AccountTypeGroupResponse> accountTypeGroups = [];
    private readonly List<TransactionCategoryGroupResponse> transactionCategoryGroups = [];
    private readonly List<TransactionCategoryResponse> transactionCategories = [];
    private readonly List<SalaryProgressionResponse> salaryProgressions = [];
    private readonly UserConfigurationModel userConfigurationModel = new();
    private UserConfigurationResponse? userConfiguration;

    private readonly CreateInstitutionModel createInstitutionModel = new();
    private readonly CreateAccountModel createAccountModel = new();
    private readonly CreateAccountTypeModel createAccountTypeModel = new();
    private readonly CreateAccountTypeGroupModel createAccountTypeGroupModel = new();
    private readonly CreateTransactionCategoryGroupModel createTransactionCategoryGroupModel = new();
    private readonly CreateTransactionCategoryModel createTransactionCategoryModel = new();
    private readonly CreateSalaryProgressionModel createSalaryProgressionModel = new();
    private readonly CreateContributionPlanModel createContributionPlanModel = new();

    private EditInstitutionModel? editInstitutionModel;
    private EditAccountModel? editAccountModel;
    private EditAccountTypeModel? editAccountTypeModel;
    private EditAccountTypeGroupModel? editAccountTypeGroupModel;
    private EditTransactionCategoryGroupModel? editTransactionCategoryGroupModel;
    private EditTransactionCategoryModel? editTransactionCategoryModel;
    private EditSalaryProgressionModel? editSalaryProgressionModel;
    private EditContributionPlanModel? editContributionPlanModel;

    private bool isCreatingInstitution;
    private bool isCreatingAccount;
    private bool isCreatingAccountType;
    private bool isCreatingAccountTypeGroup;
    private bool isCreatingTransactionCategoryGroup;
    private bool isCreatingTransactionCategory;
    private bool isCreatingSalaryProgression;
    private bool showContributionsModal;

    private AccountResponse? selectedAccount;
    private readonly List<AccountContributionPlanResponse> selectedAccountContributionPlans = [];
    private readonly HashSet<int> expandedAccountTypeGroupIds = [];
    private readonly HashSet<int> knownAccountTypeGroupIds = [];
    private readonly HashSet<int> expandedInstitutionIds = [];
    private readonly HashSet<int> knownInstitutionIds = [];
    private readonly HashSet<int> expandedTransactionCategoryGroupIds = [];
    private readonly HashSet<int> knownTransactionCategoryGroupIds = [];

    private bool isLoading = true;
    private bool isSubmitting;
    private string activeSection = "profile";

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        isLoading = true;

        try
        {
            userConfiguration = await UserConfigurationApiClient.GetAsync();
            if (userConfiguration is not null)
            {
                userConfigurationModel.BirthDate = userConfiguration.BirthDate;
                userConfigurationModel.PayCycleType = userConfiguration.PayCycleType;
                userConfigurationModel.ReferencePayDate = userConfiguration.ReferencePayDate;
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage = userConfiguration.ExpectedAnnualSalaryRaisePercentage;
                userConfigurationModel.ExpectedAnnualInflationPercentage = userConfiguration.ExpectedAnnualInflationPercentage;
            }

            salaryProgressions.Clear();
            salaryProgressions.AddRange(await SalaryProgressionsApiClient.GetAllAsync());
            salaryProgressions.Sort((a, b) => b.EffectiveDate.CompareTo(a.EffectiveDate));

            institutions.Clear();
            institutions.AddRange(await InstitutionsApiClient.GetAllAsync());

            foreach (var institution in institutions)
            {
                if (knownInstitutionIds.Add(institution.Id))
                    expandedInstitutionIds.Add(institution.Id);
            }

            accounts.Clear();
            accounts.AddRange(await AccountsApiClient.GetAllAsync());

            accountTypes.Clear();
            accountTypes.AddRange(await AccountTypesApiClient.GetAllAsync());

            accountTypeGroups.Clear();
            accountTypeGroups.AddRange(await AccountTypeGroupsApiClient.GetAllAsync());

            foreach (var group in accountTypeGroups)
            {
                if (knownAccountTypeGroupIds.Add(group.Id))
                    expandedAccountTypeGroupIds.Add(group.Id);
            }

            transactionCategoryGroups.Clear();
            transactionCategoryGroups.AddRange(await TransactionCategoryGroupsApiClient.GetAllAsync());

            foreach (var group in transactionCategoryGroups)
            {
                if (knownTransactionCategoryGroupIds.Add(group.Id))
                    expandedTransactionCategoryGroupIds.Add(group.Id);
            }

            transactionCategories.Clear();
            transactionCategories.AddRange(await TransactionCategoriesApiClient.GetAllAsync());
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetSection(string section) => activeSection = section;

    private void ToggleAccountTypeGroupExpanded(int groupId)
    {
        if (!expandedAccountTypeGroupIds.Remove(groupId))
            expandedAccountTypeGroupIds.Add(groupId);
    }

    private void ToggleInstitutionExpanded(int institutionId)
    {
        if (!expandedInstitutionIds.Remove(institutionId))
            expandedInstitutionIds.Add(institutionId);
    }

    private void ToggleTransactionCategoryGroupExpanded(int groupId)
    {
        if (!expandedTransactionCategoryGroupIds.Remove(groupId))
            expandedTransactionCategoryGroupIds.Add(groupId);
    }


    private async Task SaveUserConfigurationAsync()
    {
        isSubmitting = true;

        var result = userConfiguration is null
            ? await UserConfigurationApiClient.CreateAsync(new CreateUserConfigurationRequest(
                userConfigurationModel.BirthDate,
                userConfigurationModel.PayCycleType,
                userConfigurationModel.ReferencePayDate,
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage,
                userConfigurationModel.ExpectedAnnualInflationPercentage))
            : await UserConfigurationApiClient.UpdateAsync(userConfiguration.Id, new UpdateUserConfigurationRequest(
                userConfigurationModel.BirthDate,
                userConfigurationModel.PayCycleType,
                userConfigurationModel.ReferencePayDate,
                userConfigurationModel.ExpectedAnnualSalaryRaisePercentage,
                userConfigurationModel.ExpectedAnnualInflationPercentage));

        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        ToastService.ShowSuccess("User configuration saved.");
        await LoadAllAsync();
    }

    private void StartCreateSalaryProgression()
    {
        createSalaryProgressionModel.EffectiveDate = DateOnly.FromDateTime(DateTime.Today);
        createSalaryProgressionModel.AnnualSalary = 0;
        isCreatingSalaryProgression = true;
    }

    private void CloseSalaryProgressionModal()
    {
        isCreatingSalaryProgression = false;
        editSalaryProgressionModel = null;
    }

    private async Task CreateSalaryProgressionAsync()
    {
        isSubmitting = true;

        var result = await SalaryProgressionsApiClient.CreateAsync(createSalaryProgressionModel.EffectiveDate, createSalaryProgressionModel.AnnualSalary);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        isCreatingSalaryProgression = false;
        ToastService.ShowSuccess("Salary entry saved.");
        await LoadAllAsync();
    }

    private void StartEditSalaryProgression(SalaryProgressionResponse salaryProgression)
    {
        editSalaryProgressionModel = new EditSalaryProgressionModel
        {
            Id = salaryProgression.Id,
            EffectiveDate = salaryProgression.EffectiveDate,
            AnnualSalary = salaryProgression.AnnualSalary
        };
    }

    private async Task UpdateSalaryProgressionAsync()
    {
        if (editSalaryProgressionModel is null)
            return;

        isSubmitting = true;

        var result = await SalaryProgressionsApiClient.UpdateAsync(editSalaryProgressionModel.Id, editSalaryProgressionModel.EffectiveDate, editSalaryProgressionModel.AnnualSalary);
        isSubmitting = false;

        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        editSalaryProgressionModel = null;
        ToastService.ShowSuccess("Salary entry updated.");
        await LoadAllAsync();
    }

    private async Task DeleteSalaryProgressionAsync(int id)
    {

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this salary entry?");
        if (!confirmed)
            return;

        var result = await SalaryProgressionsApiClient.DeleteAsync(id);
        if (!result.IsSuccess)
        {
            ToastService.ShowFailure(result.ErrorMessage, result.ValidationErrors);
            return;
        }

        ToastService.ShowSuccess("Salary entry deleted.");
        await LoadAllAsync();
    }

    private void StartCreateInstitution()
    {
        createInstitutionModel.InstitutionName = string.Empty;
        isCreatingInstitution = true;
    }

    private void CloseInstitutionModal()
    {
        isCreatingInstitution = false;
        editInstitutionModel = null;
    }

    private async Task CreateInstitutionAsync()
    {
        isSubmitting = true;

        var result = await InstitutionsApiClient.CreateAsync(createInstitutionModel.InstitutionName);
        isSubmitting = false;

