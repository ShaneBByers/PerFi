@if (IsVisible)
{
    <div class="pf-loading-state" role="status" aria-live="polite">
        <span class="pf-spinner" aria-hidden="true"></span>
        <span class="pf-loading-message">@Message</span>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Message { get; set; } = "Loading...";
}
