{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/lib/*",
      "/sample-data/*",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.ico",
      "/*.json",
      "/*.txt",
      "/*.map",
      "/*.wasm",
      "/*.js",
      "/*.css",
      "/*.br",
      "/*.gz"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
