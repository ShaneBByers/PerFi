                <div class="nav-subitems-header">Projection</div>
                <NavLink class="nav-subitem" href="projection/trends" @onclick='() => SelectSubitem("projection")'>Trends</NavLink>
                <NavLink class="nav-subitem" href="projection/detail" @onclick='() => SelectSubitem("projection")'>Detail</NavLink>
