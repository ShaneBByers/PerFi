                            <span class="nav-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3" />
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                </svg>
                            </span>
                        </a>
                        <div class="nav-subitems nav-subitems--footer nav-subitems--flyout">
                            <div class="nav-subitems-header">Settings</div>
                            <NavLink class="nav-subitem" href="settings/profile" @onclick='() => SelectSubitem("settings")'>Personal Info</NavLink>
                            <NavLink class="nav-subitem" href="settings/salary" @onclick='() => SelectSubitem("settings")'>Salary History</NavLink>
                            <NavLink class="nav-subitem" href="settings/accounts" @onclick='() => SelectSubitem("settings")'>Accounts</NavLink>
                            <NavLink class="nav-subitem" href="settings/account-types" @onclick='() => SelectSubitem("settings")'>Account Types</NavLink>
                            <NavLink class="nav-subitem" href="settings/transaction-categories" @onclick='() => SelectSubitem("settings")'>Transaction Categories</NavLink>
                        </div>
                    </div>
                    <button type="button" class="nav-item nav-item--action" title="Sign out" @onclick="LogoutAsync">
                        <span class="nav-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                        </span>
                        <span class="nav-label">Sign out</span>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="side-nav-footer-row">
                    <NavLink class="nav-item" href="login" @onclick="CloseMobile">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

<button type="button" class="mobile-nav-toggle" title="Open navigation" aria-label="Open navigation" @onclick="ToggleMobile">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
</button>

@if (isMobileOpen)
{
    <div class="nav-backdrop" @onclick="CloseMobile"></div>
}
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool isCollapsed;
    private bool isMobileOpen;
    private bool isAuthenticated;

    // Flyout visibility is driven entirely by these two fields rather than CSS :hover/:focus-within.
    // Reacting to the pseudo-classes directly created a feedback loop: hiding the flyout via a CSS
    // override caused a real mouseleave (since the hovered child disappeared), which cleared the
    // override, and since the pointer was still physically over that screen position the browser
    // immediately re-matched :hover/:focus-within and reopened it - so it never actually closed until
    // the user moved focus/hover away by clicking elsewhere. Explicit state has no such loop: closing
    // it on click sticks until a genuinely new mouseenter/focusin event arrives.
    private string? hoveredGroup;
    private string? focusedGroup;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    // Runs on init and whenever CascadingAuthenticationState pushes a new AuthenticationStateTask
    // (login/logout), so isAuthenticated always reflects the latest state without a manual refresh.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        hoveredGroup = null;
        focusedGroup = null;
        InvokeAsync(StateHasChanged);
    }

    private bool IsFlyoutOpen(string group) => hoveredGroup == group || focusedGroup == group;

    private void OpenFlyoutOnHover(string group) => hoveredGroup = group;

    private void CloseFlyoutOnHoverLeave(string group)
    {
        if (hoveredGroup == group)
            hoveredGroup = null;
    }

    private void OpenFlyoutOnFocus(string group) => focusedGroup = group;

    private void CloseFlyoutOnFocusLeave(string group)
    {
        if (focusedGroup == group)
            focusedGroup = null;
    }

    private bool IsUnderPath(string path)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        return relative.Equals(path, StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleCollapsed() => isCollapsed = !isCollapsed;

    private void ToggleMobile() => isMobileOpen = !isMobileOpen;

    private void CloseMobile() => isMobileOpen = false;

    // Force the flyout closed immediately on click, regardless of lingering hover/focus state.
    private void SelectSubitem(string group)
    {
        CloseMobile();
        if (hoveredGroup == group)
            hoveredGroup = null;
        if (focusedGroup == group)
            focusedGroup = null;
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        CloseMobile();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
