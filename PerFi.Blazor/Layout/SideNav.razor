        <div class="nav-group @(IsFlyoutOpen("projection") ? "nav-group--open" : null)" @onmouseenter='() => OpenFlyoutOnHover("projection")' @onmouseleave='() => CloseFlyoutOnHoverLeave("projection")' @onfocusin='() => OpenFlyoutOnFocus("projection")' @onfocusout='() => CloseFlyoutOnFocusLeave("projection")'>
            <a class="nav-item @(IsUnderPath("projection") ? "active" : null)" href="projection/trends" title="Projection" @onclick='() => SelectSubitem("projection")'>
