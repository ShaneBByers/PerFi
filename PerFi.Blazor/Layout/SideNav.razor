        </button>
    </div>

    <nav class="side-nav-links" aria-label="Primary">
        <div class="nav-group @(IsFlyoutOpen("snapshots") ? "nav-group--open" : null)" @onmouseenter='() => OpenFlyoutOnHover("snapshots")' @onmouseleave='() => CloseFlyoutOnHoverLeave("snapshots")' @onfocusin='() => OpenFlyoutOnFocus("snapshots")' @onfocusout='() => CloseFlyoutOnFocusLeave("snapshots")'>
            <a class="nav-item @(IsUnderPath("snapshots") ? "active" : null)" href="snapshots/grid" title="Net Worth" @onclick='() => SelectSubitem("snapshots")'>
                <span class="nav-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
