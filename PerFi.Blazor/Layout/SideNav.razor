    <div class="side-nav-footer">
        <AuthorizeView>
            <Authorized>
                @if (IsUnderPath("settings"))
                {
                    <div class="nav-subitems nav-subitems--footer nav-subitems--active">
                        <NavLink class="nav-subitem" href="settings/profile" @onclick="CloseMobile">Personal Info</NavLink>
                        <NavLink class="nav-subitem" href="settings/salary" @onclick="CloseMobile">Salary History</NavLink>
                        <NavLink class="nav-subitem" href="settings/accounts" @onclick="CloseMobile">Accounts</NavLink>
                        <NavLink class="nav-subitem" href="settings/account-types" @onclick="CloseMobile">Account Types</NavLink>
                        <NavLink class="nav-subitem" href="settings/transaction-categories" @onclick="CloseMobile">Transaction Categories</NavLink>
                    </div>
                }
                <div class="side-nav-footer-row">
                    <div class="nav-group nav-group--footer @(IsFlyoutOpen("settings") ? "nav-group--open" : null)" @onmouseenter='() => OpenFlyoutOnHover("settings")' @onmouseleave='() => CloseFlyoutOnHoverLeave("settings")' @onfocusin='() => OpenFlyoutOnFocus("settings")' @onfocusout='() => CloseFlyoutOnFocusLeave("settings")'>
