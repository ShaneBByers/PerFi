{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-console",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/PerFi.Console/PerFi.Console.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/PerFi.API/PerFi.API.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-all-services",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/PerFi.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish + Deploy API to Azure",
      "type": "shell",
      "command": "bash ./scripts/publish-api-azure.sh && bash ./scripts/deploy-api-azure.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Publish + Deploy Blazor BFF to Azure",
      "type": "shell",
      "command": "bash ./scripts/publish-blazor-bff-azure.sh && bash ./scripts/deploy-blazor-bff-azure.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Publish + Deploy Blazor UI to Azure",
      "type": "shell",
      "command": "bash ./scripts/publish-blazor-ui-azure.sh && bash ./scripts/deploy-blazor-ui-azure.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Migrate Remote DB (Azure SQL)",
      "type": "shell",
      "command": "bash ./scripts/migrate-remote-db.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Create User Account (Remote DB)",
      "type": "shell",
      "command": "bash ./scripts/create-user.sh '${input:perfiNewUsername}' '${input:perfiNewPassword}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Delete All Data (Remote DB)",
      "type": "shell",
      "command": "bash ./scripts/reset-remote-db.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "perfiNewUsername",
      "type": "promptString",
      "description": "Username for the new PerFi login"
    },
    {
      "id": "perfiNewPassword",
      "type": "promptString",
      "description": "Password for the new PerFi login",
      "password": true
    }
  ]
}