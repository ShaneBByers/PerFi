  "tasks": [
    {
      "label": "build-console",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/PerFi.Console/PerFi.Console.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
